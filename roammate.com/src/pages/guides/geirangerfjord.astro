  { category: 'Drinks', budget: '50–100 NOK', midrange: '150–300 NOK', splurge: '500+ NOK', notes: 'Supermarket drinks → café coffee → bar beers' },
  { category: 'Daily Total', budget: '400–1,450 NOK', midrange: '2,350–4,100 NOK', splurge: '6,700+ NOK', notes: '$38–138 → $224–390 → $638+' },
];

