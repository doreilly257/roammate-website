---
const steps = [
  {
    icon: 'pin',
    number: '01',
    title: 'Drop a Pin',
    body: "Set your location and browse travel plans created by other explorers nearby. See who's around and what adventures are brewing.",
  },
  {
    icon: 'people',
    number: '02',
    title: 'Find Your People',
    body: 'Create your own travel plan or request to join others. Match on budget, pace, and interests to find the perfect travel companions.',
  },
  {
    icon: 'explore',
    number: '03',
    title: 'Go Explore',
    body: 'Meet up, share costs, and create unforgettable memories together. From city walks to mountain treks, the world is better with friends.',
  },
];
---

<section class="how-it-works" id="how">
  <div class="how-header reveal">
    <div class="section-label section-label--center">How It Works</div>
    <h2 class="section-heading">Three steps to your next <em>adventure</em></h2>
    <p>From solo to social in minutes. Here's how roammate transforms the way you travel.</p>
  </div>
  <div class="steps">
    {steps.map((step, i) => (
      <div class={`step reveal reveal-delay-${i + 1}`}>
        <div class="step-icon">
          {step.icon === 'pin' && (
            <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          )}
          {step.icon === 'people' && (
            <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          )}
          {step.icon === 'explore' && (
            <svg viewBox="0 0 24 24"><path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/></svg>
          )}
        </div>
        <div class="step-number">{step.number}</div>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .how-it-works {
    padding: 120px 40px 160px;
    background: var(--color-bg-warm);
    position: relative;
  }

  .how-it-works::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.08), transparent);
  }

  .how-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 100px;
  }

  .section-label--center {
    justify-content: center;
  }

  .section-label--center::before {
    display: none;
  }

  .how-header p {
    color: var(--color-text-muted);
    font-size: 16px;
    font-weight: 300;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .step {
    position: relative;
    padding: 48px 36px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 4px;
    transition: all 0.5s var(--ease-out-expo);
  }

  .step:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(196, 86, 42, 0.2);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
  }

  .step-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-icon svg {
    width: 32px;
    height: 32px;
    stroke: var(--color-terracotta);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 900;
    color: var(--color-terracotta);
    opacity: 0.12;
    line-height: 1;
    margin-bottom: 24px;
  }

  .step h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-cream);
    margin-bottom: 16px;
  }

  .step p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  @media (max-width: 1024px) {
    .how-it-works { padding: 100px 24px; }
    .steps { grid-template-columns: 1fr; gap: 32px; max-width: 500px; }
  }
</style>
