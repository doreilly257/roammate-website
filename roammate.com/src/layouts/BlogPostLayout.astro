---
import BaseLayout from './BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import AppCTA from '../components/AppCTA.astro';

interface BlogPostSection {
  heading: string;
  content: string | string[];
  image?: string;
  imageAlt?: string;
  kicker?: string;
  quote?: string;
}

interface RelatedGuide {
  slug: string;
  name: string;
  country: string;
  flag: string;
}

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  heroImage: string;
  category?: string;
}

interface Props {
  title: string;
  description: string;
  heroImage: string;
  category?: string;
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  readingTime?: string;
  intro?: string;
  sections: BlogPostSection[];
  relatedGuides?: RelatedGuide[];
  relatedPosts?: RelatedPost[];
  cities?: string[];
}

const {
  title,
  description,
  heroImage,
  category,
  publishedAt,
  updatedAt,
  author,
  readingTime,
  intro,
  sections,
  relatedGuides = [],
  relatedPosts = [],
  cities = [],
} = Astro.props;

const formatCityName = (slug: string) =>
  slug.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Fallback author entity for posts without a named author, pointed at the /editorial/ page.
const EDITORIAL_AUTHOR = {
  "@type": "Organization",
  "name": "roammate editorial",
  "url": new URL('/editorial/', Astro.site).href,
} as const;

const toISODate = (value?: string) => {
  if (!value) return undefined;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return undefined;
  return date.toISOString();
};

const isoPublishedAt = toISODate(publishedAt);
const isoUpdatedAt = toISODate(updatedAt);

const formatDate = (value?: string) => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date);
};

const publishedLabel = formatDate(publishedAt);
const updatedLabel = formatDate(updatedAt);

const toParagraphs = (content: string | string[]) => {
  if (Array.isArray(content)) return content.filter(Boolean);
  return content
    .split('\n')
    .map((item) => item.trim())
    .filter(Boolean);
};

const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

const escapeCssUrl = (url: string) =>
  url.replace(/['"()\\]/g, '\\$&');

const sanitizeHref = (value: string) => {
  const href = value.trim();
  if (!href) return '#';

  const lower = href.toLowerCase();
  if (lower.startsWith('javascript:') || lower.startsWith('data:') || lower.startsWith('vbscript:')) {
    return '#';
  }

  if (
    href.startsWith('/') ||
    href.startsWith('#') ||
    href.startsWith('http://') ||
    href.startsWith('https://') ||
    href.startsWith('mailto:') ||
    href.startsWith('tel:')
  ) {
    return href;
  }

  return '#';
};

const renderInlineLinks = (text: string) => {
  const linkPattern = /\[([^\]]+)\]\(([^)]+)\)/g;
  let html = '';
  let lastIndex = 0;

  for (const match of text.matchAll(linkPattern)) {
    const [fullMatch, label, rawHref] = match;
    const index = match.index ?? 0;

    html += escapeHtml(text.slice(lastIndex, index));
    html += `<a href="${escapeHtml(sanitizeHref(rawHref))}">${escapeHtml(label)}</a>`;
    lastIndex = index + fullMatch.length;
  }

  html += escapeHtml(text.slice(lastIndex));
  return html;
};
---

<BaseLayout title={`${title} | roammate Blog`} description={description} ogImage={heroImage} ogType="article" publishedAt={isoPublishedAt} updatedAt={isoUpdatedAt}>
  <Fragment slot="head">
    {category && <meta name="ph-category" content={category}>}
    <link rel="preload" as="image" type="image/webp" href={heroImage}>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": [new URL(heroImage, Astro.site).href],
      "author": author ? {
        "@type": "Person",
        "name": author,
      } : EDITORIAL_AUTHOR,
      "publisher": {
        "@type": "Organization",
        "name": "roammate",
        "logo": {
          "@type": "ImageObject",
          "url": "https://roammate.com/images/rm-logo.webp",
          "width": 600,
          "height": 464,
        },
      },
      ...(isoPublishedAt ? { "datePublished": isoPublishedAt } : {}),
      ...(isoUpdatedAt || isoPublishedAt ? { "dateModified": isoUpdatedAt || isoPublishedAt } : {}),
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonical,
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".blog-post-hero h1", ".blog-post-intro p", ".blog-post-section:first-of-type h2", ".blog-post-section:first-of-type .blog-post-section-copy p"]
      },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://roammate.com/blog/" },
        { "@type": "ListItem", "position": 3, "name": title, "item": canonical },
      ],
    })} />
      <slot name="head" />
  </Fragment>

  <article>
    <section class="blog-post-hero">
      <div class="blog-post-hero-bg" style={`background-image: linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('${escapeCssUrl(heroImage)}');`} />
      <div class="blog-post-hero-content">
        <div class="blog-post-breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/blog/">Blog</a>
        </div>
        {category && <p class="blog-post-category">{category}</p>}
        <h1>{title}</h1>
        <p class="blog-post-subtitle">{description}</p>
        <div class="blog-post-meta">
          {publishedLabel && <span>{publishedLabel}</span>}
          {readingTime && <span>{readingTime}</span>}
          {author && <span>By {author}</span>}
          {updatedLabel && <span>Updated {updatedLabel}</span>}
        </div>
      </div>
      <div class="blog-hero-scroll">
        <span>Scroll</span>
        <div class="blog-scroll-line"></div>
      </div>
    </section>

    <section class="blog-post-body">
      <div class="blog-post-intro reveal">
        {intro && <p set:html={renderInlineLinks(intro)} />}
      </div>

      <div class="blog-post-badges reveal">
        <AppCTA variant="badges" appStoreCt="blog-post-cta" appStoreEvent="blog_appstore_click" playStoreEvent="blog_playstore_click" />
      </div>

      {cities.length > 0 && (
        <div class="blog-city-companions reveal">
          {cities.map((slug) => (
            <a href={`/companions/${slug}/`} class="blog-city-companion-link">
              Find travel companions in {formatCityName(slug)} →
            </a>
          ))}
        </div>
      )}

      <div class="blog-post-sections">
        {sections.map((section, index) => {
          const sectionParagraphs = toParagraphs(section.content);
          return (
            <>
              <section class={`blog-post-section reveal ${index % 2 === 1 ? 'is-reversed' : ''}`}>
                <div class="blog-post-section-header">
                  {section.kicker && <p class="blog-post-section-kicker">{section.kicker}</p>}
                  <h2>{section.heading}</h2>
                </div>
                <div class="blog-post-section-body">
                  <div class="blog-post-section-copy">
                    {sectionParagraphs.map((paragraph) => (
                      <p set:html={renderInlineLinks(paragraph)} />
                    ))}
                    {section.quote && <blockquote>{section.quote}</blockquote>}
                  </div>
                  {section.image && (
                    <figure class="blog-post-section-media">
                      <img src={section.image} alt={section.imageAlt || `Illustration for ${section.heading}`} loading="lazy" decoding="async" width="1200" height="800" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 800px" />
                    </figure>
                  )}
                </div>
              </section>
              {index === 0 && (
                <div class="blog-midpost-cta reveal">
                  <p class="blog-midpost-cta-text">Find a <a href="/find-travel-companion/" class="blog-midpost-cta-link">travel companion</a> who matches your style and budget</p>
                  <AppCTA
                    variant="badges"
                    appStoreCt="blog-midpost-cta"
                    appStoreEvent="blog_midpost_cta_appstore_click"
                    playStoreEvent="blog_midpost_cta_playstore_click"
                  />
                </div>
              )}
            </>
          );
        })}
      </div>

      <slot name="extra" />
    </section>

    <div class="blog-post-share reveal">
      <span class="blog-post-share-label">Share this</span>
      <a
        class="blog-post-share-btn"
        id="share-twitter"
        href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}&via=roammate`}
        target="_blank"
        rel="noopener noreferrer"
        data-ph-event="blog_share_twitter"
        aria-label="Share on X / Twitter"
      >𝕏</a>
      <a
        class="blog-post-share-btn"
        id="share-whatsapp"
        href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + canonical)}`}
        target="_blank"
        rel="noopener noreferrer"
        data-ph-event="blog_share_whatsapp"
        aria-label="Share on WhatsApp"
      >WhatsApp</a>
      <a
        class="blog-post-share-btn"
        id="share-pinterest"
        href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(canonical)}&description=${encodeURIComponent(title)}`}
        target="_blank"
        rel="noopener noreferrer"
        data-ph-event="blog_share_pinterest"
        aria-label="Save to Pinterest"
      >Pinterest</a>
      <button
        class="blog-post-share-btn"
        id="share-native"
        data-ph-event="blog_share_native"
        aria-label="Share"
        style="display:none"
      >Share ↑</button>
    </div>
    <script define:vars={{ title, canonical }}>
      var nativeBtn = document.getElementById('share-native');
      if (navigator.share) {
        nativeBtn.style.display = 'inline-flex';
        nativeBtn.addEventListener('click', function() {
          navigator.share({ title: title, url: canonical }).catch(function(){});
        });
      }
    </script>

    <section class="blog-post-cta reveal">
      <div class="blog-post-cta-inner">
        <p class="blog-post-cta-label">Travel smarter</p>
        <h2 class="blog-post-cta-heading">Find your perfect <em>travel companion</em></h2>
        <p class="blog-post-cta-body">Roammate matches you with fellow travelers by style, budget, and destination — so you can share costs, stay safer, and go deeper.</p>
        <div class="blog-post-cta-actions">
          <AppCTA
      variant="badges"
      appStoreCt="blog-post-cta"
      appStoreEvent="blog_cta_appstore_click"
      playStoreEvent="blog_cta_playstore_click"
    />
          <a href="/find-travel-companion/" class="blog-post-cta-btn blog-post-cta-btn--ghost" data-ph-event="blog_cta_find_companion_click">Find a travel companion</a>
          <a href="/how-it-works/" class="blog-post-cta-btn blog-post-cta-btn--ghost" data-ph-event="blog_cta_how_it_works_click">See how it works</a>
          <a href="/companions/" class="blog-post-cta-btn blog-post-cta-btn--ghost" data-ph-event="blog_cta_companions_click">Browse companions by city</a>
        </div>
        <div class="blog-post-cta-badges">
          <AppCTA variant="badges" appStoreCt="blog-post-cta" appStoreEvent="blog_appstore_click" playStoreEvent="blog_playstore_click" />
        </div>
      </div>
    </section>

    <NewsletterSignup />

    {(relatedGuides.length > 0 || relatedPosts.length > 0) && (
      <section class="blog-post-related">
        <div class="blog-post-related-inner">
          {relatedGuides.length > 0 && (
            <div class="blog-post-related-group reveal">
              <div class="section-label">Keep Exploring</div>
              <h2 class="section-heading">Related <em>guides</em></h2>
              <div class="blog-related-guides-grid">
                {relatedGuides.map((guide) => (
                  <a href={`/guides/${guide.slug}/`} class="blog-related-guide-card">
                    <span class="blog-related-guide-flag">{guide.flag}</span>
                    <div>
                      <h3>{guide.name}</h3>
                      <p>{guide.country}</p>
                    </div>
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          {relatedPosts.length > 0 && (
            <div class="blog-post-related-group reveal">
              <div class="section-label">From The Blog</div>
              <h2 class="section-heading">Related <em>posts</em></h2>
              <div class="blog-related-posts-grid">
                {relatedPosts.map((post) => (
                  <a href={`/blog/${post.slug}/`} class="blog-related-post-card">
                    <img src={post.heroImage} alt={post.title} loading="lazy" decoding="async" width="1200" height="800" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 800px" />
                    <div>
                      {post.category && <p class="blog-related-post-category">{post.category}</p>}
                      <h3>{post.title}</h3>
                      <p>{post.description}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .blog-post-hero {
    position: relative;
    min-height: 100vh;
    padding: 0 40px 64px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .blog-post-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.08);
    animation: heroZoom 9s var(--ease-out-expo) forwards;
  }

  .blog-post-hero-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
    color: #f5f1eb;
  }

  .blog-hero-scroll {
    position: absolute;
    bottom: 40px;
    right: 40px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeUp 1s var(--ease-out-expo) 1.6s forwards;
  }

  .blog-hero-scroll span {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.5);
    writing-mode: vertical-rl;
  }

  .blog-scroll-line {
    width: 1px;
    height: 60px;
    background: rgba(245, 240, 232, 0.3);
    position: relative;
    overflow: hidden;
  }

  .blog-scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-terracotta);
    animation: scrollLine 2s ease-in-out infinite;
  }

  .blog-post-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgba(245, 241, 235, 0.24);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    margin-bottom: 26px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .blog-post-breadcrumb a {
    color: inherit;
    transition: color 0.3s ease;
  }

  .blog-post-breadcrumb a:hover {
    color: #fff;
  }

  .blog-post-category {
    display: inline-block;
    margin-bottom: 18px;
    color: #f8b66a;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 600;
  }

  .blog-post-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(46px, 9vw, 92px);
    line-height: 0.98;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .blog-post-subtitle {
    font-size: clamp(18px, 2.4vw, 25px);
    color: rgba(245, 241, 235, 0.92);
    max-width: 740px;
    margin-bottom: 24px;
    line-height: 1.45;
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(245, 241, 235, 0.8);
  }

  .blog-post-meta span {
    padding: 8px 12px;
    border: 1px solid rgba(245, 241, 235, 0.2);
    border-radius: 999px;
    backdrop-filter: blur(3px);
  }

  .blog-post-body {
    padding: 96px 40px;
  }

  .blog-post-intro {
    max-width: 1200px;
    margin: 0 auto 52px;
    padding: 28px 180px 28px 32px;
    border-left: 3px solid var(--color-terracotta);
    background: rgba(247, 242, 234, 0.04);
    border-radius: 0 16px 16px 0;
  }

  .blog-post-intro p {
    font-size: clamp(17px, 2vw, 19px);
    line-height: 1.7;
    color: var(--color-text);
  }

  .blog-post-sections {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 64px;
  }

  .blog-midpost-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 24px 32px;
    background: linear-gradient(135deg, rgba(196, 86, 42, 0.12) 0%, rgba(196, 86, 42, 0.06) 100%);
    border: 1px solid rgba(196, 86, 42, 0.25);
    border-radius: 18px;
    margin-top: -16px;
  }

  .blog-midpost-cta-text {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
    margin: 0;
  }

  .blog-midpost-cta-text a {
    color: var(--color-terracotta-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-midpost-cta-text a:hover {
    color: var(--color-terracotta);
  }

  .blog-midpost-cta-btn {
    flex-shrink: 0;
    display: inline-block;
    padding: 12px 24px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
    background: var(--color-terracotta);
    color: #fff;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s var(--ease-out-expo);
    white-space: nowrap;
  }

  .blog-midpost-cta-btn:hover {
    background: #b34f28;
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .blog-midpost-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
  }

  .blog-post-section {
    padding: 36px;
    border-radius: 26px;
    background: #f7f2ea;
    border: 1px solid rgba(196, 86, 42, 0.12);
  }

  .blog-post-section-header {
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(196, 86, 42, 0.1);
  }

  .blog-post-section-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    align-items: start;
  }

  .blog-post-section.is-reversed .blog-post-section-body {
    grid-template-columns: 1fr 1.4fr;
  }

  .blog-post-section.is-reversed .blog-post-section-copy {
    order: 2;
  }

  .blog-post-section.is-reversed .blog-post-section-media {
    order: 1;
  }

  .blog-post-section-kicker {
    text-transform: uppercase;
    letter-spacing: 1.8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-terracotta);
    margin-bottom: 10px;
  }

  .blog-post-section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    color: var(--color-ink);
  }

  .blog-post-section-copy p {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 14px;
  }

  .blog-post-section-copy blockquote {
    margin-top: 20px;
    border-left: 3px solid var(--color-terracotta);
    padding: 8px 0 8px 18px;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .blog-post-section-media img {
    width: 100%;
    border-radius: 18px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    box-shadow: 0 20px 40px rgba(26, 23, 20, 0.14);
  }

  .blog-post-related {
    padding: 24px 40px 96px;
  }

  .blog-post-related-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 64px;
  }

  .blog-related-guides-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .blog-related-posts-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .blog-related-guide-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    background: #fff;
    border: 1px solid rgba(196, 86, 42, 0.12);
    border-radius: 16px;
    transition: transform 0.3s var(--ease-out-expo), border-color 0.3s ease;
  }

  .blog-related-guide-card:hover {
    transform: translateY(-2px);
    border-color: rgba(196, 86, 42, 0.32);
  }

  .blog-related-guide-flag {
    font-size: 22px;
  }

  .blog-related-guide-card h3,
  .blog-related-post-card h3 {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .blog-related-guide-card p,
  .blog-related-post-card p {
    margin-top: 6px;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .blog-related-guide-card > span[aria-hidden="true"] {
    margin-left: auto;
    color: var(--color-terracotta);
  }

  .blog-related-post-card {
    background: #fff;
    border: 1px solid rgba(196, 86, 42, 0.12);
    border-radius: 16px;
    overflow: hidden;
