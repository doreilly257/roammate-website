---
import { appStoreUrl, playStoreUrl } from '../lib/storeLinks';

const base = import.meta.env.BASE_URL;

interface Props {
  variant?: 'buttons' | 'badges';
  appStoreCt?: string;
  appStorePt?: string;
  appStoreEvent?: string;
  playStoreEvent?: string;
  appStoreLabel?: string;
  playStoreLabel?: string;
}

const {
  variant = 'buttons',
  appStoreCt = 'city-statistics-cta',
  appStorePt = '118224460',
  appStoreEvent = 'city_stats_appstore_click',
  playStoreEvent = 'city_stats_playstore_click',
  appStoreLabel = 'Download on App Store',
  playStoreLabel = 'Get on Google Play',
} = Astro.props;

const appStoreHref = appStoreUrl(appStoreCt, appStorePt);
const playStoreHref = playStoreUrl(appStoreCt);
---

{variant === 'badges' ? (
  <div class="app-cta-badges">
    <a
      href={appStoreHref}
      class="badge-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={appStoreLabel}
      data-ph-event={appStoreEvent}
    ><img src={`${base}images/app-store-badge.webp`} alt="Download on the App Store" class="store-badge" width="120" height="40" loading="lazy" decoding="async"></a>
    <a
      href={playStoreHref}
      class="badge-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={playStoreLabel}
      data-ph-event={playStoreEvent}
    ><img src={`${base}images/google-play-badge.webp`} alt="Get it on Google Play" class="store-badge" width="135" height="40" loading="lazy" decoding="async"></a>
  </div>
) : (
  <div class="stats-cta-buttons">
    <a
      href={appStoreHref}
      target="_blank"
      rel="noopener noreferrer"
      class="stats-cta-btn"
      data-ph-event={appStoreEvent}
      data-ph-label={appStoreLabel}
    >{appStoreLabel}</a>
    <a
      href={playStoreHref}
      target="_blank"
      rel="noopener noreferrer"
      class="stats-cta-btn stats-cta-btn-secondary"
      data-ph-event={playStoreEvent}
      data-ph-label={playStoreLabel}
    >{playStoreLabel}</a>
  </div>
)}

<style>
  .stats-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stats-cta-btn {
    display: inline-block;
    padding: 16px 36px;
    background: var(--color-terracotta);
    color: #fff !important;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none !important;
    transition: background 0.3s, transform 0.2s;
  }

  .stats-cta-btn:hover {
    background: var(--color-terracotta-light);
    transform: translateY(-1px);
  }

  .stats-cta-btn-secondary {
    background: transparent;
    border: 2px solid var(--color-terracotta);
    color: var(--color-terracotta) !important;
  }

  .stats-cta-btn-secondary:hover {
    background: var(--color-terracotta);
    color: #fff !important;
  }

  .app-cta-badges {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
  }

  .app-cta-badges .badge-link {
    display: block;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.3s;
  }

  .app-cta-badges .badge-link:hover {
    transform: translateY(-3px);
    opacity: 0.85;
  }

  .app-cta-badges .store-badge {
    height: 52px;
    width: auto;
  }
</style>
