const culturalTips = [
  { icon: '🙏', title: 'Respect Local Customs', text: 'Northern Ghana is predominantly Muslim — dress modestly, especially when visiting mosques and chief\'s palaces. Remove shoes when entering homes and sacred spaces. Always greet elders first and use the right hand for giving and receiving.' },
