---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAllBlogPosts } from '../../lib/blog-data';
import { getAllGuides } from '../../data/guides';
import { resolveRelatedContent } from '../../lib/blog-utils';

export async function getStaticPaths() {
  const comparisonSlugs = new Set([
    'roammate-vs-backpackr',
    'roammate-vs-bumble-bff',
    'roammate-vs-couchsurfing',
    'roammate-vs-facebook-travel-groups',
    'roammate-vs-gaffl',
    'roammate-vs-hostelworld',
    'roammate-vs-meetup',
    'roammate-vs-tourlina',
    'roammate-vs-travello',
  ]);
  const allPosts = await getAllBlogPosts();
  return allPosts
    .filter((p) => !comparisonSlugs.has(p.slug))
    .map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const allPosts = await getAllBlogPosts();
const post = allPosts.find((p) => p.slug === slug);
if (!post) throw new Error(`Blog post not found: ${slug}`);

const allGuides = await getAllGuides();
const { relatedGuides, relatedPosts } = resolveRelatedContent(post, allPosts, allGuides);
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  heroImage={post.heroImage}
  category={post.category}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  author={post.author}
  readingTime={post.readingTime}
  intro={post.intro}
  sections={post.sections}
  relatedGuides={relatedGuides as any}
  relatedPosts={relatedPosts}
  cities={post.cities}
/>
