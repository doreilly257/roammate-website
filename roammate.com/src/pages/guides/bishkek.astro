const budgetTips = [
  { title: 'Bazaar canteens', text: 'Eat at the canteens inside Osh Bazaar — plov (150 KGS), laghman (120 KGS), and samsa (50 KGS). A full meal costs under 250 KGS ($2.80). These are where locals eat and the food is fresh and excellent.' },
  { title: 'Marshrutka buses', text: 'Shared minibuses (marshrutka) cost 10 KGS per ride anywhere in the city. They run fixed routes — ask your hostel to write your destination in Russian to show the driver.' },
