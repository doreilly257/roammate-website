---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllBlogPosts } from '../../lib/blog-data';

const allPosts = await getAllBlogPosts();

const blogPosts = allPosts
  .filter((post) => post.slug && post.title && post.description)
  .sort((a, b) => {
    const aTime = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const bTime = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return bTime - aTime;
  });

const featuredPost = blogPosts[0];
const blogHeroImages = blogPosts
  .map((post) => post.heroImage)
  .filter((image): image is string => Boolean(image));

const categories = [...new Set(blogPosts.map((p) => p.category).filter(Boolean))] as string[];

const formatDate = (value?: string) => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date);
};
---

<BaseLayout
  title={`Backpacker Travel Blog — Tips, Guides & Stories | roammate`}
  description="Travel stories, practical backpacking advice, destination deep-dives, and route planning tips from roammate."
  ogImage={featuredPost?.heroImage || '/images/guides/tokyo-hero.webp'}
>
  <Fragment slot="head">
    {featuredPost?.heroImage && <link rel="preload" as="image" type="image/webp" href={featuredPost.heroImage}>}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "roammate Blog",
      "url": "https://roammate.com/blog/",
      "description": "Travel stories, practical backpacking advice, destination deep-dives, and route planning tips from roammate.",
      "mainEntity": {
        "@type": "Blog",
        "name": "roammate Blog",
        "blogPost": blogPosts.slice(0, 20).map((post) => ({
          "@type": "BlogPosting",
          "headline": post.title,
          "url": `https://roammate.com/blog/${post.slug}/`,
          "image": post.heroImage ? `https://roammate.com${post.heroImage}` : undefined,
          "datePublished": post.publishedAt || undefined,
        })),
      },
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://roammate.com/blog/" },
      ],
    })} />
  </Fragment>

  <section class="blog-hero">
    <div class="blog-hero-bg" id="blogHeroBackground" style={`background-image: linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('${featuredPost?.heroImage || '/images/guides/tokyo-hero.webp'}');`}></div>
    <div class="blog-hero-content">
      <div class="blog-hero-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Blog</span>
      </div>
      <div class="blog-hero-tag">
        <span>✍️</span>
        <span>{blogPosts.length} Articles</span>
      </div>
      <h1 class="blog-hero-title">Travel <em>Blog</em></h1>
      <p class="blog-hero-subtitle">Stories from the road, smarter trip planning, and practical tactics for younger independent travelers.</p>
      <div class="blog-hero-meta">
        <a href="#latest" class="blog-meta-pill">Latest Posts</a>
      </div>
    </div>
    <div class="blog-hero-scroll">
      <span>Explore</span>
      <div class="blog-scroll-line"></div>
    </div>
  </section>

  <section class="blog-section" id="latest">
    <div class="blog-section-inner">
      <div class="guide-section-header reveal">
        <div class="section-label">Latest</div>
        <h2 class="section-heading">Recent <em>posts</em></h2>
        <p class="blog-section-intro">Advice and destination ideas for planning better trips and making the most of every stop.</p>
      </div>

      <div class="blog-controls">
        <input type="text" id="blogSearch" class="blog-search" placeholder="Search posts..." aria-label="Search blog posts" />
        <div class="blog-tabs" id="blogTabs">
          <button class="blog-tab active" data-cat="all">All</button>
          {categories.map((cat) => (
            <button class="blog-tab" data-cat={cat}>{cat}</button>
          ))}
        </div>
      </div>

      <div class="blog-grid" id="blogGrid">
        {blogPosts.map((post, i) => (
          <a href={`/blog/${post.slug}/`} class="blog-card" data-category={post.category || ''} data-title={post.title.toLowerCase()} data-description={post.description.toLowerCase()}>
            <img src={post.heroImage} alt={post.title} loading={i === 0 ? 'eager' : 'lazy'} width="1200" height="800" />
            <div class="blog-card-content">
              {post.category && <span class="blog-card-category">{post.category}</span>}
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="blog-card-meta">
                {formatDate(post.publishedAt) && <span>{formatDate(post.publishedAt)}</span>}
                {post.readingTime && <span>{post.readingTime}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>
      <p class="blog-no-results" id="blogNoResults" hidden>No posts found.</p>
      <div class="blog-show-more-wrap">
        <button class="blog-show-more" id="blogShowMore">Show more</button>
      </div>
    </div>
  </section>

  <section class="blog-email-capture">
    <div class="blog-email-inner">
      <div class="blog-email-copy">
        <p class="blog-email-label">Stay in the loop</p>
        <h2 class="blog-email-heading">Get the best travel tips <em>in your inbox</em></h2>
        <p class="blog-email-sub">No spam. New guides, routes, and travel tactics — a few times a month.</p>
      </div>
      <form class="blog-email-form" id="blog-email-form" novalidate>
        <input
          type="email"
          class="blog-email-input"
          id="blog-email-input"
          placeholder="your@email.com"
          autocomplete="email"
          required
          aria-label="Email address"
        />
        <button type="submit" class="blog-email-submit" data-ph-event="blog_newsletter_submit">Subscribe</button>
        <p class="blog-email-error" id="blog-email-error" aria-live="polite"></p>
      </form>
      <p class="blog-email-success" id="blog-email-success" hidden>You're in! We'll be in touch.</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ blogHeroImages }}>
  const blogHeroBackground = document.getElementById('blogHeroBackground');
  if (blogHeroBackground && blogHeroImages.length > 0) {
    const heroImage = blogHeroImages[Math.floor(Math.random() * blogHeroImages.length)];
    const safeUrl = heroImage.replace(/['"()\\]/g, '');
    blogHeroBackground.style.backgroundImage = `linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('${safeUrl}')`;
  }
</script>

<style>
  .blog-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 0 40px 80px;
    overflow: hidden;
  }

  .blog-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.08);
    animation: heroZoom 9s var(--ease-out-expo) forwards;
  }

  .blog-hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    color: #f5f1eb;
  }

  .blog-hero-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgba(245, 241, 235, 0.24);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    margin-bottom: 24px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .blog-hero-breadcrumb a {
    color: inherit;
    transition: color 0.3s ease;
  }

  .blog-hero-breadcrumb a:hover {
    color: #fff;
  }

  .blog-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-size: 14px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(245, 241, 235, 0.86);
  }

  .blog-hero-title {
    font-family: var(--font-display);
    font-size: clamp(62px, 12vw, 130px);
    line-height: 0.9;
    margin-bottom: 20px;
    color: #f7f2ea;
    letter-spacing: -0.03em;
  }

  .blog-hero-title em {
    font-style: italic;
    font-weight: 400;
  }

  .blog-hero-subtitle {
    font-size: clamp(19px, 2.4vw, 26px);
    line-height: 1.5;
    color: rgba(245, 241, 235, 0.9);
    margin-bottom: 30px;
  }

  .blog-hero-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .blog-meta-pill {
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid rgba(245, 241, 235, 0.22);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
    transition: background-color 0.3s ease, transform 0.3s var(--ease-out-expo);
  }

  .blog-meta-pill:hover {
    background-color: rgba(245, 241, 235, 0.12);
    transform: translateY(-1px);
  }

  .blog-hero-scroll {
    position: absolute;
    bottom: 40px;
    right: 40px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeUp 1s var(--ease-out-expo) 1.6s forwards;
  }

  .blog-hero-scroll span {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.5);
    writing-mode: vertical-rl;
  }

  .blog-scroll-line {
    width: 1px;
    height: 60px;
    background: rgba(245, 240, 232, 0.3);
    position: relative;
    overflow: hidden;
  }

  .blog-scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-terracotta);
    animation: scrollLine 2s ease-in-out infinite;
  }

  .blog-section {
    padding: 48px 40px 96px;
  }

  .blog-section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-section-intro {
    max-width: 720px;
    color: var(--color-text-muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.65;
    margin-bottom: 34px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .blog-card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: #fff;
    border: 1px solid rgba(196, 86, 42, 0.12);
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.35s var(--ease-out-expo), border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: rgba(196, 86, 42, 0.32);
    box-shadow: 0 20px 32px rgba(26, 23, 20, 0.12);
  }

  .blog-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .blog-card-content {
    padding: 20px;
  }

  .blog-card-category {
    display: inline-block;
    margin-bottom: 10px;
    color: var(--color-terracotta);
    text-transform: uppercase;
    letter-spacing: 1.4px;
    font-weight: 600;
    font-size: 11px;
  }

  .blog-card h3 {
    font-family: var(--font-display);
    font-size: clamp(26px, 2.2vw, 32px);
    line-height: 1.15;
    color: var(--color-cream);
    margin-bottom: 10px;
  }

  .blog-card p {
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .blog-card-meta {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .blog-card-meta span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--color-cream-muted);
    background: #f7f2ea;
    border: 1px solid rgba(196, 86, 42, 0.12);
    border-radius: 999px;
    padding: 6px 10px;
  }

  /* CONTROLS: search + tabs */
  .blog-controls {
    margin-bottom: 32px;
  }

  .blog-search {
    width: 100%;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid rgba(196, 86, 42, 0.2);
    background: var(--color-bg);
    color: var(--color-cream);
    font-size: 15px;
    outline: none;
    transition: border-color 0.25s;
    margin-bottom: 16px;
  }

  .blog-search:focus {
    border-color: var(--color-terracotta);
  }

  .blog-search::placeholder {
    color: var(--color-text-muted);
  }

  .blog-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .blog-tab {
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid rgba(196, 86, 42, 0.2);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.6px;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }

  .blog-tab:hover {
    border-color: var(--color-terracotta);
    color: var(--color-cream);
  }

  .blog-tab.active {
    background: var(--color-terracotta);
    border-color: var(--color-terracotta);
    color: #fff;
  }

  .blog-no-results {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 18px;
    padding: 48px 0;
  }

  .blog-show-more-wrap {
    text-align: center;
    margin-top: 32px;
  }

  .blog-show-more {
    padding: 12px 32px;
    border-radius: 999px;
    border: 1px solid rgba(196, 86, 42, 0.3);
    background: transparent;
    color: var(--color-terracotta);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.6px;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, transform 0.25s var(--ease-out-expo);
  }

  .blog-show-more:hover {
    background: var(--color-terracotta);
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 1024px) {
    .blog-hero {
      min-height: 82vh;
      padding: 170px 24px 56px;
    }

    .blog-hero-scroll {
      right: 24px;
      bottom: 30px;
    }

    .blog-section {
      padding: 80px 24px;
    }

    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .blog-hero {
      min-height: 75vh;
      padding: 170px 20px 38px;
    }

    .blog-hero-title {
      font-size: clamp(54px, 20vw, 98px);
    }

    .blog-hero-scroll {
      display: none;
    }

    .blog-section {
      padding: 64px 20px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }

  /* EMAIL CAPTURE */
  .blog-email-capture {
    padding: 80px 40px;
    background: var(--color-bg-warm);
  }

  .blog-email-inner {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .blog-email-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: 14px;
  }

  .blog-email-heading {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.1;
    color: var(--color-cream);
    margin-bottom: 12px;
  }

  .blog-email-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .blog-email-sub {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .blog-email-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .blog-email-input {
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid rgba(196, 86, 42, 0.2);
    background: var(--color-bg);
    color: var(--color-cream);
    font-size: 15px;
    outline: none;
    transition: border-color 0.25s;
  }

  .blog-email-input:focus {
    border-color: var(--color-terracotta);
  }

  .blog-email-input::placeholder {
    color: var(--color-text-muted);
  }

  .blog-email-submit {
    padding: 14px 24px;
    border-radius: 12px;
    background: var(--color-terracotta);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s var(--ease-out-expo);
  }

  .blog-email-submit:hover:not(:disabled) {
    background: #b34f28;
    transform: translateY(-1px);
  }

  .blog-email-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .blog-email-error {
    font-size: 13px;
    color: #e05a3a;
    min-height: 1em;
  }

  .blog-email-success {
    font-size: 16px;
    color: var(--color-cream);
    font-weight: 500;
    padding: 14px 0;
  }

  @media (max-width: 768px) {
    .blog-email-capture { padding: 60px 24px; }
    .blog-email-inner { grid-template-columns: 1fr; gap: 32px; }
  }

  @media (max-width: 640px) {
    .blog-email-capture { padding: 48px 20px; }
  }
</style>

<script>
  (function () {
    const form = document.getElementById('blog-email-form') as HTMLFormElement | null;
    const input = document.getElementById('blog-email-input') as HTMLInputElement | null;
    const errorEl = document.getElementById('blog-email-error') as HTMLElement | null;
    const successEl = document.getElementById('blog-email-success') as HTMLElement | null;
    if (!form || !input) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const email = input.value.trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (errorEl) errorEl.textContent = 'Please enter a valid email address.';
        return;
      }
      if (errorEl) errorEl.textContent = '';
      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submit) submit.disabled = true;

      try {
        const res = await fetch('https://api.roammate.com/v1/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'blog-newsletter' }),
        });
        if (res.ok) {
          form.hidden = true;
          if (successEl) successEl.hidden = false;
        } else {
          if (errorEl) errorEl.textContent = 'Something went wrong. Please try again.';
          if (submit) submit.disabled = false;
        }
      } catch {
        if (errorEl) errorEl.textContent = 'Network error. Please try again.';
        if (submit) submit.disabled = false;
      }
    });
  })();
</script>

<script>
  (function () {
    const PAGE_SIZE = 12;
    const grid = document.getElementById('blogGrid');
    const searchInput = document.getElementById('blogSearch') as HTMLInputElement | null;
    const tabsWrap = document.getElementById('blogTabs');
    const showMoreBtn = document.getElementById('blogShowMore');
    const noResults = document.getElementById('blogNoResults');
    if (!grid || !searchInput || !tabsWrap || !showMoreBtn || !noResults) return;

    const allCards = Array.from(grid.querySelectorAll('.blog-card')) as HTMLElement[];
    let activeCat = 'all';
    let query = '';
    let visibleCount = PAGE_SIZE;

    function getFiltered(): HTMLElement[] {
      return allCards.filter((card) => {
        const cat = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-description') || '';
        const matchesCat = activeCat === 'all' || cat === activeCat;
        const q = query.toLowerCase();
        const matchesQuery = !q || title.includes(q) || desc.includes(q) || cat.toLowerCase().includes(q);
        return matchesCat && matchesQuery;
      });
    }

    function render() {
      const filtered = getFiltered();
      allCards.forEach((c) => (c.style.display = 'none'));
      filtered.forEach((c, i) => {
        c.style.display = i < visibleCount ? '' : 'none';
      });
      noResults.hidden = filtered.length > 0;
      showMoreBtn.style.display = visibleCount >= filtered.length ? 'none' : '';
    }

    // Tabs
    tabsWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.blog-tab') as HTMLElement | null;
      if (!btn) return;
      tabsWrap.querySelectorAll('.blog-tab').forEach((t) => t.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.getAttribute('data-cat') || 'all';
      visibleCount = PAGE_SIZE;
      render();
    });

    // Search with debounce
    let timer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        query = searchInput.value.trim();
        visibleCount = PAGE_SIZE;
        render();
      }, 300);
    });

    // Show more
    showMoreBtn.addEventListener('click', () => {
      visibleCount += PAGE_SIZE;
      render();
    });

    render();
  })();
</script>
