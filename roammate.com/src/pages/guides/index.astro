---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllGuides, getCityGuideSlugs, getBackpackerRoutes } from '../../data/guides';

const allGuides = await getAllGuides();
const cityGuideSlugs = await getCityGuideSlugs();
const routeData = await getBackpackerRoutes();

const cityGuideCount = allGuides.filter((g) => cityGuideSlugs.has(g.slug)).length;
const placeGuideCount = allGuides.filter((g) => !cityGuideSlugs.has(g.slug)).length;
const routeCount = routeData.length;
const destinationCount = cityGuideCount + placeGuideCount;

const topCities = allGuides
  .filter((g) => cityGuideSlugs.has(g.slug))
  .map((g) => ({ slug: g.slug, name: g.name, flag: g.flag, country: g.country }));

const topPlaces = allGuides
  .filter((g) => !cityGuideSlugs.has(g.slug))
  .map((g) => ({ slug: g.slug, name: g.name, flag: g.flag, country: g.country }));

const topRoutes = routeData.map((r) => ({ slug: r.slug, name: r.name, flags: r.flags, tagline: r.tagline, duration: r.duration }));
---

<BaseLayout
  title={`Travel Guides: ${cityGuideCount} City & ${placeGuideCount} Place Itineraries | roammate`}
  description={`Free travel guides for ${cityGuideCount} cities, ${placeGuideCount} bucket-list places, and ${routeCount} backpacker routes. Budget tips, day-by-day itineraries, and local recommendations.`}
  ogImage="/images/guides/tokyo-hero.webp"
>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" href="/images/guides/tokyo-hero.webp">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": `Travel Guides: ${cityGuideCount} City & ${placeGuideCount} Place Itineraries`,
      "url": "https://roammate.com/guides/",
      "description": `Free travel guides for ${cityGuideCount} cities, ${placeGuideCount} bucket-list places, and ${routeCount} backpacker routes.`,
      "numberOfItems": destinationCount + routeCount,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "roammate Travel Guides",
      "description": `Free backpacker travel guides covering ${destinationCount} destinations and ${routeCount} multi-country routes.`,
      "url": "https://roammate.com/guides/",
      "numberOfItems": destinationCount + routeCount,
      "itemListElement": [
        ...topCities.map((g, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": `${g.name} Travel Guide`,
          "url": `https://roammate.com/guides/cities/${g.slug}/`,
        })),
        ...topRoutes.map((r, i) => ({
          "@type": "ListItem",
          "position": topCities.length + i + 1,
          "name": `${r.name} Backpacker Route`,
          "url": `https://roammate.com/guides/${r.slug}/`,
        })),
      ],
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://roammate.com/guides/" }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="guides-hero">
    <div class="guides-hero-bg" id="heroBackground" style="background-image: linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('/images/guides/tokyo-hero.webp');"></div>
    <div class="guides-hero-content">
      <div class="guides-hero-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Guides</span>
      </div>
      <div class="guides-hero-tag">
        <span>🌍</span>
        <span>{destinationCount} Destinations</span>
      </div>
      <h1 class="guides-hero-title">Travel <em>Guides</em></h1>
      <p class="guides-hero-subtitle">Day-by-day itineraries with budget breakdowns and local tips from people who have been there.</p>
      <div class="guides-hero-meta">
        <a href="/guides/routes/" class="guides-meta-pill">Backpacker Routes</a>
        <a href="/guides/cities/" class="guides-meta-pill">City Guides</a>
        <a href="/guides/places/" class="guides-meta-pill">Places & Landmarks</a>
      </div>
    </div>
    <div class="guides-hero-scroll">
      <span>Explore</span>
      <div class="guides-scroll-line"></div>
    </div>
  </section>

  <!-- Category Cards -->
  <section class="guides-categories">
    <div class="guides-categories-inner">

      <!-- Backpacker Routes -->
      <div class="category-block reveal">
        <div class="category-header">
          <div class="section-label">Multi-Country</div>
          <h2 class="section-heading">Backpacker <em>Routes</em></h2>
          <p class="category-intro">Long-stay routes through entire regions: week-by-week phasing, country-by-country breakdowns, and budget strategies for extended travel.</p>
        </div>
        <div class="routes-preview" data-shuffle-group="routes" data-show="4">
          {topRoutes.map((route, i) => (
            <a href={`/guides/${route.slug}/`} class={`route-preview-card reveal reveal-delay-${(i % 4) + 1}`}>
              <div class="route-preview-flags">{route.flags}</div>
              <h3>{route.name}</h3>
              <p>{route.tagline}</p>
              <span class="route-preview-duration">{route.duration}</span>
            </a>
          ))}
        </div>
        <a href="/guides/routes/" class="category-view-all">View all {routeCount} routes →</a>
      </div>

      <!-- City Guides -->
      <div class="category-block category-block--alt reveal">
        <div class="category-header">
          <div class="section-label">City Guides</div>
          <h2 class="section-heading">{cityGuideCount} <em>Cities</em></h2>
          <p class="category-intro">1, 3, and 7-day itineraries with morning-to-evening plans, budget tips, cultural insights, and practical information.</p>
        </div>
        <div class="cities-preview" data-shuffle-group="cities" data-show="8">
          {topCities.map((city, i) => (
            <a href={`/guides/${city.slug}/`} class={`city-preview-card reveal reveal-delay-${(i % 4) + 1}`}>
              <span class="city-preview-flag">{city.flag}</span>
              <div>
                <h3>{city.name}</h3>
                <span>{city.country}</span>
              </div>
            </a>
          ))}
        </div>
        <a href="/guides/cities/" class="category-view-all">View all {cityGuideCount} city guides →</a>
      </div>

      <!-- Places & Landmarks -->
      <div class="category-block reveal">
        <div class="category-header">
          <div class="section-label">Bucket List</div>
          <h2 class="section-heading">{placeGuideCount} <em>Places</em></h2>
          <p class="category-intro">National parks, UNESCO sites, bucket-list landmarks, epic treks, and island paradises, with 1 and 3-day itineraries.</p>
        </div>
        <div class="places-preview" data-shuffle-group="places" data-show="8">
          {topPlaces.map((place, i) => (
            <a href={`/guides/${place.slug}/`} class={`place-preview-card reveal reveal-delay-${(i % 4) + 1}`}>
              <span class="place-preview-flag">{place.flag}</span>
              <div>
                <h3>{place.name}</h3>
                <span>{place.country}</span>
              </div>
            </a>
          ))}
        </div>
        <a href="/guides/places/" class="category-view-all">View all {placeGuideCount} place guides →</a>
      </div>

    </div>
  </section>

</BaseLayout>

<script>
  const heroSlugs = [
    'paris','tokyo','barcelona','rome','amsterdam','london','berlin','sydney','new-york-city',
    'machu-picchu','santorini','great-barrier-reef','kruger-national-park','banff','angkor-wat',
    'cinque-terre','grand-canyon','milford-sound','victoria-falls','petra',
  ];
  const slug = heroSlugs[Math.floor(Math.random() * heroSlugs.length)];
  const bg = document.getElementById('heroBackground');
  if (bg) {
    const safeSlug = slug.replace(/[^a-z0-9-]/g, '');
    bg.style.backgroundImage = `linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('/images/guides/${safeSlug}-hero.webp')`;
  }
</script>

<script>
  // @ts-nocheck
  document.querySelectorAll('[data-shuffle-group]').forEach(grid => {
    const items = [...grid.children];
    const show = parseInt(grid.dataset.show) || 8;
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }
    items.forEach((item, idx) => {
      grid.appendChild(item);
      if (idx < show) item.classList.add('shuffle-visible');
    });
  });
</script>

<style>
  /* ========================
     HERO
     ======================== */
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }


  .guides-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 0 40px 80px;
    overflow: hidden;
  }

  .guides-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(135deg, #1a1714 0%, #2a2520 40%, #1a1714 100%);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity 0.6s ease;
  }

  .guides-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .guides-hero-breadcrumb {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.4);
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.3s forwards;
  }

  .guides-hero-breadcrumb a {
    color: rgba(245, 240, 232, 0.6);
    transition: color 0.3s;
  }

  .guides-hero-breadcrumb a:hover {
    color: var(--color-terracotta-light);
  }

  .guides-hero-breadcrumb span {
    margin: 0 8px;
  }

  .guides-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-terracotta-light);
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.5s forwards;
  }

  .guides-hero-tag span:first-child {
    font-size: 24px;
  }

  .guides-hero-title {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 140px);
    font-weight: 900;
    line-height: 0.9;
    color: #f5f0e8;
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(40px);
    animation: fadeUp 1.2s var(--ease-out-expo) 0.7s forwards;
  }

  .guides-hero-title em {
    font-style: italic;
    font-weight: 400;
  }

  .guides-hero-subtitle {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.7);
    max-width: 500px;
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.9s forwards;
  }

  .guides-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 1.1s forwards;
  }

  .guides-meta-pill {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.8);
    padding: 8px 16px;
    border: 1px solid rgba(245, 240, 232, 0.15);
    border-radius: 100px;
    transition: all 0.3s var(--ease-out-expo);
    text-decoration: none;
  }

  .guides-meta-pill:hover {
    color: var(--color-terracotta-light);
    border-color: var(--color-terracotta-light);
  }

  .guides-hero-scroll {
    position: absolute;
    bottom: 40px;
    right: 40px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeUp 1s var(--ease-out-expo) 1.4s forwards;
  }

  .guides-hero-scroll span {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.4);
    writing-mode: vertical-rl;
  }

  .guides-scroll-line {
    width: 1px;
    height: 60px;
    background: rgba(245, 240, 232, 0.3);
    position: relative;
    overflow: hidden;
  }

  .guides-scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-terracotta);
    animation: scrollLine 2s ease-in-out infinite;
  }

  /* ========================
     SHUFFLE VISIBILITY
     ======================== */
  [data-shuffle-group] > * { display: none; }
  [data-shuffle-group] > .shuffle-visible { display: flex; }
  .routes-preview[data-shuffle-group] > .shuffle-visible { display: block; }

  /* ========================
     CATEGORIES
     ======================== */
  .guides-categories {
    padding: 0;
  }

  .guides-categories-inner {
    max-width: 100%;
  }

  .category-block {
    padding: 100px 40px;
  }

  .category-block--alt {
    background: var(--color-bg-warm);
  }

  .category-header {
    max-width: 1200px;
    margin: 0 auto 48px;
  }

  .category-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-ink-muted);
    font-weight: 300;
    max-width: 600px;
  }

  .category-view-all {
    display: block;
    max-width: 1200px;
    margin: 32px auto 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-terracotta);
    transition: color 0.3s;
  }

  .category-view-all:hover {
    color: var(--color-terracotta-light);
  }

  /* ========================
     ROUTES PREVIEW
     ======================== */
  .routes-preview {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .route-preview-card {
    display: block;
    padding: 32px;
    background: var(--color-bg-warm);
    border-radius: 8px;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
    text-decoration: none;
  }

  .route-preview-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  }

  .route-preview-flags {
    font-size: 24px;
    margin-bottom: 16px;
    letter-spacing: 4px;
  }

  .route-preview-card h3 {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .route-preview-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-muted);
    font-weight: 300;
    margin-bottom: 16px;
  }

  .route-preview-duration {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-terracotta);
  }

  /* ========================
     CITIES PREVIEW
     ======================== */
  .cities-preview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .city-preview-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    background: var(--color-bg);
    border-radius: 8px;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
    text-decoration: none;
  }

  .city-preview-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.04);
  }

  .city-preview-flag {
    font-size: 28px;
    flex-shrink: 0;
  }

  .city-preview-card h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .city-preview-card span {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  /* ========================
     PLACES PREVIEW
     ======================== */
  .places-preview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .place-preview-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    background: var(--color-bg-warm);
    border-radius: 8px;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
    text-decoration: none;
  }

  .place-preview-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.04);
  }

  .place-preview-flag {
    font-size: 24px;
    flex-shrink: 0;
  }

  .place-preview-card h3 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .place-preview-card span {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  /* ========================
     RESPONSIVE
     ======================== */
  @media (max-width: 1024px) {
    .guides-hero { padding: 170px 24px 60px; }
    .category-block { padding: 80px 24px; }
    .routes-preview { grid-template-columns: repeat(2, 1fr); }
    .cities-preview { grid-template-columns: repeat(3, 1fr); }
    .places-preview { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 640px) {
    .guides-hero { padding: 170px 20px 40px; min-height: 90vh; }
    .guides-hero-title { font-size: clamp(56px, 18vw, 100px); }
    .guides-hero-scroll { display: none; }
    .category-block { padding: 60px 20px; }
    .routes-preview { grid-template-columns: 1fr; }
    .cities-preview { grid-template-columns: repeat(2, 1fr); }
    .places-preview { grid-template-columns: repeat(2, 1fr); }
  }
</style>
