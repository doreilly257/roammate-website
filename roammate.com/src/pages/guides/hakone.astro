  { icon: '🎒', label: 'Daily Budget', value: '~$50–180 USD', detail: 'Budget to mid-range' },
  { icon: '🛂', label: 'Visa', value: 'Visa-free for many nationalities', detail: 'Up to 90 days for most Western passports' },
