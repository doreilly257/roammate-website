---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page Not Found – roammate – travel companion app" description="The page you're looking for doesn't exist.">
  <section class="not-found">
    <!-- Floating background pins -->
    <div class="floating-pins">
      <svg class="pin pin-1" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      <svg class="pin pin-2" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      <svg class="pin pin-3" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      <svg class="pin pin-4" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      <svg class="pin pin-5" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
    </div>

    <div class="not-found-content">
      <div class="error-code">
        <span class="digit">4</span>
        <div class="logo-spinner">
          <img src={`${base}images/rm-notext-cropped.svg`} alt="roammate logo">
        </div>
        <span class="digit">4</span>
      </div>

      <h1 class="not-found-title">You've wandered <em>off the map</em></h1>
      <p class="not-found-body">This trail doesn't lead anywhere. But every wrong turn is just another adventure waiting to happen.</p>

      <p class="redirect-notice">Redirecting in <span id="countdown">10</span> seconds...</p>

      <a href="/" class="back-btn">
        <svg viewBox="0 0 24 24" class="back-icon"><path d="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"/></svg>
        Back to base camp
      </a>
    </div>

    <!-- Animated compass -->
    <div class="compass">
      <svg viewBox="0 0 100 100" class="compass-svg">
        <circle cx="50" cy="50" r="45" class="compass-ring"/>
        <line x1="50" y1="10" x2="50" y2="20" class="compass-tick"/>
        <line x1="50" y1="80" x2="50" y2="90" class="compass-tick"/>
        <line x1="10" y1="50" x2="20" y2="50" class="compass-tick"/>
        <line x1="80" y1="50" x2="90" y2="50" class="compass-tick"/>
        <polygon points="50,18 45,50 55,50" class="compass-needle-n"/>
        <polygon points="50,82 45,50 55,50" class="compass-needle-s"/>
      </svg>
    </div>
  </section>
</BaseLayout>

<script>
  const el = document.getElementById('countdown');
  let seconds = 10;
  const timer = setInterval(() => {
    seconds--;
    if (el) el.textContent = String(seconds);
    if (seconds <= 0) {
      clearInterval(timer);
      window.location.href = '/';
    }
  }, 1000);
</script>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 40px 80px;
    position: relative;
    overflow: hidden;
    background: #0f0f0f;
  }

  /* Floating map pins */
  .floating-pins {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pin {
    position: absolute;
    width: 24px;
    height: 24px;
    stroke: var(--color-terracotta);
    fill: none;
    stroke-width: 1;
    opacity: 0.12;
  }

  .pin-1 { top: 15%; left: 10%; animation: floatPin 8s ease-in-out infinite; }
  .pin-2 { top: 25%; right: 15%; animation: floatPin 10s ease-in-out infinite 1s; }
  .pin-3 { bottom: 30%; left: 20%; animation: floatPin 9s ease-in-out infinite 2s; }
  .pin-4 { bottom: 20%; right: 25%; animation: floatPin 7s ease-in-out infinite 0.5s; }
  .pin-5 { top: 50%; left: 50%; animation: floatPin 11s ease-in-out infinite 3s; }

  @keyframes floatPin {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.08; }
    50% { transform: translateY(-20px) rotate(15deg); opacity: 0.2; }
  }

  /* Content */
  .not-found-content {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  /* 4 [logo] 4 */
  .error-code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 48px;
  }

  .digit {
    font-family: var(--font-display);
    font-size: clamp(100px, 15vw, 200px);
    font-weight: 900;
    color: var(--color-terracotta);
    line-height: 1;
    opacity: 0.9;
    text-shadow: 0 0 60px rgba(196, 86, 42, 0.3);
  }

  .logo-spinner {
    width: clamp(80px, 12vw, 160px);
    height: clamp(80px, 12vw, 160px);
    perspective: 800px;
  }

  .logo-spinner img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: spinY 3s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    filter: drop-shadow(0 0 30px rgba(196, 86, 42, 0.4));
  }

  @keyframes spinY {
    0% { transform: rotateY(0deg); }
    100% { transform: rotateY(360deg); }
  }

  .not-found-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    color: #f5f0e8;
    margin-bottom: 20px;
  }

  .not-found-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .not-found-body {
    font-size: 17px;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.6);
    font-weight: 300;
    max-width: 480px;
    margin: 0 auto 48px;
  }

  .redirect-notice {
    font-size: 13px;
    color: rgba(245, 240, 232, 0.4);
    letter-spacing: 1px;
    margin-bottom: 24px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 36px;
    border: 1px solid var(--color-terracotta);
    color: var(--color-terracotta-light);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.4s var(--ease-out-expo);
    border-radius: 4px;
  }

  .back-btn:hover {
    background: var(--color-terracotta);
    color: #fff;
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(196, 86, 42, 0.3);
  }

  .back-icon {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Compass */
  .compass {
    position: absolute;
    bottom: 60px;
    right: 60px;
    width: 80px;
    height: 80px;
    opacity: 0.15;
    animation: compassSpin 20s linear infinite;
  }

  .compass-svg {
    width: 100%;
    height: 100%;
  }

  .compass-ring {
    fill: none;
    stroke: var(--color-terracotta);
    stroke-width: 1;
  }

  .compass-tick {
    stroke: rgba(245, 240, 232, 0.4);
    stroke-width: 1.5;
  }

  .compass-needle-n {
    fill: var(--color-terracotta);
    opacity: 0.8;
  }

  .compass-needle-s {
    fill: rgba(245, 240, 232, 0.3);
  }

  @keyframes compassSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @media (max-width: 1024px) {
    .not-found { padding: 120px 24px 60px; }
    .compass { bottom: 30px; right: 30px; width: 60px; height: 60px; }
  }

  @media (max-width: 640px) {
    .error-code { gap: 0; }
    .compass { display: none; }
  }
</style>
