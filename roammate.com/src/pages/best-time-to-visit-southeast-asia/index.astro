        { "@type": "ListItem", "position": 2, "name": "Best Time to Visit Southeast Asia", "item": "https://roammate.com/best-time-to-visit-southeast-asia/" }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
