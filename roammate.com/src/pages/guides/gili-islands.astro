const culturalTips = [
  { icon: '🙏', title: 'Respect the Sasak Culture', text: 'The Gili Islands are part of Lombok, home to the Muslim Sasak people. Dress modestly when away from the beach — cover shoulders and knees in villages. Be aware of prayer times and keep noise levels respectful.' },
  { icon: '🌍', title: 'Protect Marine Life', text: 'Do not touch, stand on, or break coral. Never touch, ride, or chase sea turtles — it is illegal and causes them serious stress. Use reef-safe sunscreen only. The Gili Islands are a marine protected area and enforcement is increasing.' },
  { icon: '📸', title: 'Photography Etiquette', text: 'Ask permission before photographing locals, especially Sasak fishermen and their families. Underwater photography is welcomed but never use flash near marine life — it disorients turtles and fish.' },
  { icon: '🗣', title: 'Language & Communication', text: 'English is widely spoken on Gili Trawangan. Learn basic Indonesian — terima kasih (thank you), tolong (please), tidak (no). Locals appreciate the effort and respond warmly to even a few words.' },
  { icon: '🤝', title: 'Support Local Communities', text: 'Buy from local warungs rather than Western-owned restaurants. Choose locally-owned guesthouses and dive shops that employ island residents. Participate in beach clean-ups organised by Gili Eco Trust if you have time.' },
  { icon: '🕐', title: 'Embrace Island Pace', text: 'Nothing runs on schedule on the Gilis — boats leave when they are full, food arrives when it is ready, and the concept of urgency does not exist. Relax into it and you will enjoy the islands far more.' },
];
