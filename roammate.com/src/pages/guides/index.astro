---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allGuides, cityGuideSlugs, backpackerRoutes as routeData } from '../../data/guides';

const backpackerRoutes = routeData.map((r) => ({
  slug: r.slug,
  title: r.name,
  flags: r.flags,
  duration: r.duration,
  tagline: r.tagline,
}));

const cityGuides = allGuides
  .filter((guide) => cityGuideSlugs.has(guide.slug))
  .map((guide) => ({
    slug: guide.slug,
    city: guide.name,
    country: guide.country,
    flag: guide.flag,
    region: guide.region,
  }));

const cityGuideSortOptions: Intl.CollatorOptions = { sensitivity: 'base' };
const sortedCityGuides = [...cityGuides].sort((a, b) => {
  const countrySort = a.country.localeCompare(b.country, undefined, cityGuideSortOptions);
  if (countrySort !== 0) return countrySort;
  return a.city.localeCompare(b.city, undefined, cityGuideSortOptions);
});

const placeGuides = allGuides
  .filter((guide) => !cityGuideSlugs.has(guide.slug))
  .map((guide) => ({
    slug: guide.slug,
    place: guide.name,
    country: guide.country,
    flag: guide.flag,
    region: guide.region,
    type: 'Guide',
  }));

const placeGuideSortOptions: Intl.CollatorOptions = { sensitivity: 'base' };
const sortedPlaceGuides = [...placeGuides].sort((a, b) => {
  const countrySort = a.country.localeCompare(b.country, undefined, placeGuideSortOptions);
  if (countrySort !== 0) return countrySort;
  return a.place.localeCompare(b.place, undefined, placeGuideSortOptions);
});

const typeIcons: Record<string, string> = {
  Guide: '📍',
};

const cityGuideCount = cityGuides.length;
const placeGuideCount = placeGuides.length;
const destinationCount = cityGuideCount + placeGuideCount;
---

<BaseLayout
  title={`Travel Guides — ${cityGuideCount} City & ${placeGuideCount} Place Itineraries | roammate`}
  description={`Free travel guides for ${cityGuideCount} cities, ${placeGuideCount} bucket-list places, and ${backpackerRoutes.length} backpacker routes. Budget tips, day-by-day itineraries, and local recommendations for young travelers.`}
  ogImage="/images/guides/tokyo-hero.webp"
>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" href="/images/guides/tokyo-hero.webp">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": `Travel Guides — ${cityGuideCount} City & ${placeGuideCount} Place Itineraries`,
      "url": "https://roammate.com/guides/",
      "description": `Free travel guides for ${cityGuideCount} cities, ${placeGuideCount} bucket-list places, and ${backpackerRoutes.length} backpacker routes.`,
      "numberOfItems": destinationCount + backpackerRoutes.length,
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://roammate.com/guides/" }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="guides-hero">
    <div class="guides-hero-bg" id="heroBackground" style="background-image: linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('/images/guides/tokyo-hero.webp');"></div>
    <div class="guides-hero-content">
      <div class="guides-hero-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Guides</span>
      </div>
      <div class="guides-hero-tag">
        <span>🌍</span>
        <span>{destinationCount} Destinations</span>
      </div>
      <h1 class="guides-hero-title">Travel <em>Guides</em></h1>
      <p class="guides-hero-subtitle">Day-by-day itineraries with budget breakdowns and local tips — curated for younger travelers.</p>
      <div class="guides-hero-meta">
        <a href="#routes" class="guides-meta-pill">Backpacker Routes</a>
        <a href="#cities" class="guides-meta-pill">City Guides</a>
        <a href="#places" class="guides-meta-pill">Places & Landmarks</a>
      </div>
    </div>
    <div class="guides-hero-scroll">
      <span>Explore</span>
      <div class="guides-scroll-line"></div>
    </div>
  </section>

  <!-- Backpacker Routes -->
  <section class="guides-section" id="routes">
    <div class="guides-section-inner">
      <div class="guide-section-header reveal">
        <div class="section-label">Multi-Country</div>
        <h2 class="section-heading">Backpacker <em>Routes</em></h2>
        <p class="guides-section-intro">Long-stay routes through entire regions — week-by-week phasing, country-by-country breakdowns, and budget strategies for extended travel.</p>
      </div>
      <div class="guides-routes-grid">
        {backpackerRoutes.map((route, i) => (
          <a href={`/guides/${route.slug}/`} class={`guides-route-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="guides-route-flags">{route.flags}</div>
            <h3 class="guides-route-title">{route.title}</h3>
            <p class="guides-route-tagline">{route.tagline}</p>
            <span class="guides-route-duration">{route.duration}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- City Guides -->
  <section class="guides-section guides-section--alt" id="cities">
    <div class="guides-section-inner">
      <div class="guide-section-header reveal">
        <div class="section-label">City Guides</div>
        <h2 class="section-heading">{cityGuideCount} <em>Cities</em></h2>
        <p class="guides-section-intro">1, 3, and 7-day itineraries with morning-to-evening plans, budget tips, cultural insights, and practical information.</p>
      </div>
      <div class="guides-sort-controls reveal" role="group" aria-label="Sort city guides alphabetically">
        <span class="guides-sort-label">Alphabetical</span>
        <button class="guides-sort-option" type="button" data-sort-group="cities" data-sort-mode="city">City</button>
        <button class="guides-sort-option is-active" type="button" data-sort-group="cities" data-sort-mode="country-city">Country + City</button>
      </div>
      <div class="guides-cities-grid" id="guidesCitiesGrid">
        {sortedCityGuides.map((guide, i) => (
          <a href={`/guides/${guide.slug}/`} class={`guides-city-card reveal reveal-delay-${(i % 4) + 1}`} data-city={guide.city} data-country={guide.country}>
            <span class="guides-city-flag">{guide.flag}</span>
            <div>
              <h3 class="guides-city-name">{guide.city}</h3>
              <span class="guides-city-region">{guide.country} · {guide.region}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Places & Landmarks -->
  <section class="guides-section" id="places">
    <div class="guides-section-inner">
      <div class="guide-section-header reveal">
        <div class="section-label">Bucket List</div>
        <h2 class="section-heading">{placeGuideCount} <em>Places</em></h2>
        <p class="guides-section-intro">National parks, UNESCO sites, bucket-list landmarks, epic treks, and island paradises — with 1 and 3-day itineraries.</p>
      </div>
      <div class="guides-sort-controls reveal" role="group" aria-label="Sort place guides alphabetically">
        <span class="guides-sort-label">Alphabetical</span>
        <button class="guides-sort-option" type="button" data-sort-group="places" data-sort-mode="place">Place</button>
        <button class="guides-sort-option is-active" type="button" data-sort-group="places" data-sort-mode="country-place">Country + Place</button>
      </div>
      <div class="guides-places-grid" id="guidesPlacesGrid">
        {sortedPlaceGuides.map((guide, i) => (
          <a href={`/guides/${guide.slug}/`} class={`guides-place-card reveal reveal-delay-${(i % 4) + 1}`} data-place={guide.place} data-country={guide.country}>
            <span class="guides-place-flag">{guide.flag}</span>
            <div class="guides-place-info">
              <h3 class="guides-place-name">{guide.place}</h3>
              <span class="guides-place-region">{guide.country}</span>
            </div>
            <span class="guides-place-type">{typeIcons[guide.type] || '📍'} {guide.type}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const heroImages = [
    // Cities
    'paris','london','barcelona','rome','amsterdam','berlin','madrid','lisbon','prague','vienna',
    'dublin','milan','florence','venice','bologna','verona','munich','frankfurt','copenhagen','stockholm',
    'oslo','helsinki','athens','zurich','budapest','edinburgh','brussels','nice','seville','valencia',
    'palma-de-mallorca','warsaw','krakow','porto','rhodes','heraklion','thessaloniki','tallinn','vilnius','tbilisi',
    'istanbul','antalya','tokyo','seoul','osaka','kyoto','taipei','hong-kong','shanghai','beijing',
    'fukuoka','sapporo','busan','macau','guangzhou','shenzhen','zhuhai','singapore','bangkok','kuala-lumpur',
    'pattaya-chonburi','phuket','ho-chi-minh-city','hanoi','denpasar','johor-bahru','delhi','dubai','abu-dhabi','sharjah',
    'doha','riyadh','medina','mecca','tel-aviv','jerusalem','cairo','marrakech','sydney','melbourne',
    'new-york-city','los-angeles','las-vegas','orlando','miami','san-francisco','washington-dc','honolulu','toronto','vancouver',
    'montreal','mexico-city','cancun','sao-paulo','rio-de-janeiro','buenos-aires','lima','santiago','punta-cana','marne-la-vallee',
    // Places
    'kruger-national-park','serengeti','maasai-mara','victoria-falls','okavango-delta','sossusvlei','table-mountain',
    'blyde-river-canyon','mount-kilimanjaro','zanzibar','atlas-mountains','pyramids-of-giza','petra','wadi-rum','dead-sea',
    'wadi-shab','musandam','jebel-jais','cappadocia','pamukkale','golden-circle-iceland','jokulsarlon','geirangerfjord',
    'lofoten','scottish-highlands','giants-causeway','cliffs-of-moher','cinque-terre','amalfi-coast','dolomites',
    'lake-bled','plitvice-lakes','bay-of-kotor','meteora','santorini','lauterbrunnen','mont-blanc','calanques',
    'alhambra','sagrada-familia','camino-de-santiago','neuschwanstein','taj-mahal','amber-fort','varanasi-ghats','goa',
    'pangong-lake','annapurna-circuit','everest-base-camp','sigiriya','ella','maldives-local-islands','registan-samarkand',
    'issyk-kul','ha-long-bay','hoi-an','angkor-wat','kuang-si-falls','chiang-mai-temples','koh-tao','mount-kinabalu',
    'batu-caves','ubud-rice-terraces','komodo-national-park','borobudur','el-nido','siargao','mount-fuji','fushimi-inari',
    'great-wall','great-barrier-reef','whitsunday-islands','kgari','uluru','blue-mountains','milford-sound','tongariro',
    'abel-tasman','yasawa-islands','bora-bora','banff','icefields-parkway','zion','grand-canyon','yosemite','yellowstone',
    'na-pali-coast','chichen-itza','riviera-maya-cenotes','monteverde','machu-picchu','sacred-valley','salar-de-uyuni',
    'atacama-desert','torres-del-paine','perito-moreno','iguazu-falls','sugarloaf-mountain','cocora-valley','galapagos',
  ];
  const slug = heroImages[Math.floor(Math.random() * heroImages.length)];
  const bg = document.getElementById('heroBackground');
  if (bg) {
    bg.style.backgroundImage = `linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('/images/guides/${slug}-hero.webp')`;
  }

  const collator = new Intl.Collator(undefined, { sensitivity: 'base' });

  const sortGridItems = (gridId, primaryField, fallbackField) => {
    const grid = document.getElementById(gridId);
    if (!grid) return;

    const cards = Array.from(grid.children);
    cards.sort((a, b) => {
      const primaryA = a.getAttribute(`data-${primaryField}`) || '';
      const primaryB = b.getAttribute(`data-${primaryField}`) || '';
      const primarySort = collator.compare(primaryA, primaryB);
      if (primarySort !== 0) return primarySort;

      const fallbackA = a.getAttribute(`data-${fallbackField}`) || '';
      const fallbackB = b.getAttribute(`data-${fallbackField}`) || '';
      return collator.compare(fallbackA, fallbackB);
    });

    cards.forEach((card) => grid.appendChild(card));
  };

  document.querySelectorAll('.guides-sort-option').forEach((button) => {
    button.addEventListener('click', () => {
      const group = button.getAttribute('data-sort-group');
      const mode = button.getAttribute('data-sort-mode');
      if (!group || !mode) return;

      document.querySelectorAll(`.guides-sort-option[data-sort-group="${group}"]`).forEach((option) => {
        option.classList.toggle('is-active', option === button);
      });

      if (group === 'cities') {
        sortGridItems('guidesCitiesGrid', mode === 'city' ? 'city' : 'country', mode === 'city' ? 'country' : 'city');
      }

      if (group === 'places') {
        sortGridItems('guidesPlacesGrid', mode === 'place' ? 'place' : 'country', mode === 'place' ? 'country' : 'place');
      }
    });
  });
</script>

<style>
  /* ========================
     HERO (matches CityGuideLayout)
     ======================== */
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes scrollLine {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    50.01% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  .guides-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 0 40px 80px;
    overflow: hidden;
  }

  .guides-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(135deg, #1a1714 0%, #2a2520 40%, #1a1714 100%);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity 0.6s ease;
  }

  .guides-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .guides-hero-breadcrumb {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.4);
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.3s forwards;
  }

  .guides-hero-breadcrumb a {
    color: rgba(245, 240, 232, 0.6);
    transition: color 0.3s;
  }

  .guides-hero-breadcrumb a:hover {
    color: var(--color-terracotta-light);
  }

  .guides-hero-breadcrumb span {
    margin: 0 8px;
  }

  .guides-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-terracotta-light);
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.5s forwards;
  }

  .guides-hero-tag span:first-child {
    font-size: 24px;
  }

  .guides-hero-title {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 140px);
    font-weight: 900;
    line-height: 0.9;
    color: #f5f0e8;
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(40px);
    animation: fadeUp 1.2s var(--ease-out-expo) 0.7s forwards;
  }

  .guides-hero-title em {
    font-style: italic;
    font-weight: 400;
  }

  .guides-hero-subtitle {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.7);
    max-width: 500px;
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.9s forwards;
  }

  .guides-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 1.1s forwards;
  }

  .guides-meta-pill {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.8);
    padding: 8px 16px;
    border: 1px solid rgba(245, 240, 232, 0.15);
    border-radius: 100px;
    transition: all 0.3s var(--ease-out-expo);
    text-decoration: none;
  }

  .guides-meta-pill:hover {
    color: var(--color-terracotta-light);
    border-color: var(--color-terracotta-light);
  }

  .guides-hero-scroll {
    position: absolute;
    bottom: 40px;
    right: 40px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeUp 1s var(--ease-out-expo) 1.4s forwards;
  }

  .guides-hero-scroll span {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.4);
    writing-mode: vertical-rl;
  }

  .guides-scroll-line {
    width: 1px;
    height: 60px;
    background: rgba(245, 240, 232, 0.2);
    animation: scrollLine 2.5s ease-in-out infinite;
  }

  /* ========================
     SECTIONS
     ======================== */
  .guides-section {
    padding: 100px 40px;
  }

  .guides-section--alt {
    background: var(--color-bg-warm);
  }

  .guides-section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .guides-section-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-cream-muted);
    font-weight: 300;
    max-width: 600px;
  }

  .guide-section-header {
    margin-bottom: 56px;
  }

  .guides-sort-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: -28px 0 28px;
  }

  .guides-sort-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .guides-sort-option {
    border: 1px solid rgba(120, 90, 70, 0.22);
    background: transparent;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.25s var(--ease-out-expo);
  }

  .guides-sort-option:hover {
    border-color: var(--color-terracotta);
    color: var(--color-cream);
  }

  .guides-sort-option.is-active {
    border-color: var(--color-terracotta);
    background: rgba(177, 92, 60, 0.14);
    color: var(--color-cream);
  }

  /* ========================
     BACKPACKER ROUTES GRID
     ======================== */
  .guides-routes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .guides-route-card {
    display: block;
    padding: 32px;
    background: var(--color-bg-warm);
    border-radius: 8px;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
    text-decoration: none;
  }

  .guides-route-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  }

  .guides-route-flags {
    font-size: 24px;
    margin-bottom: 16px;
    letter-spacing: 4px;
  }

  .guides-route-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-cream);
    margin-bottom: 8px;
  }

  .guides-route-tagline {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-cream-muted);
    font-weight: 300;
    margin-bottom: 16px;
  }

  .guides-route-duration {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-terracotta);
  }

  /* ========================
     CITY GUIDES GRID
     ======================== */
  .guides-cities-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .guides-city-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    background: var(--color-bg);
    border-radius: 8px;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
    text-decoration: none;
  }

  .guides-city-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.04);
  }

  .guides-city-flag {
    font-size: 28px;
    flex-shrink: 0;
  }

  .guides-city-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-cream);
    line-height: 1.3;
  }

  .guides-city-region {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  /* ========================
     PLACES GRID
     ======================== */
  .guides-places-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .guides-place-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    background: var(--color-bg-warm);
    border-radius: 8px;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
    text-decoration: none;
  }

  .guides-place-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.04);
  }

  .guides-place-flag {
    font-size: 24px;
    flex-shrink: 0;
  }

  .guides-place-info {
    flex: 1;
    min-width: 0;
  }

  .guides-place-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-cream);
    line-height: 1.3;
  }

  .guides-place-region {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .guides-place-type {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
