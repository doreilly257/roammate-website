  { category: 'Drinks', budget: '$3–6', midrange: '$8–15', splurge: '$20+', notes: 'Supermarket → craft brewery → wine bars' },
  { category: 'Daily Total', budget: '$35–55', midrange: '$90–180', splurge: '$280+', notes: 'Backpacker → comfortable → adventure luxury' },
];

