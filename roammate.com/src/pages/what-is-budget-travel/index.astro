<style>
  .tc-hero {
    background: linear-gradient(135deg, #1a1714 0%, #2a2420 100%);
    padding: 120px 24px 64px;
    text-align: center;
  }

  .tc-hero-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .tc-breadcrumb {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.35);
    margin-bottom: 40px;
  }

  .tc-breadcrumb a {
    color: rgba(245, 240, 232, 0.55);
    transition: color 0.3s;
  }

  .tc-breadcrumb a:hover {
    color: var(--color-terracotta-light);
  }

  .tc-breadcrumb span {
    margin: 0 10px;
  }

  .tc-hero-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 900;
    line-height: 1.15;
    color: #f5f0e8;
  }

  .tc-content {
    padding: 56px 24px 64px;
  }

  .tc-content-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .budget-travel-definition {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 24px;
    padding: 28px 32px;
    background: var(--color-bg-warm);
    border-left: 4px solid var(--color-terracotta);
    border-radius: 0 12px 12px 0;
  }

  .tc-content-inner p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .tc-content-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 800;
    color: var(--color-text);
    margin: 48px 0 16px;
  }

  .tc-content-inner ul {
    margin: 0 0 24px;
    padding-left: 20px;
  }

  .tc-content-inner li {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .tc-content-inner a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .tc-content-inner a:hover {
    color: var(--color-terracotta-light);
  }

  .stat-callout {
    margin: 32px 0;
    padding: 20px 28px;
    background: rgba(197, 106, 75, 0.08);
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
    border: 1px solid rgba(197, 106, 75, 0.2);
  }

  .tc-faq {
    margin-top: 24px;
  }

  .tc-faq-item {
    border-bottom: 1px solid rgba(58, 52, 46, 0.1);
    padding: 16px 0;
  }

  .tc-faq-item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tc-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .tc-faq-item summary::before {
    content: '+';
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-terracotta);
    flex-shrink: 0;
    width: 24px;
    text-align: center;
    transition: transform 0.2s;
  }

  .tc-faq-item[open] summary::before {
    content: '\2212';
  }

  .tc-faq-item summary h3 {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .tc-faq-item p {
    padding-left: 36px;
    font-size: 15px !important;
    color: var(--color-text-muted) !important;
  }

  .tc-cta {
    padding: 80px 24px;
    text-align: center;
    background: var(--color-bg-warm);
  }

  .tc-cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .tc-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .tc-cta p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .tc-cta-btn {
    display: inline-block;
    padding: 16px 36px;
    background: var(--color-terracotta);
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    transition: background 0.3s, transform 0.2s;
  }

  .tc-cta-btn:hover {
    background: var(--color-terracotta-light);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .tc-hero {
      padding: 100px 20px 48px;
    }

    .budget-travel-definition {
      padding: 20px 20px;
      font-size: 17px;
    }

    .tc-content {
      padding: 40px 20px 48px;
    }
  }
</style>
