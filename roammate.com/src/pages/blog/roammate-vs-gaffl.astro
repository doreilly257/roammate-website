---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAllBlogPosts } from '../../lib/blog-data';
import { getAllGuides } from '../../data/guides';
import { resolveRelatedContent } from '../../lib/blog-utils';

const allBlogPosts = await getAllBlogPosts();
const post = allBlogPosts.find((p) => p.slug === 'roammate-vs-gaffl');
if (!post) throw new Error('Blog post not found: roammate-vs-gaffl');

const allGuides = await getAllGuides();
const { relatedGuides, relatedPosts } = resolveRelatedContent(post, allBlogPosts, allGuides);

// Search Console shows these exact question shapes already rank around
// position 6 and convert at 3.5-6% -- far above the site average -- with no
// page on the site actually answering them. Every answer below restates what
// this page's researched comparison already establishes -- nothing new is
// claimed about GAFFL. The answers deliberately stay on the approach
// difference, which this page sources, and avoid user numbers or safety
// claims, which it does not.
const faqs = [
  {
    q: 'Is GAFFL legit?',
    a: 'Yes. GAFFL is a real, established travel app built for the same problem roammate addresses: helping solo travellers find someone to travel with. It works on a trip-posting model: you describe a trip and other travellers apply to join it. The two apps differ in approach rather than legitimacy.',
  },
  {
    q: 'How is roammate different from GAFFL?',
    a: 'GAFFL starts from the trip: you post where you are going and review the people who apply. roammate starts from the person: it matches travellers on travel style, budget and destination, so you are introduced to people whose trip already fits yours rather than filtering applicants yourself.',
  },
  {
    q: 'Which one should I use?',
    a: 'It depends on how fixed your plans are. If you already know your dates and route and want people to join that specific trip, a trip-posting model like GAFFL fits naturally. If your plans are still forming and you would rather find compatible people first and shape the trip together, matching fits better. They are not mutually exclusive, and plenty of travellers use both.',
  },
];

---

<BlogPostLayout
  title={post.title}
  description={post.description}
  heroImage={post.heroImage}
  category={post.category}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  author={post.author}
  readingTime={post.readingTime}
  intro={post.intro}
  sections={post.sections}
  relatedGuides={relatedGuides as any}
  relatedPosts={relatedPosts}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    })} />
  </Fragment>

  <div slot="extra" class="blog-comparison-table reveal">
    <h2>Side-by-Side Comparison</h2>
    <div class="comparison-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th>roammate</th>
            <th>GAFFL</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Primary purpose</td>
            <td>Compatibility matching</td>
            <td>Trip posting &amp; applications</td>
          </tr>
          <tr>
            <td>Matching logic</td>
            <td>Style, budget, destination</td>
            <td>Manual (read posts, apply)</td>
          </tr>
          <tr>
            <td>Profile verification</td>
            <td>Yes (all users)</td>
            <td>Yes</td>
          </tr>
          <tr>
            <td>Compatibility filter</td>
            <td>Before conversations</td>
            <td>Through post description</td>
          </tr>
          <tr>
            <td>Best for</td>
            <td>Early-stage planning, style-matched trips</td>
            <td>Fixed itinerary, selective screening</td>
          </tr>
          <tr>
            <td>Price</td>
            <td>Free, no ads, no premium tier</td>
            <td>Free tier + optional premium</td>
          </tr>
          <tr>
            <td>Platform</td>
            <td>iOS, Android</td>
            <td>iOS, Android</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 id="faq">Common questions about GAFFL</h2>
    <div class="vs-faq">
      {faqs.map((f) => (
        <details class="vs-faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

  </div>
</BlogPostLayout>

<style>
  .vs-faq { display: grid; gap: 10px; margin: 20px 0 8px; }
  .vs-faq-item { border: 1px solid var(--color-border); border-radius: 12px; padding: 14px 18px; }
  .vs-faq-item summary { font-weight: 600; cursor: pointer; list-style: none; }
  .vs-faq-item summary::-webkit-details-marker { display: none; }
  .vs-faq-item summary::after { content: '+'; float: right; color: var(--color-ink-muted); }
  .vs-faq-item[open] summary::after { content: '\2212'; }
  .vs-faq-item p { margin: 10px 0 0; color: var(--color-ink-muted); }
</style>
