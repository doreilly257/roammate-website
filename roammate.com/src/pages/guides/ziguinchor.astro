const culturalTips = [
  { icon: '🙏', title: 'Respect Local Customs', text: 'The Casamance has both Muslim and animist communities — dress modestly and ask before entering sacred forests or ceremonial spaces. Remove shoes when entering homes. Greetings are essential — never skip the hello.' },
