---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAllBlogPosts } from '../../lib/blog-data';
import { getAllGuides } from '../../data/guides';
import { resolveRelatedContent } from '../../lib/blog-utils';

const allBlogPosts = await getAllBlogPosts();
const post = allBlogPosts.find((p) => p.slug === 'roammate-vs-hostelworld');
if (!post) throw new Error('Blog post not found: roammate-vs-hostelworld');

const allGuides = await getAllGuides();
const { relatedGuides, relatedPosts } = resolveRelatedContent(post, allBlogPosts, allGuides);
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  heroImage={post.heroImage}
  category={post.category}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  author={post.author}
  readingTime={post.readingTime}
  intro={post.intro}
  sections={post.sections}
  relatedGuides={relatedGuides as any}
  relatedPosts={relatedPosts}
>
  <div slot="extra" class="blog-comparison-table reveal">
    <h2>Side-by-Side Comparison</h2>
    <div class="comparison-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th>roammate</th>
            <th>Hostelworld</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Primary purpose</td>
            <td>Companion matching</td>
            <td>Hostel booking platform</td>
          </tr>
          <tr>
            <td>Matching logic</td>
            <td>Style, budget, destination</td>
            <td>None (same-property guests only)</td>
          </tr>
          <tr>
            <td>Travel-specific</td>
            <td>Yes, trip-level matching</td>
            <td>Booking-scoped social tab</td>
          </tr>
          <tr>
            <td>Verified profiles</td>
            <td>Yes (all users)</td>
            <td>No</td>
          </tr>
          <tr>
            <td>Price</td>
            <td>Free, no ads</td>
            <td>Free to browse; booking fees apply</td>
          </tr>
          <tr>
            <td>Best for</td>
            <td>Finding a compatible travel companion</td>
            <td>Booking hostels and accommodation</td>
          </tr>
          <tr>
            <td>Platform</td>
            <td>iOS, Android</td>
            <td>iOS, Android</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</BlogPostLayout>
