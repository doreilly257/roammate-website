        },
        {
          time: 'Evening',
          icon: '🌙',
          title: 'Mountain Sunset',
          text: 'End the day watching the alpenglow light up the peaks. The evening light at Annapurna Circuit is spectacular and worth waiting for. Find a local restaurant for dinner — aromatic local curries and fresh bread.',
          tip: 'Sunset times vary by season — check ahead and position yourself 30 minutes early for the best spot.',
        },
      ],
    },
