---
const base = import.meta.env.BASE_URL;
const images = ['01.jpg', '02.jpg', '03.jpg', '04.jpg', '05.jpg', '06.jpg'];
---

<section class="gallery">
  <div class="gallery-track">
    {images.map((img) => (
      <img src={`${base}images/carousel/${img}`} alt="Travel moment">
    ))}
    {/* Duplicate for seamless loop */}
    {images.map((img) => (
      <img src={`${base}images/carousel/${img}`} alt="Travel moment">
    ))}
  </div>
</section>

<style>
  .gallery {
    overflow: hidden;
    position: relative;
  }

  .gallery::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.08), transparent);
    z-index: 1;
  }

  .gallery-track {
    display: flex;
    gap: 16px;
    animation: marquee 40s linear infinite;
    width: max-content;
  }

  .gallery-track img {
    height: 400px;
    width: auto;
    object-fit: cover;
    filter: saturate(0.8);
    transition: filter 0.5s;
    border-radius: 4px;
  }

  .gallery-track img:hover {
    filter: saturate(1.2);
  }

  @media (max-width: 640px) {
    .gallery-track img { height: 260px; }
  }
</style>
