---
const base = import.meta.env.BASE_URL;

const travelers = [
  {
    name: 'Ashley, 25',
    origin: 'USA',
    image: 'traveler-ashley-kuala-lumpur.webp',
    alt: 'Woman in a floral dress on a rooftop with the Petronas Towers lit up behind her',
    quote: "I heard there's a helipad bar with an incredible view of KL. Anyone down for drinks tonight?",
  },
  {
    name: 'Lela, 29',
    origin: 'Singapore',
    image: 'traveler-lela-brooklyn-bridge.webp',
    alt: 'Woman with a pink scarf smiling on the Brooklyn Bridge walkway',
    quote: 'Traveling NYC with a friend. Looking for more people to share sightseeing and cab rides tomorrow!',
  },
  {
    name: 'Alex, 25',
    origin: 'United Kingdom',
    image: 'traveler-alex-vietnam-motorbike.webp',
    alt: 'Man riding a motorbike along a muddy trail through the Vietnamese highlands',
    quote: 'Rented a motorbike, seeing Vietnam north to south. Looking for company and laughs on the way.',
  },
  {
    name: 'John, 31',
    origin: 'South Africa',
    image: 'traveler-john-blyde-canyon.webp',
    alt: 'Man sitting on a cliff edge overlooking Blyde River Canyon and its turquoise reservoir',
    quote: "Heading to Blyde River Canyon this weekend. We rented a car but there's room for one more!",
  },
];
---

<section class="community" id="community">
  <div class="community-header">
    <div>
      <div class="section-label reveal">Meet the Roamers</div>
      <h2 class="section-heading reveal reveal-delay-1">Inspiring travelers, <em>real stories</em></h2>
    </div>
    <p class="reveal reveal-delay-2">Join a global community of adventurers who believe the best part of any journey is the people you meet along the way.</p>
  </div>
  <div class="travelers">
    {travelers.map((t, i) => (
      <div class={`traveler-card reveal reveal-delay-${i + 1}`}>
        <img src={`${base}images/${t.image}`} alt={t.alt} loading="lazy">
        <div class="traveler-overlay">
          <div class="traveler-name">{t.name}</div>
          <div class="traveler-origin">{t.origin}</div>
          <div class="traveler-quote">&ldquo;{t.quote}&rdquo;</div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .community {
    padding: 160px 40px;
    position: relative;
  }

  .community-header {
    max-width: 1200px;
    margin: 0 auto 80px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .community-header p {
    max-width: 320px;
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.8;
    font-weight: 300;
    text-align: right;
  }

  .travelers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .traveler-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    cursor: pointer;
    border-radius: 8px;
  }

  .traveler-card picture {
    width: 100%;
    height: 100%;
  }

  .traveler-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .traveler-card:hover img {
    transform: scale(1.08);
  }

  .traveler-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 15, 15, 0.92) 0%,
      rgba(15, 15, 15, 0.25) 50%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    transition: background 0.5s;
  }

  .traveler-card:hover .traveler-overlay {
    background: linear-gradient(
      to top,
      rgba(15, 15, 15, 0.95) 0%,
      rgba(15, 15, 15, 0.55) 60%,
      rgba(15, 15, 15, 0.25) 100%
    );
  }

  .traveler-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: #f5f0e8;
    margin-bottom: 4px;
  }

  .traveler-origin {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-terracotta-light);
    font-weight: 500;
    margin-bottom: 16px;
  }

  .traveler-quote {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(245, 240, 232, 0.7);
    font-style: italic;
    font-weight: 300;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.6s var(--ease-out-expo), opacity 0.4s;
  }

  .traveler-card:hover .traveler-quote {
    max-height: 200px;
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .community { padding: 100px 24px; }
    .community-header { flex-direction: column; align-items: flex-start; gap: 24px; }
    .community-header p { text-align: left; }
    .travelers { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .travelers { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
  }
</style>
