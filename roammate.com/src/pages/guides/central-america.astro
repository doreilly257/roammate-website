---
import BackpackerRouteLayout from '../../layouts/BackpackerRouteLayout.astro';

const routeOverview = [
  { country: 'Mexico & Guatemala', flag: '🇲🇽🇬🇹', weeks: '1–4', color: '#c4562a', stops: ['Mexico City', 'Oaxaca', 'San Cristóbal', 'Antigua', 'Lake Atitlán', 'Semuc Champey'] },
  { country: 'Honduras & Nicaragua', flag: '🇭🇳🇳🇮', weeks: '5–8', color: '#c9a84c', stops: ['Copán', 'Utila', 'León', 'Granada', 'Ometepe'] },
  { country: 'Costa Rica & Panama', flag: '🇨🇷🇵🇦', weeks: '9–12', color: '#2e6d79', stops: ['La Fortuna', 'Monteverde', 'Santa Teresa', 'Bocas del Toro', 'Panama City'] },
];

const countries = [
  {
    name: 'Mexico & Guatemala',
    flag: '🇲🇽',
    weeks: 'Weeks 1–4',
    color: '#c4562a',
    intro: 'The Gringo Trail starts where ancient civilisations meet modern chaos. Mexico City is one of the world\'s great cities, Oaxacan food will ruin you for tacos forever, and Guatemala delivers jaw-dropping landscapes at rock-bottom prices. This stretch sets the tone for the whole trip.',
    quickFacts: [
      { icon: '💰', label: 'Daily Budget', value: '$25–50', detail: 'Mexico slightly higher' },
      { icon: '💵', label: 'Currency', value: 'MXN / GTQ', detail: '1 USD ≈ 17 MXN / 7.8 GTQ' },
      { icon: '🛂', label: 'Visa', value: '180 days (MX)', detail: 'Guatemala: 90 days CA-4' },
      { icon: '🗣', label: 'Language', value: 'Spanish', detail: 'English rare outside tourism' },
      { icon: '🕐', label: 'Timezone', value: 'CST (UTC-6)', detail: 'Guatemala same' },
      { icon: '☀️', label: 'Best Months', value: 'Nov – Apr', detail: 'Dry season' },
    ],
    phases: [
      {
        title: 'Mexico City',
        duration: '4–5 days',
        description: 'One of the world\'s most underrated megacities. The Zócalo and Templo Mayor (MX$85) sit atop Aztec ruins. UNAM campus and Coyoacán (Frida Kahlo\'s house, MX$270) deserve a full day. Street tacos al pastor from a busy taquería: MX$15–25 each — eat where the queue is longest. Chapultepec Park is massive and free. The Anthropology Museum (MX$90) is world-class. Roma and Condesa neighbourhoods have the best café and bar scene. Metro rides: MX$5 (about $0.30).',
        tip: 'Download the CDMX Metro app. Uber is reliable and cheap — often cheaper than negotiating with taxi drivers, and safer at night.',
        guides: ['mexico-city'],
      },
      {
        title: 'Oaxaca & Chiapas',
        duration: '8–10 days',
        description: 'Bus from CDMX to Oaxaca (ADO, MX$600–800, 6 hrs). Oaxaca is Mexico\'s food capital — take a cooking class ($40–60), visit the mezcal distilleries in Matatlán (tastings free), and explore Monte Albán ruins (MX$90). Try tlayudas (Oaxacan pizza, MX$60–80) and chapulines (fried grasshoppers). Night bus to San Cristóbal de las Casas (MX$500–700, 10 hrs). San Cristóbal is a highland colonial town with indigenous Tzotzil culture. Day trip to Sumidero Canyon boat ride (MX$300) and the turquoise waterfalls of El Chiflón (MX$50).',
        tip: 'In Oaxaca, eat at the Mercado 20 de Noviembre — the smoky meats section (pasillo de humo) is legendary. Budget MX$100 for a feast.',
        guides: ['oaxaca', 'san-cristobal', 'cenote-diving'],
      },
      {
        title: 'Guatemala Highlights',
        duration: '10–12 days',
        description: 'Shuttle from San Cristóbal to Antigua (Q200–300, 8 hrs including border). Antigua is a gorgeous colonial town ringed by volcanoes — hike Volcán Acatenango (Q250–400 overnight trip) for sunrise views of Fuego erupting. Spanish school immersion: $150–200/week including homestay. Bus to Lake Atitlán (Q25, 3 hrs) — the "most beautiful lake in the world" surrounded by Mayan villages. Base in San Pedro (party) or San Marcos (yoga). Then overland to Semuc Champey (Q100 shuttle + Q50 entry) — turquoise natural pools in the jungle, one of Guatemala\'s top experiences.',
        tip: 'Guatemala runs on chicken buses (old US school buses, painted wild). They\'re cheap (Q5–15) and an experience, but shuttles are faster and safer for long distances.',
        guides: ['antigua-guatemala', 'lake-atitlan', 'semuc-champey', 'tikal', 'caye-caulker'],
      },
    ],
  },
  {
    name: 'Honduras & Nicaragua',
    flag: '🇭🇳',
    weeks: 'Weeks 5–8',
    color: '#c9a84c',
    intro: 'The middle stretch of the Gringo Trail is where things get raw. Honduras has world-class diving at a fraction of Caribbean prices, and Nicaragua is Central America\'s cheapest country — colonial cities, volcanoes you can board down, and a lake with an island with two volcanoes on it. Budget paradise.',
    quickFacts: [
      { icon: '💰', label: 'Daily Budget', value: '$20–40', detail: 'Very budget-friendly' },
      { icon: '💵', label: 'Currency', value: 'HNL / NIO', detail: '1 USD ≈ 25 HNL / 37 NIO' },
      { icon: '🛂', label: 'Visa', value: '90 days CA-4', detail: 'Shared with Guatemala/El Salvador' },
      { icon: '🗣', label: 'Language', value: 'Spanish', detail: 'Bay Islands have English' },
      { icon: '🕐', label: 'Timezone', value: 'CST (UTC-6)', detail: 'Same as Guatemala' },
      { icon: '☀️', label: 'Best Months', value: 'Nov – Apr', detail: 'Dry season, best diving' },
    ],
    phases: [
      {
        title: 'Copán & Utila',
        duration: '10–12 days',
        description: 'Bus from Guatemala to Copán Ruinas (Q80 shuttle, 4–5 hrs). The Mayan ruins of Copán (L300/$12) are smaller than Tikal but the carved stelae and hieroglyphic stairway are extraordinary. Macaw Research Centre on-site is free. Bus to San Pedro Sula (L200, 3 hrs), then fly or ferry to Utila (ferry L800/$32, 1 hr from La Ceiba). Utila is the cheapest place in the world for PADI Open Water certification ($280–320 for the full course). Stay for advanced diving or just snorkel Whale Shark season (March–April, Sept–October). Dorm beds: $8–12.',
        tip: 'On Utila, most dive shops include accommodation in the course price — ask before booking separately. Stay near the dock for the best food scene.',
        guides: ['copan', 'utila', 'roatan'],
      },
      {
        title: 'León & Granada',
        duration: '5–7 days',
        description: 'Ferry back to La Ceiba, bus to the Nicaraguan border at Las Manos (L300, 6 hrs). León is Nicaragua\'s revolutionary university city — climb the white-roofed cathedral ($2) for views, visit the revolutionary murals, and volcano board down Cerro Negro ($30 — an active volcano at 50km/h on a wooden board). Bus to Granada (C$50, 2 hrs) — the oldest colonial city in the Americas. Explore the colourful streets, kayak the Isletas (360 islands in Lake Nicaragua, C$200–400), and eat vigorón (pork, yuca, and cabbage salad, C$50) in the central park.',
        tip: 'Volcano boarding is best with Bigfoot Hostel in León — they pioneered it and have the best safety record. Wear closed-toe shoes and long sleeves.',
        guides: ['leon-nicaragua', 'granada-nicaragua', 'volcano-boarding'],
      },
      {
        title: 'Ometepe Island',
        duration: '4–5 days',
        description: 'Ferry from Granada or San Jorge to Ometepe (C$50–100, 1–2 hrs). This figure-eight island is formed by two volcanoes rising from Lake Nicaragua — it feels like Jurassic Park. Hike Volcán Concepción (8–10 hrs, guide required, $30–40) or the easier Volcán Maderas with its crater lake (6–8 hrs, $25). Rent a scooter ($15–20/day) to explore waterfalls, petroglyphs, and Ojo de Agua natural spring pool (C$100). Stay in bamboo eco-lodges on the Maderas side ($8–15/night). Fresh fish from the lake for $3–4.',
        tip: 'Concepción is a serious hike — start before 6am, bring 3+ litres of water, and go with a guide. The views from the summit are worth every step.',
        guides: ['ometepe'],
      },
    ],
  },
  {
    name: 'Costa Rica & Panama',
    flag: '🇨🇷',
    weeks: 'Weeks 9–12',
    color: '#2e6d79',
    intro: 'The final stretch brings more comfort and better infrastructure — at a price. Costa Rica is the most expensive country on the route, but the biodiversity is mind-blowing (5% of the world\'s species on 0.03% of its land). Panama bookends the trip with Caribbean islands and a city that feels like Miami.',
    quickFacts: [
      { icon: '💰', label: 'Daily Budget', value: '$35–65', detail: 'Costa Rica is pricier' },
      { icon: '💵', label: 'Currency', value: 'CRC / USD', detail: '1 USD ≈ 530 CRC; Panama uses USD' },
      { icon: '🛂', label: 'Visa', value: '90 days each', detail: 'Separate from CA-4' },
      { icon: '🗣', label: 'Language', value: 'Spanish', detail: 'English in tourist areas' },
      { icon: '🕐', label: 'Timezone', value: 'CST (UTC-6)', detail: 'Panama is UTC-5' },
      { icon: '☀️', label: 'Best Months', value: 'Dec – Apr', detail: 'Dry season (verano)' },
    ],
    phases: [
      {
        title: 'La Fortuna & Monteverde',
        duration: '5–6 days',
        description: 'Bus from the Nicaraguan border (Peñas Blancas) to La Fortuna (₡5,000, 5 hrs via San José or direct shuttle $30–45). Arenal Volcano dominates the skyline. Hike the national park trails (₡9,000/$17), soak in hot springs (free: Tabacón river spot; paid: Baldi $42), and try the hanging bridges walk ($26). Jeep-boat-jeep transfer to Monteverde ($25–30, 3 hrs). The cloud forest reserves (Santa Elena ₡9,400 or Monteverde ₡13,300) are where you\'ll see quetzals, sloths, and more birds than you can count. Night walk tours ($25) are incredible.',
        tip: 'The free hot springs near Tabacón resort are well-known locally — walk past the resort entrance along the river. Best at night under the stars.',
        guides: ['la-fortuna', 'monteverde'],
      },
      {
        title: 'Pacific Coast & Santa Teresa',
        duration: '5–7 days',
        description: 'Bus from Monteverde to the coast (shuttle $35–45 to Santa Teresa via Paquera ferry). Santa Teresa/Mal País is the surf town backpackers lose themselves in — consistent waves, yoga everywhere, and sunsets over the Pacific. Surf lessons: $40–50 for 2 hrs. Rent a board and ride Playa Hermosa. Montezuma Waterfall (free, 20-min hike) is a jungle gem — you can jump off the top tier (12m). ATV to Cabo Blanco Reserve ($12 entry) for deserted white-sand beaches. Food is pricier here — cook at your hostel or eat casados (set meals, ₡3,500–5,000/$7–10) at local sodas.',
        tip: 'Santa Teresa runs on dirt roads and spread-out distances — rent an ATV ($50/day) or bicycle. Surfboards can be rented for $10–15/day.',
        guides: ['santa-teresa'],
      },
      {
        title: 'Bocas del Toro & Panama City',
        duration: '6–8 days',
        description: 'Bus from San José to Sixaola border, then water taxi to Bocas del Toro ($3–6 total overland, 8–10 hrs; or fly San José to Bocas $80–120). Bocas is the Caribbean party hub — island-hop between Isla Bastimentos (Red Frog Beach), Starfish Beach (Isla Colón), and Zapatilla Cays ($25–30 day trip). Snorkelling: $25–30 with a boat tour covering 4–5 spots. Dorm beds: $10–15. Fly or bus to Panama City ($15–40, 10 hrs by bus). The Casco Viejo old town is walkable and beautiful, the Panama Canal (Miraflores Locks, $20) is surreal, and the Causeway has sunset views of the skyline.',
        tip: 'Bocas Town (Isla Colón) is the base — stay on the main island and day-trip to others. Tuesday is Filthy Friday\'s... wait, no — Mondays are Aqua Lounge parties on a hostel built over the sea.',
        guides: ['bocas-del-toro', 'panama-city'],
      },
    ],
  },
];

const budgetColumns = [
  { flag: '🇲🇽', label: 'Mexico/Guatemala' },
  { flag: '🇭🇳', label: 'Honduras/Nicaragua' },
  { flag: '🇨🇷', label: 'Costa Rica/Panama' },
];

const budgetRows = [
  { category: 'Accommodation', values: ['$8–20', '$6–15', '$10–25'], notes: 'Hostels, guesthouses, homestays' },
  { category: 'Food', values: ['$5–12', '$3–8', '$7–18'], notes: 'Street food, comedores, sodas' },
  { category: 'Transport', values: ['$3–10', '$2–8', '$5–12'], notes: 'Chicken buses, shuttles, ferries' },
  { category: 'Activities', values: ['$5–15', '$5–15', '$10–25'], notes: 'Ruins, volcanoes, diving' },
  { category: 'Drinks/Social', values: ['$3–8', '$2–5', '$4–10'], notes: 'Beer, rum, nightlife' },
  { category: 'Daily Total', values: ['$25–50', '$20–40', '$35–65'], notes: 'Budget–comfortable range' },
];

const practicalInfo = [
  {
    icon: '🛂',
    title: 'Visas',
    items: [
      'Mexico: 180-day tourist visa on arrival (free). FMM form at airport',
      'CA-4 Agreement: Guatemala, Honduras, El Salvador, Nicaragua share a 90-day visa — time runs across all four',
      'Costa Rica & Panama: Separate 90-day stamps. Costa Rica may ask for proof of onward travel',
    ],
  },
  {
    icon: '💉',
    title: 'Health',
    items: [
      'Recommended: Hep A/B, Typhoid, Tetanus. Yellow Fever certificate if arriving from South America',
      'Dengue and Zika risk in lowland areas — use DEET repellent, especially near the coast',
      'Drink bottled water (or filtered) everywhere. Avoid raw produce from street stalls in remote areas',
    ],
  },
  {
    icon: '🚌',
    title: 'Transport',
    items: [
      'ADO buses in Mexico are comfortable and reliable. Book online for discounts',
      'Chicken buses in Guatemala/Honduras are cheap and chaotic — hold your bag on your lap',
      'Tourist shuttles ($10–40) connect backpacker hotspots — worth it for safety and time on long routes',
    ],
  },
  {
    icon: '📱',
    title: 'Connectivity',
    items: [
      'Buy a Telcel SIM in Mexico ($5–10 for 30 days). Tigo works in Guatemala, Honduras, and Nicaragua',
      'Costa Rica: Kolbi prepaid SIM ($5 for 4GB). Panama: Claro or Movistar ($5–8)',
      'WiFi is solid in hostels. Cell data can be patchy in rural Guatemala and Ometepe',
    ],
  },
  {
    icon: '🌦️',
    title: 'Best Time',
    items: [
      'November–April: Dry season (verano) across the region — ideal for travel',
      'May–October: Rainy season (invierno) — afternoon downpours, lush scenery, cheaper prices',
      'Hurricane season: June–November on the Caribbean coast. Pacific coast is less affected',
    ],
  },
  {
    icon: '⚠️',
    title: 'Safety',
    items: [
      'Stick to tourist routes and use registered transport. Avoid travel at night between cities',
      'Honduras (outside Utila/Roatán) requires extra caution — don\'t flash valuables, use ATMs in malls',
      'Solo travellers: join hostel groups for border crossings and remote areas. The trail is well-trodden',
    ],
  },
];
---

<BackpackerRouteLayout
  title="Central America Backpacker Route — 3-Month Itinerary | roammate"
  description="The ultimate 3-month Central America backpacker route. Week-by-week Gringo Trail itinerary through Mexico, Guatemala, Honduras, Nicaragua, Costa Rica, and Panama."
  heroImages={[
    { src: '/images/guides/cam-ruins.webp', alt: 'Ancient Mayan pyramid surrounded by jungle' },
    { src: '/images/guides/cam-volcano.webp', alt: 'Volcano erupting against orange sunset sky' },
    { src: '/images/guides/cam-tacos.webp', alt: 'Colourful Mexican street tacos with fresh toppings' },
    { src: '/images/guides/cam-beach.webp', alt: 'Turquoise Caribbean water on a white sand beach' },
  ]}
  heroFlags="🇲🇽 🇬🇹 🇨🇷"
  heroRegion="Central America"
  heroTitle="The<br>Gringo Trail"
  heroSubtitle="Six countries, twelve weeks, one legendary route. From Mexico City's taco stands to Panama's Caribbean islands — the trail that defines backpacking in the Americas."
  heroPills={['3-Month Route', '$20–65/day', 'Nov – Apr Best', '6 Countries']}
  routeOverview={routeOverview}
  countries={countries}
  budgetIntro="Daily costs per person in USD. Total 3-month budget: approximately $2,500–4,500 depending on your style. Nicaragua and Honduras are dirt cheap, Costa Rica bumps the average up."
  budgetColumns={budgetColumns}
  budgetRows={budgetRows}
  practicalInfo={practicalInfo}
  ctaRegion="Central America"
  ctaText="Find travel companions for volcano hikes, split dive courses on Utila, and share chicken bus adventures with fellow backpackers on roammate."
  ctaCustomise="To customise this route to your travel style, pace, and budget — download the roammate app to tailor it to your preferences."
  featuredGuides={['mexico-city', 'cancun', 'chichen-itza', 'riviera-maya-cenotes', 'monteverde', 'oaxaca', 'san-cristobal', 'antigua-guatemala', 'lake-atitlan', 'semuc-champey', 'copan', 'utila', 'roatan', 'leon-nicaragua', 'granada-nicaragua', 'ometepe', 'la-fortuna', 'santa-teresa', 'bocas-del-toro', 'panama-city', 'tikal', 'volcano-boarding', 'cenote-diving', 'caye-caulker']}
  accentColor="#c4562a"
/>
