---
const base = import.meta.env.BASE_URL;
---

<section class="cta-section" id="waitlist">
  <div class="cta-bg">
    <img
      src={`${base}images/thumbnail-bottom.webp`}
      srcset={`${base}images/thumbnail-bottom-600w.webp 600w, ${base}images/thumbnail-bottom.webp 700w`}
      sizes="100vw"
      alt="Travelers gathered at a scenic overlook ready for their next adventure"
      loading="lazy"
      width="700"
      height="471"
    >
  </div>
  <div class="cta-inner reveal">
    <h2 class="cta-heading">Start <em>Exploring</em></h2>
    <p class="cta-body">roammate is live. Download the app and start connecting with fellow travelers wherever you are.</p>
    <div class="cta-badges">
      <a href="https://apps.apple.com/app/id6758834253" class="cta-badge-link" aria-label="Download on App Store" target="_blank" rel="noopener" data-ph-event="cta_appstore_click" data-ph-label="CTA">
        <img src={`${base}images/app-store-badge.png`} alt="Download on App Store" class="cta-badge" width="564" height="189">
      </a>
      <a href="/#waitlist" class="cta-badge-link" aria-label="Get it on Google Play">
        <img src={`${base}images/google-play-badge.png`} alt="Get it on Google Play" class="cta-badge" width="564" height="168">
      </a>
    </div>
  </div>
</section>


<style>
  .cta-section {
    position: relative;
    padding: 160px 40px;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6);
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 15, 15, 0.92) 0%,
      rgba(26, 21, 16, 0.88) 50%,
      rgba(15, 15, 15, 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 900;
    line-height: 1.1;
    color: #f5f0e8;
    margin-bottom: 24px;
  }

  .cta-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .cta-body {
    font-size: 17px;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.75);
    font-weight: 300;
    margin-bottom: 40px;
  }

  .cta-badges {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .cta-badge-link {
    display: block;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.3s;
  }

  .cta-badge-link:hover {
    transform: translateY(-3px);
    opacity: 0.85;
  }

  .cta-badge {
    height: 56px;
    width: auto;
    display: block;
  }

  @media (max-width: 1024px) {
    .cta-section { padding: 120px 24px; }
  }

  @media (max-width: 640px) {
    .cta-badges { flex-direction: column; align-items: center; }
    .cta-badge { height: 48px; }
  }
</style>
