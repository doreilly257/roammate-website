---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Press & Media — roammate Travel Companion App"
  description="Press kit, app screenshots, founder bio, and media contact for roammate — the travel companion app that connects solo travelers by style, budget, and destination."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Press & Media — roammate",
      "url": "https://roammate.com/press/",
      "description": "Press kit and media resources for roammate travel companion app.",
    })} />
  </Fragment>

  <section class="press-hero">
    <div class="press-hero-inner">
      <div class="section-label section-label--center">Media</div>
      <h1 class="press-title">Press <em>&amp; Media</em></h1>
      <p class="press-subtitle">Everything you need to write about roammate. Questions? <a href="mailto:press@roammate.com">press@roammate.com</a></p>
    </div>
  </section>

  <section class="press-content">
    <div class="press-inner">

      <!-- About -->
      <div class="press-block reveal">
        <h2 class="press-block-heading">About roammate</h2>
        <p>roammate is a free travel companion app for iOS that connects solo travelers and small groups with like-minded people nearby. Unlike generic social apps, roammate matches users by travel style, budget range, and destination overlap — so every connection is genuinely compatible.</p>
        <p>Travelers use roammate to split accommodation costs, find hiking partners, share guided tours, and turn solo trips into shared adventures. The app is free to download with no ads and no subscriptions.</p>
        <p>roammate launched on iOS in 2017. An Android version is in development.</p>
      </div>

      <!-- Key Facts -->
      <div class="press-block reveal">
        <h2 class="press-block-heading">Key Facts</h2>
        <div class="press-facts-grid">
          <div class="press-fact">
            <span class="press-fact-value">Free</span>
            <span class="press-fact-label">No ads. No subscriptions.</span>
          </div>
          <div class="press-fact">
            <span class="press-fact-value">iOS</span>
            <span class="press-fact-label">Available on the App Store</span>
          </div>
          <div class="press-fact">
            <span class="press-fact-value">4.8★</span>
            <span class="press-fact-label">App Store rating</span>
          </div>
          <div class="press-fact">
            <span class="press-fact-value">Global</span>
            <span class="press-fact-label">Works in every country</span>
          </div>
        </div>
      </div>

      <!-- App description (boilerplate) -->
      <div class="press-block reveal">
        <h2 class="press-block-heading">Boilerplate</h2>
        <div class="press-boilerplate">
          <p><strong>Short (50 words):</strong> roammate is a free iOS app that matches solo travelers with compatible companions by travel style, budget, and destination — not just location. Users connect to split costs, share experiences, and explore more safely. Available on the App Store. Android coming soon.</p>
          <p><strong>One sentence:</strong> roammate connects solo travelers with compatible companions to share costs, experiences, and adventures — free on iOS.</p>
        </div>
      </div>

      <!-- Download links -->
      <div class="press-block reveal">
        <h2 class="press-block-heading">Download</h2>
        <div class="press-download-links">
          <a
            href="https://apps.apple.com/app/id6758834253?pt=118224460&ct=press-page&mt=8"
            target="_blank"
            rel="noopener"
            class="press-store-link"
            data-ph-event="press_appstore_click"
          >
            <img src={`${base}images/app-store-badge.png`} alt="Download on the App Store" width="135" height="45" loading="lazy">
          </a>
        </div>
        <p class="press-store-note">App ID: 6758834253 · Bundle: com.roammate.app</p>
      </div>

      <!-- Assets -->
      <div class="press-block reveal">
        <h2 class="press-block-heading">Logos &amp; Assets</h2>
        <div class="press-assets-grid">
          <div class="press-asset-card">
            <div class="press-asset-preview press-asset-preview--light">
              <img src={`${base}images/rm-full.svg`} alt="roammate logo" width="160" height="40" loading="lazy">
            </div>
            <p>Full logo — light bg</p>
          </div>
          <div class="press-asset-card">
            <div class="press-asset-preview press-asset-preview--dark">
              <img src={`${base}images/rm-full.svg`} alt="roammate logo" width="160" height="40" loading="lazy">
            </div>
            <p>Full logo — dark bg</p>
          </div>
        </div>
        <p class="press-assets-note">Need additional formats or screenshots? Email <a href="mailto:press@roammate.com">press@roammate.com</a></p>
      </div>

      <!-- Contact -->
      <div class="press-block reveal">
        <h2 class="press-block-heading">Media Contact</h2>
        <p>For press enquiries, interview requests, and partnership opportunities:</p>
        <a href="mailto:press@roammate.com" class="press-email-link">press@roammate.com</a>
        <p class="press-response-note">We respond within one business day.</p>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .press-hero {
    padding: 160px 40px 80px;
    text-align: center;
  }

  .press-hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .section-label--center {
    justify-content: center;
  }

  .section-label--center::before {
    display: none;
  }

  .press-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 80px);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-cream);
    margin-bottom: 20px;
  }

  .press-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .press-subtitle {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-cream-muted);
  }

  .press-subtitle a {
    color: var(--color-terracotta-light);
  }

  .press-content {
    padding: 0 40px 120px;
  }

  .press-inner {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    gap: 64px;
  }

  .press-block-heading {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-cream);
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(196, 86, 42, 0.15);
  }

  .press-block p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--color-cream-muted);
    margin-bottom: 14px;
  }

  .press-facts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .press-fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 20px;
    background: var(--color-bg-warm);
    border-radius: 14px;
    border: 1px solid rgba(196, 86, 42, 0.1);
  }

  .press-fact-value {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 900;
    color: var(--color-cream);
  }

  .press-fact-label {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .press-boilerplate p {
    padding: 20px;
    background: var(--color-bg-warm);
    border-radius: 12px;
    border: 1px solid rgba(196, 86, 42, 0.1);
    margin-bottom: 12px;
  }

  .press-download-links {
    display: flex;
    gap: 16px;
    margin-bottom: 12px;
  }

  .press-store-link {
    transition: transform 0.25s var(--ease-out-expo);
  }

  .press-store-link:hover {
    transform: translateY(-2px);
  }

  .press-store-note {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .press-assets-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 16px;
  }

  .press-asset-card {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(196, 86, 42, 0.12);
  }

  .press-asset-card p {
    margin: 0;
    padding: 10px 14px;
    font-size: 13px;
    color: var(--color-text-muted);
    background: var(--color-bg-warm);
  }

  .press-asset-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    min-height: 100px;
  }

  .press-asset-preview--light {
    background: #f5f1eb;
  }

  .press-asset-preview--dark {
    background: #1a1714;
  }

  .press-assets-note {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .press-assets-note a {
    color: var(--color-terracotta-light);
  }

  .press-email-link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-terracotta-light);
    margin: 12px 0 16px;
    transition: opacity 0.2s;
  }

  .press-email-link:hover {
    opacity: 0.75;
  }

  .press-response-note {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .press-hero { padding: 140px 24px 60px; }
    .press-content { padding: 0 24px 80px; }
    .press-facts-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .press-hero { padding: 120px 20px 48px; }
    .press-content { padding: 0 20px 60px; }
    .press-facts-grid { grid-template-columns: repeat(2, 1fr); }
    .press-assets-grid { grid-template-columns: 1fr; }
  }
</style>
