    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(196, 86, 42, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .bta-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
  }

  .bta-title {
    font-family: var(--font-display);
    font-size: clamp(42px, 6.6vw, 76px);
    font-weight: 900;
