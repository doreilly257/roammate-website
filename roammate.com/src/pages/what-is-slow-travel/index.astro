    margin-bottom: 24px;
    padding: 28px 32px;
    background: var(--color-bg-warm);
    border-left: 4px solid var(--color-terracotta);
    border-radius: 0 12px 12px 0;
  }

  .tc-content-inner p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .tc-content-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 800;
    color: var(--color-text);
    margin: 48px 0 16px;
  }

  .tc-content-inner ul {
    margin: 0 0 24px;
    padding-left: 20px;
  }

  .tc-content-inner li {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .tc-content-inner a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .tc-content-inner a:hover {
    color: var(--color-terracotta-light);
  }

  .stat-callout {
    margin: 32px 0;
    padding: 20px 28px;
    background: rgba(197, 106, 75, 0.08);
    border-radius: 12px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text);
    border: 1px solid rgba(197, 106, 75, 0.2);
  }

  .tc-faq {
    margin-top: 24px;
  }

  .tc-faq-item {
    border-bottom: 1px solid rgba(58, 52, 46, 0.1);
    padding: 16px 0;
  }

  .tc-faq-item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tc-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .tc-faq-item summary::before {
    content: '+';
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-terracotta);
    flex-shrink: 0;
    width: 24px;
    text-align: center;
    transition: transform 0.2s;
  }

  .tc-faq-item[open] summary::before {
    content: '\2212';
  }

  .tc-faq-item summary h3 {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .tc-faq-item p {
