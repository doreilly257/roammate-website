---
import AppCTA from '../components/AppCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Is roammate Safe? Safety Features & Guidelines"
  description="roammate uses verified profiles, identity checks, and in-app safety controls to help solo travellers connect safely. Here's exactly how it works."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": "Is roammate Safe?",
          "url": "https://roammate.com/safety/",
          "description": "roammate safety features: emergency SOS with nominated contacts, check-in timers, optional identity verification, in-app reporting, and safe meeting guidelines for solo travellers.",
          "speakable": {
            "@type": "SpeakableSpecification",
            "cssSelector": [".safety-title", ".safety-subtitle", ".faq-section"]
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
            { "@type": "ListItem", "position": 2, "name": "Safety", "item": "https://roammate.com/safety/" }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How does roammate verify profiles?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Travellers can verify their identity with a government-ID and liveness check. Verified accounts display a badge so you know who you're looking at before any conversation starts."
              }
            },
            {
              "@type": "Question",
              "name": "What happens when I use Emergency SOS?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Raising an SOS alert sends your location to the emergency contacts you have nominated in the app. Alerts are delivered by email, so a contact needs an email address on file to be reachable. After sending, the app reports which contacts it actually reached and which it could not, rather than assuming everyone received it."
              }
            },
            {
              "@type": "Question",
              "name": "How do check-in timers work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Set a check-in timer before you head out and the app counts down to it. You can check in when you are fine, extend it if plans run long, or stop it entirely. Joining an excursion can arm one automatically."
              }
            },
            {
              "@type": "Question",
              "name": "What should I do if I feel unsafe before or during a meetup?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Trust your instincts. If something feels off, it's completely fine to cancel or leave, and you don't owe anyone an explanation. You can block and report the user directly from their profile in two taps, contact local authorities if you feel in danger, and reach out to support@roammate.com so the team can review the account."
              }
            },
            {
              "@type": "Question",
              "name": "How do I report a user, and what happens next?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can report or block any user directly from their profile in two taps. Every report is reviewed by the roammate team, and accounts that violate community guidelines are removed. Blocking is immediate and the other person isn't notified, so you stay in control of who can contact you."
              }
            },
            {
              "@type": "Question",
              "name": "What are the safest ways to meet a travel companion in person?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Meet in a public place for your first encounter (a hostel common room, a café, or a walking tour), and avoid meeting at accommodation on a first meet. Tell a friend, family member, or hostel staff who you're meeting and where, share a rough itinerary for any day trip, and keep early communication in-app until you've met and built trust."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <section class="safety-hero">
    <div class="safety-hero-inner">
      <div class="section-label section-label--center">Safety</div>
      <h1 class="safety-title">Is roammate <em>safe?</em></h1>
      <p class="safety-subtitle">Short answer: yes, with the same common sense you apply to any new connection while travelling. Here's exactly what roammate does to keep it that way.</p>
    </div>
  </section>

  <section class="safety-features">
    <div class="safety-features-inner">
      <div class="section-label">How It Works</div>
      <h2 class="safety-section-heading">Built-in safety <em>at every step</em></h2>
      <div class="safety-cards">
        <div class="safety-card reveal">
          <div class="safety-card-num">01</div>
          <h3>Verified profiles</h3>
          <p>Travellers can verify their identity with a government-ID and liveness check. Verified accounts display a badge. You know who you're looking at before any conversation starts.</p>
        </div>
        <div class="safety-card reveal">
          <div class="safety-card-num">02</div>
          <h3>Chat before you commit</h3>
          <p>All communication happens inside the app before any in-person meetup. You can get a clear sense of the person (their travel plans, communication style, and vibe) before agreeing to anything.</p>
        </div>
        <div class="safety-card reveal">
          <div class="safety-card-num">03</div>
          <h3>Report and block</h3>
          <p>Any user can be reported or blocked directly from their profile. Reports are reviewed by the roammate team. Accounts that violate community guidelines are removed.</p>
        </div>
        <div class="safety-card reveal">
          <div class="safety-card-num">04</div>
          <h3>Compatible matching reduces risk</h3>
          <p>By matching on travel style and budget before surfacing profiles, roammate reduces mismatched expectations, one of the most common sources of tension when travelling with someone new.</p>
        </div>
        <div class="safety-card reveal">
          <div class="safety-card-num">05</div>
          <h3>Emergency SOS and contacts</h3>
          <p>Nominate emergency contacts in the app, then raise an SOS alert that sends them your location. Alerts go out by email, so add an email address for anyone you want reachable. After sending, the app tells you exactly who it reached and who it could not, rather than assuming everyone got it.</p>
        </div>
        <div class="safety-card reveal">
          <div class="safety-card-num">06</div>
          <h3>Check-in countdown</h3>
          <p>Set a check-in timer before you head out and the app counts down to it. Check in when you are fine, extend it if plans run long, or stop it entirely. Join an excursion and it can arm itself, so the timer is running before you think to set one.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="safety-guidelines">
    <div class="safety-guidelines-inner">
      <div class="section-label">Best Practices</div>
      <h2 class="safety-section-heading">Safe meeting <em>guidelines</em></h2>
      <div class="safety-guideline-list">
        <div class="safety-guideline reveal">
          <span class="safety-guideline-icon">📍</span>
          <div>
            <h3>Meet in public first</h3>
            <p>For your first in-person meeting, choose a public location: a hostel common room, a café, or a walking tour. Avoid meeting at accommodation on a first encounter.</p>
          </div>
        </div>
        <div class="safety-guideline reveal">
          <span class="safety-guideline-icon">📱</span>
          <div>
            <h3>Tell someone your plans</h3>
            <p>Let a friend, family member, or hostel staff know who you're meeting and where. Share a rough itinerary if you're planning a day trip or multi-day journey together.</p>
          </div>
        </div>
        <div class="safety-guideline reveal">
          <span class="safety-guideline-icon">🧠</span>
          <div>
            <h3>Trust your instincts</h3>
            <p>If something feels off before or during a meetup, it's completely fine to cancel or leave. You don't owe anyone an explanation. Prioritise your comfort and safety.</p>
          </div>
        </div>
        <div class="safety-guideline reveal">
          <span class="safety-guideline-icon">💬</span>
          <div>
            <h3>Keep early communication in-app</h3>
            <p>Until you've met and established trust, keep conversations inside roammate. Moving to personal numbers or social media too quickly can make it harder to report issues if they arise.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section safety-faq">
    <div class="safety-faq-inner">
      <div class="section-label">Common Questions</div>
      <h2 class="safety-section-heading">Safety <em>FAQ</em></h2>
      <div class="safety-faq-list">
        <details class="safety-faq-item reveal">
          <summary class="safety-faq-q">How does roammate verify profiles?</summary>
          <div class="safety-faq-a">Travellers can verify their identity with a government-ID and liveness check. Verified accounts display a badge so you know who you're looking at before any conversation starts.</div>
        </details>
        <details class="safety-faq-item reveal">
          <summary class="safety-faq-q">What should I do if I feel unsafe before or during a meetup?</summary>
          <div class="safety-faq-a">Trust your instincts. If something feels off, it's completely fine to cancel or leave, and you don't owe anyone an explanation. You can block and report the user directly from their profile in two taps, contact local authorities if you feel in danger, and reach out to support@roammate.com so the team can review the account.</div>
        </details>
        <details class="safety-faq-item reveal">
          <summary class="safety-faq-q">How do I report a user, and what happens next?</summary>
          <div class="safety-faq-a">You can report or block any user directly from their profile in two taps. Every report is reviewed by the roammate team, and accounts that violate community guidelines are removed. Blocking is immediate and the other person isn't notified, so you stay in control of who can contact you.</div>
        </details>
        <details class="safety-faq-item reveal">
          <summary class="safety-faq-q">What are the safest ways to meet a travel companion in person?</summary>
          <div class="safety-faq-a">Meet in a public place for your first encounter (a hostel common room, a cafe, or a walking tour), and avoid meeting at accommodation on a first meet. Tell a friend, family member, or hostel staff who you're meeting and where, share a rough itinerary for any day trip, and keep early communication in-app until you've met and built trust.</div>
        </details>
      </div>
    </div>
  </section>

  <section class="safety-cta">
    <div class="safety-cta-inner">
      <h2 class="safety-cta-heading">Ready to find a <em>compatible</em> travel companion?</h2>
      <p class="safety-cta-body">Download roammate free on iOS and Android. Verified profiles, compatible matching, and full safety controls built in.</p>
      <AppCTA
        variant="badges"
        appStoreCt="safety-page-cta"
        appStoreEvent="safety_cta_appstore_click"
        playStoreEvent="safety_cta_playstore_click"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .safety-hero {
    padding: 160px 40px 80px;
    text-align: center;
    position: relative;
  }

  .safety-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(196, 86, 42, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .safety-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }

  .safety-title {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 900;
    line-height: 1.02;
    color: var(--color-ink);
    margin-bottom: 24px;
  }

  .safety-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .safety-subtitle {
    font-size: clamp(17px, 2vw, 20px);
    color: rgba(245, 241, 235, 0.75);
    line-height: 1.65;
  }

  .safety-section-heading {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: 40px;
  }

  .safety-section-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .safety-features {
    padding: 60px 40px 80px;
  }

  .safety-features-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .safety-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .safety-card {
    padding: 32px 28px;
    background: rgba(247, 242, 234, 0.04);
    border: 1px solid rgba(196, 86, 42, 0.15);
    border-radius: 20px;
  }

  .safety-card-num {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 900;
    color: var(--color-terracotta);
    opacity: 0.4;
    line-height: 1;
    margin-bottom: 14px;
  }

  .safety-card h3 {
    font-family: var(--font-display);
    font-size: 21px;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .safety-card p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .safety-guidelines {
    padding: 60px 40px 80px;
    background: rgba(247, 242, 234, 0.02);
    border-top: 1px solid rgba(196, 86, 42, 0.08);
    border-bottom: 1px solid rgba(196, 86, 42, 0.08);
  }

  .safety-guidelines-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .safety-guideline-list {
    display: grid;
    gap: 24px;
  }

  .safety-guideline {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    align-items: start;
  }

  .safety-guideline-icon {
    font-size: 28px;
    line-height: 1;
    margin-top: 2px;
  }

  .safety-guideline h3 {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-ink);
    margin-bottom: 6px;
  }

  .safety-guideline p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .safety-faq {
    padding: 60px 40px 80px;
  }

  .safety-faq-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .safety-faq-list {
    display: grid;
    gap: 0;
  }

  .safety-faq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .safety-faq-q {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
    padding: 24px 40px 24px 0;
    list-style: none;
    position: relative;
    transition: color 0.3s;
  }

  .safety-faq-q::-webkit-details-marker { display: none; }

  .safety-faq-q::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 300;
    color: var(--color-terracotta);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .safety-faq-item[open] .safety-faq-q::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .safety-faq-q:hover { color: var(--color-terracotta); }

  .safety-faq-a {
    font-size: 15px;
    line-height: 1.9;
    color: var(--color-ink-muted);
    font-weight: 300;
    padding: 0 40px 24px 0;
  }

  .safety-cta {
    padding: 60px 40px 100px;
    text-align: center;
  }

  .safety-cta-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .safety-cta-heading {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .safety-cta-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .safety-cta-body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(245, 241, 235, 0.65);
    margin-bottom: 32px;
  }

  .safety-cta-btn {
    display: inline-block;
    padding: 16px 36px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    background: var(--color-terracotta);
    color: #fff;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s var(--ease-out-expo);
  }

  .safety-cta-btn:hover {
    background: #b34f28;
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .safety-hero { padding: 140px 24px 60px; }
    .safety-features, .safety-guidelines, .safety-faq, .safety-cta { padding-left: 24px; padding-right: 24px; }
  }

  @media (max-width: 640px) {
    .safety-hero { padding: 120px 20px 60px; }
    .safety-features, .safety-guidelines, .safety-faq, .safety-cta { padding-left: 20px; padding-right: 20px; }
    .safety-cards { grid-template-columns: 1fr; }
    .safety-guideline { grid-template-columns: 36px 1fr; gap: 14px; }
  }
</style>
