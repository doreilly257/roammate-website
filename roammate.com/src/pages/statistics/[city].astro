---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCTA from '../../components/AppCTA.astro';
import { getCitySiblingPages } from '../../lib/getCitySiblingPages';
import { getCityGuideSlugs } from '../../data/guides';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.type === 'city')
    .map((g) => {
      const d = g.data;
      return {
        params: { city: d.slug },
        props: {
          city: d.heroCity,
          country: d.heroCountry,
          region: d.heroRegion,
          slug: d.slug,
          quickFacts: d.quickFacts,
          budgetBreakdown: d.budgetBreakdown,
          practicalInfo: d.practicalInfo,
          culturalTips: d.culturalTips,
          guideData: d,
        },
      };
    });
}

const { city, country, region, slug, quickFacts, budgetBreakdown, practicalInfo, culturalTips, guideData } = Astro.props;
const cityGuideSlugs = await getCityGuideSlugs();
const siblings = getCitySiblingPages(slug, guideData, cityGuideSlugs);

const pageTitle = `${city} Solo Travel Statistics & Facts | roammate`;
const pageDesc = `Solo travel statistics for ${city}, ${country}. Quick facts, daily budget breakdown, practical info, cultural tips, and travel companion resources.`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const hasMidrange = budgetBreakdown?.some((r: any) => r.midrange || r.mid);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
    { "@type": "ListItem", "position": 2, "name": "Statistics", "item": "https://roammate.com/statistics/" },
    { "@type": "ListItem", "position": 3, "name": `${city} Statistics`, "item": pageUrl }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDesc,
  "url": pageUrl,
  "publisher": {
    "@type": "Organization",
    "name": "roammate",
    "url": "https://roammate.com/"
  }
};
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  </Fragment>

  <section class="stats-hero">
    <div class="stats-hero-inner">
      <nav class="stats-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/statistics/">Statistics</a>
        <span>/</span>
        <span aria-current="page">{city}</span>
      </nav>
      <h1 class="stats-hero-title">{city} solo travel statistics</h1>
      <p class="stats-hero-subtitle">Quick facts, budget breakdown, practical info, and cultural tips for solo travelers visiting {city}, {country}.</p>
    </div>
  </section>

  <article class="stats-content">
    <div class="stats-content-inner">

      <h2>Quick facts</h2>

      <div class="stats-grid">
        {quickFacts.map((fact: any) => (
          <div class="stat-card">
            <span class="stat-number">{fact.value}</span>
            <span class="stat-label">{fact.label}{fact.detail ? ` — ${fact.detail}` : ''}</span>
          </div>
        ))}
      </div>

      {budgetBreakdown && budgetBreakdown.length > 0 && (
        <>
          <h2>Budget breakdown</h2>
          <div class="stats-table-wrap">
            <table class="stats-table">
              <thead>
                <tr>
                  <th>Category</th>
                  <th>Budget</th>
                  {hasMidrange && <th>Midrange</th>}
                </tr>
              </thead>
              <tbody>
                {budgetBreakdown.map((row: any) => (
                  <tr>
                    <td>{row.category}</td>
                    <td>{row.budget}</td>
                    {hasMidrange && <td>{row.midrange || row.mid || '—'}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="stats-table-note">Daily per-person estimates. Costs vary by season and travel style.</p>
        </>
      )}

      {practicalInfo && practicalInfo.length > 0 && (
        <>
          <h2>Practical info</h2>
          <div class="city-info-grid">
            {practicalInfo.map((info: any) => (
              <div class="city-info-card">
                <h3><span class="city-info-icon">{info.icon}</span> {info.title}</h3>
                <ul>
                  {info.items.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </>
      )}

      {culturalTips && culturalTips.length > 0 && (
        <>
          <h2>Cultural tips</h2>
          <div class="city-info-grid">
            {culturalTips.map((tip: any) => (
              <div class="city-info-card">
                <h3><span class="city-info-icon">{tip.icon}</span> {tip.title}</h3>
                <p>{tip.text}</p>
              </div>
            ))}
          </div>
        </>
      )}

      <h2>Explore {city}</h2>
      <div class="city-links">
        {siblings.guide && <a href={siblings.guide} class="city-link-pill">City Guide</a>}
        {siblings.itinerary.map((it: any) => (
          <a href={it.slug} class="city-link-pill">{it.days}-Day Itinerary</a>
        ))}
        {siblings.budget && <a href={siblings.budget} class="city-link-pill">Budget Breakdown</a>}
        {siblings.bestTime && <a href={siblings.bestTime} class="city-link-pill">Best Time to Visit</a>}
        {siblings.companions && <a href={siblings.companions} class="city-link-pill">Find Companions</a>}
      </div>

    </div>
  </article>

  <section class="stats-cta reveal">
    <div class="stats-cta-inner">
      <h2>Find a travel companion for {city}</h2>
      <p>roammate matches solo travelers by travel style, budget, and destination. Free on iOS and Android — no ads, no subscription.</p>
      <AppCTA />
    </div>
  </section>
</BaseLayout>

<style>
  .stats-hero {
    background: linear-gradient(135deg, #1a1714 0%, #2a2420 100%);
    padding: 120px 24px 64px;
    text-align: center;
  }

  .stats-hero-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .stats-breadcrumb {
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.35);
    margin-bottom: 40px;
  }

  .stats-breadcrumb a {
    color: rgba(245, 240, 232, 0.55);
    transition: color 0.3s;
  }

  .stats-breadcrumb a:hover {
    color: var(--color-terracotta-light);
  }

  .stats-breadcrumb span {
    margin: 0 10px;
  }

  .stats-hero-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 900;
    line-height: 1.15;
    color: #f5f0e8;
    margin-bottom: 16px;
  }

  .stats-hero-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    color: rgba(245, 240, 232, 0.65);
    line-height: 1.6;
  }

  .stats-content {
    padding: 56px 24px 64px;
  }

  .stats-content-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .stats-content-inner p {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 20px;
  }

  .stats-content-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 800;
    color: var(--color-text);
    margin: 48px 0 16px;
  }

  .stats-content-inner h2:first-child {
    margin-top: 0;
  }

  .stats-content-inner a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .stats-content-inner a:hover {
    color: var(--color-terracotta-light);
  }

  /* Stat cards grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 24px 0;
  }

  .stat-card {
    background: var(--color-bg-warm);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 900;
    color: var(--color-terracotta);
    line-height: 1.2;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text);
  }

  /* Budget table */
  .stats-table-wrap {
    overflow-x: auto;
    margin: 24px 0 8px;
    border-radius: 12px;
    border: 1px solid rgba(58, 52, 46, 0.12);
  }

  .stats-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 15px;
  }

  .stats-table thead {
    background: var(--color-bg-warm);
  }

  .stats-table th {
    text-align: left;
    padding: 14px 16px;
    font-weight: 700;
    color: var(--color-text);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .stats-table td {
    padding: 12px 16px;
    color: var(--color-text);
    border-top: 1px solid rgba(58, 52, 46, 0.08);
  }

  .stats-table tbody tr:hover {
    background: rgba(58, 52, 46, 0.03);
  }

  .stats-table-note {
    font-size: 13px !important;
    color: var(--color-text-muted) !important;
    font-style: italic;
    margin-bottom: 24px !important;
  }

  /* Practical info & cultural tips grid */
  .city-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 24px 0;
  }

  .city-info-card {
    background: var(--color-bg-warm);
    border-radius: 12px;
    padding: 24px;
  }

  .city-info-card h3 {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 12px;
  }

  .city-info-icon {
    margin-right: 6px;
  }

  .city-info-card ul {
    margin: 0;
    padding-left: 18px;
  }

  .city-info-card li {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .city-info-card p {
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: var(--color-text) !important;
    margin: 0 !important;
  }

  /* Cross-links */
  .city-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0;
  }

  .city-link-pill {
    display: inline-block;
    padding: 10px 20px;
    background: var(--color-bg-warm);
    color: var(--color-terracotta) !important;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none !important;
    transition: background 0.2s, transform 0.2s;
  }

  .city-link-pill:hover {
    background: var(--color-terracotta);
    color: #fff !important;
    transform: translateY(-1px);
  }

  /* CTA */
  .stats-cta {
    padding: 80px 24px;
    text-align: center;
    background: var(--color-bg-warm);
  }

  .stats-cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .stats-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .stats-cta p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .city-info-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .stats-hero {
      padding: 100px 20px 48px;
    }

    .stats-content {
      padding: 40px 20px 48px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-number {
      font-size: 24px;
    }
  }
</style>
