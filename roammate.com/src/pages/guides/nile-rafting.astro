const culturalTips = [
  { icon: '🌊', title: 'Respect the River', text: 'The Nile is sacred in many cultures along its length. Ugandans have a deep connection to the river — it provides fish, water, transport, and hydroelectric power. Treat it with respect and do not litter.' },
  { icon: '🤝', title: 'Local Guides', text: 'The Ugandan rafting guides are among the best in the world — many have been running these rapids for over a decade. They are skilled, funny, and dedicated to your safety. Tip them well and respect their instructions absolutely.' },
  { icon: '🏘', title: 'River Communities', text: 'The Nile banks are home to fishing villages and farming communities. When passing through on the river, wave and smile but do not throw things to shore or shout. Respect their privacy and daily life.' },
  { icon: '🌍', title: 'Environmental Awareness', text: 'The Nile faces pressure from dam construction, pollution, and invasive water hyacinth. Support operators who practice Leave No Trace and contribute to river conservation efforts.' },
  { icon: '🎉', title: 'Backpacker Culture', text: 'Jinja has a strong international backpacker community. The lodges are social hubs where travellers from everywhere share stories and plan onward journeys. Be open, friendly, and generous with your time and advice.' },
  { icon: '🍺', title: 'Post-Rafting Tradition', text: 'The BBQ and beers after rafting are a tradition, not just a meal. Share the experience with your raft crew, swap stories from the day, and celebrate surviving the Nile together. Bonds formed on the river are genuine.' },
];
