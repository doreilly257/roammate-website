  { category: 'Food', budget: '$15–30', midrange: '$30–60', splurge: '$70+', notes: 'Street food → local restaurants → fine dining' },
  { category: 'Transport', budget: '$5–15', midrange: '$15–40', splurge: '$50+', notes: 'Public buses → shared transfers → private car' },
  { category: 'Activities', budget: '$5–20', midrange: '$20–60', splurge: '$80+', notes: 'Self-guided → group tours → private guides' },
