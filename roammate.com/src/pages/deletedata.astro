---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Delete Your Account — roammate"
  description="Request deletion of your roammate account and personal data. Submit a request via email and we will process it within 30 days."
>

  <section class="delete-hero">
    <div class="delete-hero-inner">
      <div class="section-label section-label--center">Account Management</div>
      <h1 class="delete-title">Delete Your <em>Account</em></h1>
      <p class="delete-subtitle">
        You have the right to request deletion of your roammate account and associated data at any time.
      </p>
    </div>
  </section>

  <section class="delete-content">
    <div class="delete-inner">

      <div class="delete-block">
        <h2>How to request deletion</h2>
        <ol class="delete-steps">
          <li>
            <span class="step-num">1</span>
            <div>
              <strong>Send an email to <a href="mailto:deletedata@roammate.com">deletedata@roammate.com</a></strong>
              <p>Use the email address associated with your roammate account.</p>
            </div>
          </li>
          <li>
            <span class="step-num">2</span>
            <div>
              <strong>Include your account details</strong>
              <p>Provide your registered email address and, if available, your roammate username or user ID.</p>
            </div>
          </li>
          <li>
            <span class="step-num">3</span>
            <div>
              <strong>We confirm and process your request</strong>
              <p>You will receive a confirmation email within 5 business days. Your account and data will be fully deleted within 30 days of confirmation.</p>
            </div>
          </li>
        </ol>

        <a href="mailto:deletedata@roammate.com?subject=Account%20Deletion%20Request&body=Please%20delete%20my%20roammate%20account.%0A%0ARegistered%20email%3A%20%5Byour%20email%5D%0AUsername%20(if%20known)%3A%20%5Byour%20username%5D" class="delete-btn">
          Request Account Deletion
        </a>
      </div>

      <div class="delete-block">
        <h2>What gets deleted</h2>
        <table class="delete-table">
          <thead>
            <tr>
              <th>Data type</th>
              <th>Action</th>
              <th>Retention</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Profile (name, photo, bio, preferences)</td>
              <td>Permanently deleted</td>
              <td>None</td>
            </tr>
            <tr>
              <td>Messages and conversations</td>
              <td>Permanently deleted</td>
              <td>None</td>
            </tr>
            <tr>
              <td>Travel plans you created</td>
              <td>Permanently deleted</td>
              <td>None</td>
            </tr>
            <tr>
              <td>Cost split records</td>
              <td>Deleted after dispute window</td>
              <td>30 days</td>
            </tr>
            <tr>
              <td>Reviews you received or left</td>
              <td>Anonymised and removed</td>
              <td>None</td>
            </tr>
            <tr>
              <td>Financial transaction records</td>
              <td>Retained for legal compliance</td>
              <td>7 years</td>
            </tr>
            <tr>
              <td>Aggregated, anonymised usage data</td>
              <td>May be retained</td>
              <td>Indefinite</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="delete-block delete-block--note">
        <p>
          If you have an active cost split or outstanding balance at the time of your request, we may ask you to resolve it before deletion is processed. For questions, contact <a href="mailto:deletedata@roammate.com">deletedata@roammate.com</a>.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .delete-hero {
    padding: 160px 40px 80px;
    text-align: center;
    position: relative;
  }

  .delete-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(196, 86, 42, 0.04) 0%, transparent 60%);
    pointer-events: none;
  }

  .delete-hero-inner {
    position: relative;
    z-index: 1;
  }

  .section-label--center {
    justify-content: center;
  }

  .section-label--center::before {
    display: none;
  }

  .delete-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 900;
    color: var(--color-cream);
    line-height: 1.0;
    margin: 24px 0 28px;
  }

  .delete-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta);
  }

  .delete-subtitle {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 300;
    color: var(--color-cream-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .delete-content {
    padding: 40px 40px 120px;
  }

  .delete-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .delete-block h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--color-cream);
    margin-bottom: 32px;
  }

  .delete-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 40px;
  }

  .delete-steps li {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .step-num {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-terracotta);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .delete-steps strong {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-cream);
    display: block;
    margin-bottom: 6px;
  }

  .delete-steps p {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: var(--color-cream-muted);
    line-height: 1.7;
    margin: 0;
  }

  .delete-steps a,
  .delete-block--note a {
    color: var(--color-terracotta);
    text-decoration: underline;
    transition: color 0.3s;
  }

  .delete-steps a:hover,
  .delete-block--note a:hover {
    color: var(--color-terracotta-light);
  }

  .delete-btn {
    display: inline-block;
    padding: 14px 32px;
    background: var(--color-terracotta);
    color: #fff;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s;
  }

  .delete-btn:hover {
    background: var(--color-terracotta-light);
    transform: translateY(-1px);
  }

  .delete-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .delete-table th {
    text-align: left;
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    border-bottom: 1px solid rgba(245, 240, 232, 0.1);
  }

  .delete-table td {
    padding: 14px 16px;
    color: var(--color-cream-muted);
    font-weight: 300;
    border-bottom: 1px solid rgba(245, 240, 232, 0.06);
    line-height: 1.5;
  }

  .delete-table tr:last-child td {
    border-bottom: none;
  }

  .delete-block--note {
    background: var(--color-bg-warm);
    border-radius: 8px;
    padding: 28px 32px;
  }

  .delete-block--note p {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: var(--color-cream-muted);
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 640px) {
    .delete-hero { padding: 140px 20px 60px; }
    .delete-content { padding: 40px 20px 80px; }
    .delete-table th:last-child,
    .delete-table td:last-child { display: none; }
  }
</style>
