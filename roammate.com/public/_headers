# Cloudflare Pages response headers.
# Pages defaults every asset to max-age=0, must-revalidate; the fingerprinted
# and content-addressed paths below are safe to cache immutably instead.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro fingerprints these filenames, so a change always changes the URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images and fonts are renamed on replacement (Cloudflare CDN cache-busting
# convention documented in CLAUDE.md), so they are safe to pin too.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Preview deployments must never compete with the production URLs in search.
# Two rules: the bare project domain, and per-branch preview subdomains.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
