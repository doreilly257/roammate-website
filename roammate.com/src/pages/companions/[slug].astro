---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getAllGuides } from '../../data/guides';
import { isSafetyTestCity } from '../../lib/safetyHoldout';

export async function getStaticPaths() {
  const allGuides = await getAllGuides();
  // The full collection entry carries the per-city detail this page needs.
  // Without it every page was the same template with the city name swapped in.
  const collection = await getCollection('guides');
  const cityEntries = collection.filter(
    (c): c is CollectionEntry<'guides'> & { data: Extract<CollectionEntry<'guides'>['data'], { type: 'city' }> } =>
      c.data.type === 'city'
  );
  const bySlug = new Map(cityEntries.map((c) => [c.data.slug, c.data]));
  // Built for every destination with a guide, not just the curated city list.
  // Search Console shows this is the highest-CTR page type on the site (9.4%,
  // ~6x site average), and 222 destinations had no page at all -- which is also
  // where the 222 /companions/ 404s came from.
  return allGuides
    .map((guide) => ({
      params: { slug: guide.slug },
      props: { guide, detail: bySlug.get(guide.slug) },
    }));
}

const { guide, detail } = Astro.props;

// Safety-messaging holdout (bead goc). See lib/safetyHoldout.ts before changing.
const inSafetyTest = isSafetyTestCity(guide.slug);

// Everything below is real per-city data from the guides collection. Nothing
// here is generated or estimated -- if a field is missing the block is skipped.
const fact = (label: string) => detail?.quickFacts?.find((f) => f.label === label);
const dailyBudget = fact('Daily Budget');
const bestMonths = fact('Best Months');
const language = fact('Language');
const currency = fact('Currency');
const subtitle = detail?.heroSubtitle;
const dayOne = detail?.itineraries?.['1']?.[0]?.periods ?? [];
const highlights = dayOne.slice(0, 3).map((p) => ({ time: p.time, icon: p.icon, title: p.title }));
type KnowBeforeItem = { icon: string; title: string; text?: string; items?: string[] };
// A cultural tip may be a bare string, which carries no icon or heading. This
// card is a titled teaser of at most two, so take only the titled shape rather
// than inventing an icon for a loose sentence.
const knowBefore: KnowBeforeItem[] = [
  ...(detail?.culturalTips ?? []),
  ...(detail?.practicalInfo ?? []),
]
  .flatMap((t) => (typeof t === 'string' ? [] : [t]))
  .slice(0, 2);
const { slug, name, country, flag, region, heroImage } = guide;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const title = `Find Travel Companions in ${name} — roammate`;
const description = `Looking for a travel companion in ${name}? Roammate matches you with like-minded travelers by style, budget, and itinerary. Free on iOS.`;
---

<BaseLayout {title} {description} ogImage={heroImage}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" href={heroImage}>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonical,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
          { "@type": "ListItem", "position": 2, "name": "Travel Companions", "item": "https://roammate.com/companions/" },
          { "@type": "ListItem", "position": 3, "name": name, "item": canonical },
        ],
      },
    })} />
  </Fragment>

  <section class="comp-hero" aria-label={`Travel companions in ${name}`}>
    <div class="comp-hero-bg" style={`background-image: linear-gradient(to top, rgba(15,15,15,0.94) 0%, rgba(15,15,15,0.4) 50%, rgba(15,15,15,0.25) 100%), url('${heroImage}');`}></div>
    <div class="comp-hero-content">
      <nav class="comp-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/companions/">Travel Companions</a>
        <span>/</span>
        <span>{name}</span>
      </nav>
      <div class="comp-hero-flag">{flag}</div>
      <h1>Find a Travel Companion<br>in <em>{name}</em></h1>
      <p class="comp-hero-sub">{subtitle ?? 'Matched by travel style, budget, and itinerary — not just location.'}</p>
      <div class="comp-hero-actions">
        <a
          href="https://apps.apple.com/app/id6758834253?pt=118224460&ct=companion-page-hero&mt=8"
          target="_blank"
          rel="noopener noreferrer"
          class="comp-btn comp-btn--primary"
          data-ph-event="companion_hero_appstore_click"
          data-ph-label={slug}
        >Download Free on iOS</a>
        <a href={`/guides/${slug}/`} class="comp-btn comp-btn--ghost">{name} Travel Guide</a>
      </div>
    </div>
  </section>

  <section class="comp-why">
    <div class="comp-why-inner">
      <div class="section-label">Why it matters</div>
      <h2 class="section-heading">Travel better in <em>{name}</em> with the right person</h2>
      <div class="comp-why-grid">
        <div class="comp-why-card reveal reveal-delay-1">
          <div class="comp-why-icon">💸</div>
          <h3>Split costs</h3>
          <p>{dailyBudget
            ? `A solo traveler in ${name} spends about ${dailyBudget.value} a day. Accommodation, transport, guided tours and day trips all cost less split two ways.`
            : `Accommodation, transport, guided tours and day trips all cost significantly less when shared in ${name}.`}</p>
        </div>
        <div class="comp-why-card reveal reveal-delay-2">
          <div class="comp-why-icon">🛡️</div>
          <h3>Stay safer</h3>
          <p>A travel companion means someone knows your plans, can help navigate emergencies, and makes you less of a target in unfamiliar areas of {name}.</p>
        </div>
        <div class="comp-why-card reveal reveal-delay-3">
          <div class="comp-why-icon">🔍</div>
          <h3>Go deeper</h3>
          <p>The best experiences in {name} — the off-menu restaurant, the dawn hike, the local's favourite spot — are found with a curious companion, not a guidebook.</p>
        </div>
        <div class="comp-why-card reveal reveal-delay-4">
          <div class="comp-why-icon">🎯</div>
          <h3>Matched by style</h3>
          <p>Roammate filters by travel pace, budget range, and interests — so you connect with someone genuinely compatible, not just whoever's in the same hostel dorm.</p>
        </div>
      </div>
    </div>
  </section>

  {inSafetyTest && (
    <section class="comp-trust">
      <div class="comp-trust-inner">
        <div class="section-label">Before you meet</div>
        <h2 class="section-heading">Meeting someone new in <em>{name}</em></h2>
        <p class="comp-trust-lede">Agreeing to travel with someone you met online is a real
          decision. Here is what sits between matching and meeting.</p>
        <div class="comp-trust-grid">
          <div class="comp-trust-card">
            <h3>Verified profiles only</h3>
            <p>Every profile is verified before it can match. You are not messaging an
              anonymous account.</p>
          </div>
          <div class="comp-trust-card">
            <h3>Chat before you commit</h3>
            <p>Message in the app and get a sense of someone first. Nothing obliges you to
              share contact details, or to meet at all.</p>
          </div>
          <div class="comp-trust-card">
            <h3>Report and block</h3>
            <p>If someone makes you uncomfortable, report or block them at any point — before
              or after you have arranged anything.</p>
          </div>
          <div class="comp-trust-card">
            <h3>Emergency SOS</h3>
            <p>Add emergency contacts before you travel. If something goes wrong in {name},
              raise an alert to them from inside the app.</p>
          </div>
        </div>
        <a class="comp-trust-link" href="/safety/">Read how we approach safety</a>
      </div>
    </section>
  )}

  <section class="comp-local">
    <div class="comp-local-inner">
      <div class="section-label">On the ground</div>
      <h2 class="section-heading">What a day in <em>{name}</em> looks like</h2>

      {highlights.length > 0 && (
        <ol class="comp-local-day">
          {highlights.map((h) => (
            <li class="comp-local-slot">
              <span class="comp-local-icon">{h.icon}</span>
              <span class="comp-local-time">{h.time}</span>
              <span class="comp-local-title">{h.title}</span>
            </li>
          ))}
        </ol>
      )}

      <div class="comp-local-facts">
        {bestMonths && <div class="comp-local-fact"><dt>Best months</dt><dd>{bestMonths.value}<span>{bestMonths.detail}</span></dd></div>}
        {dailyBudget && <div class="comp-local-fact"><dt>Daily budget</dt><dd>{dailyBudget.value}<span>{dailyBudget.detail}</span></dd></div>}
        {language && <div class="comp-local-fact"><dt>Language</dt><dd>{language.value}<span>{language.detail}</span></dd></div>}
        {currency && <div class="comp-local-fact"><dt>Currency</dt><dd>{currency.value}<span>{currency.detail}</span></dd></div>}
      </div>

      {knowBefore.length > 0 && (
        <div class="comp-local-know">
          <h3>Worth agreeing on before you meet</h3>
          {knowBefore.map((k) => (
            <div class="comp-local-know-item">
              <h4><span aria-hidden="true">{k.icon}</span> {k.title}</h4>
              <p>{k.text ?? k.items?.[0]}</p>
            </div>
          ))}
        </div>
      )}

      <p class="comp-local-more">Full detail — itineraries, budgets, neighbourhoods and safety — is in the <a href={`/guides/${slug}/`}>{name} travel guide</a>.</p>
    </div>
  </section>

  <section class="comp-how">
    <div class="comp-how-inner">
      <div class="section-label">How it works</div>
      <h2 class="section-heading">Finding your {name} companion</h2>
      <ol class="comp-how-steps">
        <li class="comp-how-step reveal reveal-delay-1">
          <span class="comp-step-num">01</span>
          <div>
            <h3>Create your profile</h3>
            <p>Set your travel style, daily budget, and the dates you'll be in {country}. Takes two minutes.</p>
          </div>
        </li>
        <li class="comp-how-step reveal reveal-delay-2">
          <span class="comp-step-num">02</span>
          <div>
            <h3>Browse compatible matches</h3>
            <p>Roammate surfaces travelers heading to {name} with compatible styles and budgets — not just everyone nearby.</p>
          </div>
        </li>
        <li class="comp-how-step reveal reveal-delay-3">
          <span class="comp-step-num">03</span>
          <div>
            <h3>Connect and coordinate</h3>
            <p>Message, agree on a plan, and meet in {name}. Start with a shared meal or half-day before committing to longer travel.</p>
          </div>
        </li>
      </ol>
      <div class="comp-how-cta">
        <a
          href="https://apps.apple.com/app/id6758834253?pt=118224460&ct=companion-page-how&mt=8"
          target="_blank"
          rel="noopener noreferrer"
          class="comp-btn comp-btn--primary"
          data-ph-event="companion_how_appstore_click"
          data-ph-label={slug}
        >Get started — Free on iOS</a>
        <a href="https://play.google.com/store/apps/details?id=com.roammate.app.android&referrer=utm_source%3Droammate.com%26utm_medium%3Dweb%26utm_campaign%3Dcompanion-page-hero" class="comp-btn comp-btn--ghost" target="_blank" rel="noopener noreferrer" data-ph-event="companion_playstore_click">Get it on Android</a>
      </div>
    </div>
  </section>

  <section class="comp-blog-links">
    <div class="comp-blog-links-inner">
      <p class="comp-blog-links-label">From the blog</p>
      <div class="comp-blog-links-grid">
        <a href="/blog/finding-travel-companions/" class="comp-blog-link" data-ph-event="companion_blog_click">
          <span>How to Find Reliable Travel Companions in New Cities</span>
          <span>→</span>
        </a>
        <a href="/blog/meeting-people-solo-travel/" class="comp-blog-link" data-ph-event="companion_blog_click">
          <span>Meeting People as a Solo Traveler</span>
          <span>→</span>
        </a>
        <a href="/blog/travel-friendship-building/" class="comp-blog-link" data-ph-event="companion_blog_click">
          <span>Building Lasting Travel Friendships</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="comp-guide-link">
    <div class="comp-guide-link-inner">
      <span class="comp-guide-flag">{flag}</span>
      <div>
        <p class="comp-guide-region">{region} · {country}</p>
        <h3>Planning your trip to {name}?</h3>
        <p>Read our full {name} travel guide — 1, 3, and 7-day itineraries with budget tips, neighbourhood breakdowns, and practical information.</p>
      </div>
      <a href={`/guides/${slug}/`} class="comp-btn comp-btn--outline">{name} Guide →</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .comp-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    padding: 0 40px 72px;
    overflow: hidden;
  }

  .comp-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .comp-hero-content {
    position: relative;
    z-index: 1;
    max-width: 820px;
    color: #f5f1eb;
  }

  .comp-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid rgba(245, 241, 235, 0.2);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    margin-bottom: 28px;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .comp-breadcrumb a { color: rgba(245, 241, 235, 0.7); }
  .comp-breadcrumb a:hover { color: #fff; }
  .comp-breadcrumb span { opacity: 0.5; }

  .comp-hero-flag {
    font-size: 48px;
    margin-bottom: 20px;
    line-height: 1;
  }

  .comp-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 8vw, 86px);
    line-height: 1.02;
    margin-bottom: 22px;
    letter-spacing: -0.02em;
  }

  .comp-hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .comp-hero-sub {
    font-size: clamp(17px, 2.2vw, 22px);
    color: rgba(245, 241, 235, 0.82);
    margin-bottom: 36px;
    line-height: 1.5;
  }

  .comp-hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* BUTTONS */
  .comp-btn {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s var(--ease-out-expo), border-color 0.3s;
  }

  .comp-btn--primary {
    background: var(--color-terracotta);
    color: #fff;
  }
  .comp-btn--primary:hover { background: #b34f28; transform: translateY(-2px); }

  .comp-btn--ghost {
    background: transparent;
    border: 1px solid rgba(245, 241, 235, 0.3);
    color: rgba(245, 241, 235, 0.85);
  }
  .comp-btn--ghost:hover { border-color: rgba(245, 241, 235, 0.6); color: #fff; transform: translateY(-2px); }

  .comp-btn--outline {
    background: transparent;
    border: 1px solid rgba(196, 86, 42, 0.4);
    color: var(--color-terracotta);
  }
  .comp-btn--outline:hover { border-color: var(--color-terracotta); background: rgba(196, 86, 42, 0.06); transform: translateY(-2px); }

  /* TRUST SECTION (safety holdout, bead goc) */
  .comp-trust {
    padding: 100px 40px;
    background: var(--color-bg-warm);
  }

  .comp-trust-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .comp-trust-lede {
    max-width: 640px;
    margin-top: 20px;
    color: var(--color-ink-muted);
    line-height: 1.7;
  }

  .comp-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .comp-trust-card {
    padding: 32px 28px;
    background: var(--color-bg);
    border-radius: 20px;
    border: 1px solid rgba(196, 86, 42, 0.1);
  }

  .comp-trust-card h3 { margin-bottom: 12px; }
  .comp-trust-card p { color: var(--color-ink-muted); line-height: 1.7; }

  .comp-trust-link {
    display: inline-block;
    margin-top: 32px;
    color: var(--color-terracotta);
    border-bottom: 1px solid rgba(196, 86, 42, 0.35);
  }
  .comp-trust-link:hover { border-bottom-color: var(--color-terracotta); }

  /* WHY SECTION */
  .comp-why {
    padding: 100px 40px;
  }

  .comp-why-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .comp-why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .comp-why-card {
    padding: 32px 28px;
    background: var(--color-bg-warm);
    border-radius: 20px;
    border: 1px solid rgba(196, 86, 42, 0.1);
  }

  .comp-why-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }

  .comp-why-card h3 {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .comp-why-card p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* HOW SECTION */
  .comp-how {
    padding: 100px 40px;
    background: var(--color-bg-warm);
  }

  .comp-how-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .comp-how-steps {
    list-style: none;
    padding: 0;
    margin: 48px 0 48px;
    display: grid;
    gap: 32px;
  }

  .comp-how-step {
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  .comp-step-num {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 900;
    line-height: 1;
    color: var(--color-terracotta);
    opacity: 0.35;
    flex-shrink: 0;
    min-width: 52px;
  }

  .comp-how-step h3 {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .comp-how-step p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .comp-how-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* GUIDE LINK */
  .comp-guide-link {
    padding: 64px 40px;
  }

  .comp-guide-link-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 40px 48px;
    border: 1px solid rgba(196, 86, 42, 0.18);
    border-radius: 20px;
    background: var(--color-bg);
  }

  .comp-guide-flag {
    font-size: 48px;
    flex-shrink: 0;
  }

  .comp-guide-link-inner > div {
    flex: 1;
  }

  .comp-guide-region {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: 8px;
  }

  .comp-guide-link-inner h3 {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .comp-guide-link-inner p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .comp-hero { padding: 160px 24px 56px; min-height: 80vh; }
    .comp-why { padding: 80px 24px; }
    .comp-why-grid { grid-template-columns: repeat(2, 1fr); }
    .comp-trust-grid { grid-template-columns: repeat(2, 1fr); }
    .comp-trust { padding: 80px 24px; }
    .comp-how { padding: 80px 24px; }
    .comp-guide-link { padding: 48px 24px; }
    .comp-guide-link-inner { padding: 32px; }
  }

  @media (max-width: 640px) {
    .comp-hero { padding: 160px 20px 40px; min-height: 75vh; }
    .comp-hero-actions { flex-direction: column; }
    .comp-why { padding: 60px 20px; }
    .comp-why-grid { grid-template-columns: 1fr; }
    .comp-trust-grid { grid-template-columns: 1fr; }
    .comp-trust { padding: 60px 20px; }
    .comp-how { padding: 60px 20px; }
    .comp-how-cta { flex-direction: column; }
    .comp-guide-link { padding: 32px 20px; }
    .comp-guide-link-inner { flex-direction: column; text-align: center; padding: 28px 20px; }
  }

  /* BLOG LINKS */
  .comp-blog-links {
    padding: 0 40px 48px;
  }

  .comp-blog-links-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .comp-blog-links-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .comp-blog-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .comp-blog-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    background: var(--color-bg-warm);
    border: 1px solid rgba(196, 86, 42, 0.1);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.25s, transform 0.25s var(--ease-out-expo);
  }

  .comp-blog-link:hover {
    border-color: rgba(196, 86, 42, 0.3);
    transform: translateY(-2px);
  }

  .comp-blog-link span:last-child {
    color: var(--color-terracotta);
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .comp-blog-links { padding: 0 24px 40px; }
    .comp-blog-links-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .comp-blog-links { padding: 0 20px 32px; }
  }

  .comp-local { padding: 96px 24px; background: var(--color-bg); }
  .comp-local-inner { max-width: 900px; margin: 0 auto; }
  .comp-local-day { list-style: none; padding: 0; margin: 32px 0; display: grid; gap: 12px; }
