  { icon: '🎒', label: 'Daily Budget', value: '~$25–55 USD', detail: 'Mid-range on the beach; budget limited' },
  { icon: '🛂', label: 'Visa', value: 'Visa-free 60 days', detail: 'Most Western passports; extendable 30 days' },
