---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getAllBlogPosts } from '../../lib/blog-data';
import { getAllGuides } from '../../data/guides';
import { resolveRelatedContent } from '../../lib/blog-utils';

const allBlogPosts = await getAllBlogPosts();
const post = allBlogPosts.find((p) => p.slug === 'roammate-vs-tourlina');
if (!post) throw new Error('Blog post not found: roammate-vs-tourlina');

const allGuides = await getAllGuides();
const { relatedGuides, relatedPosts } = resolveRelatedContent(post, allBlogPosts, allGuides);
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  heroImage={post.heroImage}
  category={post.category}
  publishedAt={post.publishedAt}
  updatedAt={post.updatedAt}
  author={post.author}
  readingTime={post.readingTime}
  intro={post.intro}
  sections={post.sections}
  relatedGuides={relatedGuides as any}
  relatedPosts={relatedPosts}
>
  <div slot="extra" class="blog-comparison-table reveal">
    <h2>Side-by-Side Comparison</h2>
    <div class="comparison-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th>roammate</th>
            <th>Tourlina</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Who can join</td>
            <td>All travelers</td>
            <td>Women only</td>
          </tr>
          <tr>
            <td>Matching logic</td>
            <td>Style, budget, destination</td>
            <td>Destination only</td>
          </tr>
          <tr>
            <td>Price</td>
            <td>Free</td>
            <td>Free tier + premium subscription</td>
          </tr>
          <tr>
            <td>Verified profiles</td>
            <td>Yes (all users)</td>
            <td>Optional</td>
          </tr>
          <tr>
            <td>Ads</td>
            <td>None</td>
            <td>Free tier has ads</td>
          </tr>
          <tr>
            <td>Best for</td>
            <td>Any traveler seeking compatible companions</td>
            <td>Women seeking female-only travel partners</td>
          </tr>
          <tr>
            <td>Platform</td>
            <td>iOS (Android coming)</td>
            <td>iOS, Android</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</BlogPostLayout>
