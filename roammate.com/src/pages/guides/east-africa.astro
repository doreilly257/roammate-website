  featuredGuides={['cairo', 'marrakech', 'maasai-mara', 'serengeti', 'zanzibar', 'mount-kilimanjaro', 'okavango-delta', 'pyramids-of-giza', 'victoria-falls']}
  accentColor="#c9a84c"
