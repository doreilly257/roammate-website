---
const base = import.meta.env.BASE_URL;
---

<section class="cta-section">
  <div class="cta-bg">
    <img src={`${base}images/thumbnail-bottom.jpg`} alt="Adventure awaits">
  </div>
  <div class="cta-inner reveal">
    <h2 class="cta-heading">Start <em>Exploring</em></h2>
    <p class="cta-body">Download roammate and join thousands of travelers who've discovered that the best adventures are shared ones.</p>
    <div class="cta-downloads">
      <a href="javascript:void(0);" class="badge-link"><img src={`${base}images/app-store-badge.svg`} alt="Download on the App Store" class="store-badge"></a>
      <a href="javascript:void(0);" class="badge-link"><img src={`${base}images/google-play-badge.png`} alt="Get it on Google Play" class="store-badge"></a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: 160px 40px;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6);
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 15, 15, 0.92) 0%,
      rgba(26, 21, 16, 0.88) 50%,
      rgba(15, 15, 15, 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 900;
    line-height: 1.1;
    color: #f5f0e8;
    margin-bottom: 24px;
  }

  .cta-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .cta-body {
    font-size: 17px;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.75);
    font-weight: 300;
    margin-bottom: 48px;
  }

  .cta-downloads {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
  }

  .badge-link {
    display: block;
    transition: transform 0.3s var(--ease-out-expo), opacity 0.3s;
  }

  .badge-link:hover {
    transform: translateY(-4px);
    opacity: 0.85;
  }

  .store-badge {
    height: 78px !important;
    width: auto;
    display: block;
  }

  @media (max-width: 1024px) {
    .cta-section { padding: 120px 24px; }
  }

  @media (max-width: 640px) {
    .cta-downloads { flex-direction: column; }
    .store-badge { height: 46px; }
  }
</style>
