{
  "name": "roammate-admin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "check": "astro check",
    "deploy": "astro build && wrangler pages deploy ./dist --project-name roammate-admin",
    "mock": "node dev/mock-api.mjs",
    "demo": "astro build && node dev/demo.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.0"
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0",
    "npm": ">=9.6.5"
  }
}
