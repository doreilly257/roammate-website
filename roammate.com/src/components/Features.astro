---
const features = [
  {
    icon: 'discover',
    title: 'Real-time Discovery',
    body: 'Find travelers near your location in real time. See who is exploring the same city and what plans they have.',
  },
  {
    icon: 'chat',
    title: 'In-app Messaging',
    body: 'Chat with potential travel companions before you meet. Coordinate plans, share tips, and break the ice.',
  },
  {
    icon: 'match',
    title: 'Compatible Matching',
    body: 'Match by travel style, budget range, and destination overlap — so every connection is genuinely compatible, not just geographically convenient.',
  },
  {
    icon: 'shield',
    title: 'Safety First',
    body: 'Verified profiles, user reviews, and a reporting system keep the community safe and trustworthy.',
  },
  {
    icon: 'calendar',
    title: 'Flexible Plans',
    body: 'Create, join, or modify travel plans anytime. Life changes, and your travel plans can adapt with you.',
  },
  {
    icon: 'globe',
    title: 'Global Community',
    body: 'Connect with travelers from over 50 countries. Every destination is an opportunity for a new friendship.',
  },
];
---

<section class="features" id="features">
  <div class="features-header reveal">
    <div class="section-label section-label--center">Features</div>
    <h2 class="section-heading">Everything you need to travel <em>together</em></h2>
  </div>
  <div class="features-grid">
    {features.map((f, i) => (
      <div class={`feature-card reveal reveal-delay-${(i % 4) + 1}`}>
        <div class="feature-icon">
          {f.icon === 'discover' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36z"/></svg>
          )}
          {f.icon === 'chat' && (
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          )}
          {f.icon === 'match' && (
            <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          )}
          {f.icon === 'shield' && (
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          )}
          {f.icon === 'calendar' && (
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          )}
          {f.icon === 'globe' && (
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          )}
        </div>
        <h3 class="feature-title">{f.title}</h3>
        <p class="feature-body">{f.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .features {
    padding: 160px 40px;
    position: relative;
  }

  .features::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.08), transparent);
  }

  .features-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 80px;
  }

  .section-label--center {
    justify-content: center;
  }

  .section-label--center::before {
    display: none;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .feature-card {
    padding: 40px 32px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    background: var(--color-bg);
    transition: all 0.5s var(--ease-out-expo);
  }

  .feature-card:hover {
    border-color: rgba(196, 86, 42, 0.15);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.06);
    transform: translateY(-4px);
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(196, 86, 42, 0.08);
    border-radius: 12px;
    margin-bottom: 24px;
  }

  .feature-icon svg {
    width: 24px;
    height: 24px;
    stroke: var(--color-terracotta);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .feature-body {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  @media (max-width: 1024px) {
    .features { padding: 100px 24px; }
    .features-grid { grid-template-columns: 1fr 1fr; gap: 24px; }
  }

  @media (max-width: 640px) {
    .features-grid { grid-template-columns: 1fr; max-width: 500px; }
  }
</style>
