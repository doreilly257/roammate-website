---
import CityGuideLayout from '../../layouts/CityGuideLayout.astro';

const quickFacts = [
  { icon: '💰', label: 'Currency', value: 'TZS (Shilling)', detail: '1 USD ≈ 2,500 TZS' },
  { icon: '🗣', label: 'Language', value: 'Swahili / English', detail: 'Guides speak English fluently' },
  { icon: '🕐', label: 'Timezone', value: 'EAT (UTC+3)', detail: 'No daylight saving' },
  { icon: '☀️', label: 'Best Months', value: 'Jun – Oct', detail: 'Dry season, migration in north' },
  { icon: '🎒', label: 'Daily Budget', value: '~$150–350 USD', detail: 'Group safari budget to mid-range' },
  { icon: '🛂', label: 'Visa', value: 'eVisa required', detail: '$50 USD, apply online before travel' },
];

const itineraries = {
  1: [
    {
      num: 1,
      title: 'Serengeti Day Safari — Dawn to Dusk',
      periods: [
        {
          time: 'Morning',
          icon: '🌅',
          title: 'Sunrise Game Drive from Seronera',
          text: 'Depart Seronera Valley at first light with your guide in an open-roof 4x4 Land Cruiser. The central Serengeti around Seronera is a year-round wildlife hotspot — the Seronera River attracts resident lion prides, leopards in sausage trees, and massive hippo pods. Drive the loop roads scanning the kopjes (rocky outcrops) where lions lounge in the early morning warmth.',
          tip: 'Seronera kopjes are legendary for leopard sightings — ask your guide to check the Simba Kopjes and Moru Kopjes areas.',
        },
        {
          time: 'Afternoon',
          icon: '☀️',
          title: 'Hippo Pool & Predator Plains',
          text: 'Visit the Retima Hippo Pool — a boardwalk viewpoint overlooking a river pool packed with 30-plus hippos grunting, yawning, and sparring. Continue driving the Seronera circuit through acacia woodland and open grasslands. The afternoon heat brings predators to shade — lions rest under trees, cheetahs perch on termite mounds scanning for prey, and vultures circle overhead.',
          tip: 'Carry a packed lunch from your camp — there are no restaurants in the Serengeti. Your safari operator will arrange this.',
        },
        {
          time: 'Evening',
          icon: '🌙',
          title: 'Sunset Over the Endless Plains',
          text: 'Time your final drive to catch sunset over the Serengeti plains — the name means "endless plains" in Maasai, and the horizon stretches infinitely in every direction. Watch herds of wildebeest and zebra silhouetted against the orange sky. Return to your camp or lodge for dinner under the stars. Many camps serve three-course meals in open-air dining areas.',
          tip: 'Ask your guide to find an elevated viewpoint for sunset — the Naabi Hill Gate area offers stunning panoramic views.',
        },
      ],
    },
  ],
  3: [
    {
      num: 1,
      title: 'Central Serengeti — Seronera Valley',
      periods: [
        {
          time: 'Morning',
          icon: '🌅',
          title: 'Arrival & First Game Drive',
          text: 'Fly into Seronera Airstrip from Arusha (1.5 hours) or drive from Ngorongoro (3–4 hours via Naabi Hill Gate). Your safari guide meets you for an immediate game drive through the Seronera Valley. This central area is the Serengeti\'s year-round wildlife hub — resident lion prides, leopards in riverside fig trees, and elephant herds moving between water sources.',
          tip: 'Charter flights from Arusha cost $250–400 one-way but save 8 hours of driving and include aerial views of the crater.',
        },
        {
          time: 'Afternoon',
          icon: '☀️',
          title: 'Seronera Hippo Pool & Kopjes',
          text: 'Drive to the Retima Hippo Pool boardwalk — dozens of hippos packed into a river bend, with crocodiles lurking on the banks. Continue to the Simba Kopjes, granite rock formations where lions shelter from the midday heat. These kopjes also host rock hyraxes, agama lizards, and klipspringer antelope. The boulders provide natural hides for photographing predators.',
          tip: 'Simba Kopjes means "Lion Rocks" in Swahili — they live up to the name. Circle each kopje slowly and scan the rock ledges.',
        },
        {
          time: 'Evening',
          icon: '🌙',
          title: 'Camp Dinner & Night Sounds',
          text: 'Check into your tented camp — options range from budget camping at Seronera Public Campsite ($30/person) to mid-range tented camps ($200–500/person all-inclusive). Dinner is typically a three-course affair served in a mess tent or open-air boma. After dinner, the bush comes alive — hyena whoops, lion roars, and the rustle of animals moving past your tent canvas.',
          tip: 'Budget option: Seronera Public Campsite is basic but thrilling — you hear lions roaring metres from your tent at night.',
        },
      ],
    },
    {
      num: 2,
      title: 'Western Corridor or Northern Serengeti',
      periods: [
        {
          time: 'Morning',
          icon: '🌅',
          title: 'Full-Day Drive to Migration Country',
          text: 'Depending on the season, drive towards the Western Corridor (May–July) or Northern Serengeti (August–October) to intercept the Great Migration. The journey itself is a game drive — the track passes through open grasslands where cheetahs hunt Thomson\'s gazelles and secretary birds strut through the grass. Your guide navigates to where the herds are currently concentrated.',
          tip: 'The migration\'s location changes weekly — a good guide with a radio network is essential to finding the herds.',
        },
        {
          time: 'Afternoon',
          icon: '☀️',
          title: 'The Great Migration — River Crossings',
          text: 'If timing aligns, witness the most dramatic wildlife spectacle on Earth — hundreds of thousands of wildebeest and zebra crossing the Grumeti River (west) or Mara River (north). Crocodiles lurk in the water, predators patrol the banks, and the sound of hooves and splashing is overwhelming. Even without crossings, the sheer scale of the migration herds is breathtaking.',
          tip: 'River crossings are unpredictable — sometimes herds wait for hours before crossing. Patience is rewarded spectacularly.',
        },
        {
          time: 'Evening',
          icon: '🌙',
          title: 'Migration Camp Experience',
          text: 'Mobile tented camps follow the migration — these seasonal camps set up in the path of the herds and offer a front-row seat to nature\'s greatest show. Dinner around a campfire with the sounds of a million wildebeest in the background is unforgettable. Budget travellers can camp at designated public campsites along the migration route.',
          tip: 'Mobile camps book out 6–12 months ahead for peak migration season — book early or join a group safari to share costs.',
        },
      ],
    },
    {
      num: 3,
      title: 'Ndutu & Southern Plains',
      periods: [
        {
          time: 'Morning',
          icon: '🌅',
          title: 'Ndutu Area — Calving Season Plains',
          text: 'Drive south towards the Ndutu area and the short-grass plains. From December to March, this is where 500,000 wildebeest calves are born in a frenzied three-week period — but year-round the area supports cheetahs, hyena clans, and bat-eared foxes. The flat terrain offers 360-degree visibility, making this prime predator-watching country at any time of year.',
          tip: 'The Ndutu area straddles Serengeti and Ngorongoro — entry permits may differ depending on which side you drive.',
        },
        {
          time: 'Afternoon',
          icon: '☀️',
          title: 'Olduvai Gorge — Cradle of Humanity',
          text: 'Visit Olduvai Gorge museum (entry $30) between Serengeti and Ngorongoro. This is where the Leakey family discovered 1.8-million-year-old hominid fossils that rewrote human evolutionary history. The small museum displays replica skulls and stone tools, and a viewing platform overlooks the gorge. It adds profound context to the landscape you have been driving through.',
          tip: 'Combine Olduvai with your transfer day between Serengeti and Ngorongoro — it sits directly on the route.',
        },
        {
          time: 'Evening',
          icon: '🌙',
          title: 'Final Sunset & Farewell Drive',
          text: 'End your Serengeti adventure with a sunset drive across the southern plains. The vast, treeless expanse stretching to every horizon is the defining Serengeti image — golden grass, scattered wildebeest, and a sky that seems impossibly wide. Return to camp for a final bush dinner and reflect on three days in one of the planet\'s last great wilderness areas.',
          tip: 'Tip your guide and camp staff — $15–20 per day for guides and $10 per day for camp staff is standard and appreciated.',
        },
      ],
    },
  ],
};

const budgetTips = [
  { title: 'Join a group safari', text: 'Solo safaris are expensive because vehicle and guide costs are fixed. Joining a group of 4–6 splits the cost dramatically — expect $150–250/day for budget group safaris versus $400+ for private. Operators in Arusha run group departures weekly.' },
  { title: 'Mix camping and lodges', text: 'Public campsites inside the Serengeti cost $30/person/night versus $200–500+ for tented camps. Camp for most nights and splurge on one or two lodge stays for the full experience without breaking the bank.' },
  { title: 'Book through local operators', text: 'Arusha-based safari operators offer significantly lower prices than international booking agents. Research operators on SafariBookings.com, check reviews, and book directly. Meet the operator in person in Arusha before departing.' },
  { title: 'Fly one way, drive the other', text: 'Charter flights save time but cost $250–400 each way. Fly into the Serengeti and drive back (or vice versa) to save money while still avoiding one brutal 8-hour drive. The drive itself is scenic through Maasai country.' },
  { title: 'Travel in shoulder season', text: 'March–May and November are cheaper with fewer tourists. The short rains in November bring green landscapes and migratory birds, while March–May offers calving season in the southern plains. Safari prices drop 20–30% in shoulder months.' },
  { title: 'Pack your own snacks and drinks', text: 'Bring trail mix, biscuits, instant coffee, and water from Arusha — camp shops inside the park are limited and overpriced. A well-stocked cooler box saves hundreds of thousands of shillings over a week.' },
];

const budgetBreakdown = [
  { category: 'Accommodation', budget: '$30–50', midrange: '$200–500', splurge: '$800–2,000', notes: 'Public campsite vs tented camp vs luxury lodge per person' },
  { category: 'Food', budget: '$15–25', midrange: '$40–80', splurge: '$100–200', notes: 'Self-catered vs camp meals vs lodge all-inclusive' },
  { category: 'Transport', budget: '$50–80', midrange: '$80–150', splurge: '$200–500', notes: 'Group safari share vs private vehicle vs fly-in safari' },
  { category: 'Activities', budget: '$0–30', midrange: '$50–100', splurge: '$200–600', notes: 'Game drives included; balloon $599, walking safaris $50+' },
  { category: 'Park Fees', budget: '$82', midrange: '$82', splurge: '$82', notes: '$70.80 park entry + $11.20 concession fee per day per adult' },
  { category: 'Daily Total', budget: '$177–267', midrange: '$452–912', splurge: '$1,382–3,382', notes: 'Per person — group safaris dramatically reduce transport costs' },
];

const practicalInfo = [
  { icon: '✈️', title: 'Getting There', items: ['Fly to Kilimanjaro International (JRO), transfer to Arusha (1.5 hrs)', 'Charter flights from Arusha to Seronera Airstrip (1.5 hrs, $250–400)', 'Drive from Arusha via Ngorongoro: 8–10 hours (game-viewing route)'] },
  { icon: '🎟️', title: 'Entry & Permits', items: ['Park entry: $70.80/adult/day (24-hour period)', 'Concession fee: $11.20/adult/day', 'Vehicle fee: $40/vehicle (foreign-registered), TZS 10,000 (local)'] },
  { icon: '💊', title: 'Health & Safety', items: ['Malaria prophylaxis essential — the Serengeti is in a high-risk zone', 'Yellow fever vaccination certificate may be required for entry to Tanzania', 'Carry a basic first aid kit — medical facilities are hours away from most camps'] },
  { icon: '📦', title: 'What to Pack', items: ['Soft-sided bags only (15kg limit on charter flights)', 'Binoculars, camera with 200mm+ zoom lens, memory cards and batteries', 'Dust-proof layers, wide-brimmed hat, high-SPF sunscreen'] },
  { icon: '📱', title: 'Connectivity', items: ['Cell signal is patchy — Vodacom Tanzania has best coverage in the Serengeti', 'No Wi-Fi at public campsites; lodges may have slow satellite internet', 'Download offline maps and wildlife identification guides before arriving'] },
  { icon: '💧', title: 'Water & Supplies', items: ['Carry at least 3 litres of water per person per day', 'Camp shops at Seronera stock basic supplies — limited and expensive', 'Stock up in Arusha or Karatu before entering the park'] },
];

const culturalTips = [
  { icon: '🦁', title: 'Stay in your vehicle', text: 'Never exit your safari vehicle unless at designated areas (picnic sites, camps, viewpoints). Animals see the vehicle as a single large object — a person stepping out triggers a predator response. Your guide will instruct you when it is safe.' },
  { icon: '🤫', title: 'Quiet at sightings', text: 'Keep your voice low and avoid sudden movements near wildlife. Shouting, clapping, or standing on vehicle seats startles animals and ruins the experience for everyone. The best sightings happen when observers are calm and patient.' },
  { icon: '🏘️', title: 'Respect Maasai communities', text: 'The Serengeti ecosystem includes Maasai pastoralist communities. Ask permission before photographing people, and negotiate photo fees respectfully ($1–5 is standard). Buy crafts directly from community women\'s groups rather than roadside middlemen.' },
  { icon: '🗑️', title: 'Zero waste policy', text: 'The Serengeti has a strict leave-no-trace policy. Carry all rubbish out of the park, including biodegradable waste. Plastic bags are banned in Tanzania entirely. Animals can choke on litter — a plastic bag killed an elephant in the park in recent years.' },
  { icon: '💡', title: 'Off-road driving is illegal', text: 'Never drive off designated tracks, even to approach an animal. Off-road driving destroys the fragile grassland ecosystem that supports the entire migration. Fines are steep ($500+) and your operator risks losing their licence. Stay on the tracks always.' },
  { icon: '💰', title: 'Tipping culture', text: 'Tipping is expected and appreciated. Standard rates: safari guide $15–20/day, camp staff $10/day, transfer drivers $5–10. Tip in USD cash — small bills are best. Hand tips directly to the individual or ask your operator to distribute fairly.' },
];

---

<CityGuideLayout
  title="Serengeti Travel Guide 2026 — Safari Itinerary | roammate"
  description="Plan your Serengeti safari with 1, 3, and 7-day itineraries covering the Great Migration, Big Five game drives, Ngorongoro Crater, and budget tips for young travellers exploring Tanzania's iconic wilderness."
  heroImage="/images/guides/serengeti-hero.webp"
  heroFlag="🇹🇿" heroCountry="Tanzania" heroRegion="Africa" heroCity="Serengeti"
  heroSubtitle="Witness the Great Migration across endless golden plains — two million wildebeest, zebra, and gazelle in the greatest wildlife spectacle on Earth."
  heroPills={['7-Day Itinerary', 'Safari & Migration', 'Jun–Oct Best']}
  quickFacts={quickFacts} itineraries={itineraries} defaultDays={1}
  budgetTips={budgetTips} budgetBreakdown={budgetBreakdown} budgetIntro="The Serengeti is not a budget destination, but group safaris, camping, and local operators can bring costs down significantly. A week-long safari with camping can cost under $1,500 per person if you plan carefully."
  practicalInfo={practicalInfo}
  culturalTips={culturalTips} culturalIntro="The Serengeti ecosystem is one of the last intact large-mammal ecosystems on Earth. Following these guidelines helps protect this irreplaceable wilderness and ensures respectful engagement with local communities."
  ctaCity="Serengeti" ctaText="Ready to witness the Great Migration? From budget group safaris to luxury fly-in camps, roammate helps you build the perfect Serengeti adventure."
  ctaCustomise="To customise this itinerary to your travel style, pace, and budget — download the roammate app to tailor it to your preferences."
/>
