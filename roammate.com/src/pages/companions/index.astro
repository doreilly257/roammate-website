---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllGuides, getCityGuideSlugs } from '../../data/guides';

const allGuides = await getAllGuides();
const cityGuideSlugs = await getCityGuideSlugs();

const cityGuides = allGuides
  .filter((guide) => cityGuideSlugs.has(guide.slug))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Find Travel Companions — Cities Worldwide | roammate"
  description={`Find travel companions in ${cityGuides.length} cities worldwide. roammate matches you by travel style, budget, and destination — free on iOS.`}
  ogImage="/images/hero-travelers-on-bus.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Find Travel Companions — Cities Worldwide",
      "url": "https://roammate.com/companions/",
      "description": `Find travel companions in ${cityGuides.length} cities worldwide.`,
      "numberOfItems": cityGuides.length,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
          { "@type": "ListItem", "position": 2, "name": "Travel Companions", "item": "https://roammate.com/companions/" },
        ],
      },
    })} />
  </Fragment>

  <section class="comp-index-hero">
    <div class="comp-index-hero-inner">
      <div class="section-label section-label--center">Find your match</div>
      <h1 class="comp-index-title">Travel Companions<br><em>by City</em></h1>
      <p class="comp-index-sub">roammate matches you with like-minded travelers by style, budget, and destination. Choose a city to get started.</p>
      <a
        href="https://apps.apple.com/app/id6758834253?pt=118224460&ct=companions-index-hero&mt=8"
        target="_blank"
        rel="noopener noreferrer"
        class="comp-index-btn"
        data-ph-event="companions_index_appstore_click"
      >Download Free on iOS</a>
      <a href="https://play.google.com/store/apps/details?id=com.roammate.app.android" class="comp-index-btn comp-index-btn--ghost" target="_blank" rel="noopener noreferrer" data-ph-event="companions_index_playstore_click">Get it on Android</a>
    </div>
  </section>

  <section class="comp-index-grid-section">
    <div class="comp-index-grid-inner">
      <div class="comp-index-grid">
        {cityGuides.map((guide, i) => (
          <a href={`/companions/${guide.slug}/`} class={`comp-index-card reveal reveal-delay-${(i % 4) + 1}`}>
            <span class="comp-index-flag">{guide.flag}</span>
            <div>
              <h3>{guide.name}</h3>
              <p>{guide.country} · {guide.region}</p>
            </div>
            <span class="comp-index-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .comp-index-hero {
    padding: 160px 40px 80px;
    text-align: center;
  }

  .comp-index-hero-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .section-label--center {
    justify-content: center;
  }

  .section-label--center::before {
    display: none;
  }

  .comp-index-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 80px);
    font-weight: 900;
    line-height: 1.05;
    color: var(--color-ink);
    margin-bottom: 22px;
  }

  .comp-index-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .comp-index-sub {
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-ink-muted);
    margin-bottom: 36px;
  }

  .comp-index-btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s var(--ease-out-expo);
  }

  .comp-index-btn--ghost {
    background: transparent;
    border: 1px solid currentColor;
  }

  .comp-index-btn:hover {
    background: #b34f28;
    transform: translateY(-2px);
  }

  .comp-index-grid-section {
    padding: 0 40px 120px;
  }

  .comp-index-grid-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .comp-index-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .comp-index-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    background: var(--color-bg-warm);
    border: 1px solid rgba(196, 86, 42, 0.1);
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
  }

  .comp-index-card:hover {
    transform: translateY(-2px);
    border-color: rgba(196, 86, 42, 0.3);
  }

  .comp-index-flag {
    font-size: 24px;
    flex-shrink: 0;
  }

  .comp-index-card > div {
    flex: 1;
    min-width: 0;
  }

  .comp-index-card h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .comp-index-card p {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .comp-index-arrow {
    color: var(--color-terracotta);
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .comp-index-hero { padding: 140px 24px 60px; }
    .comp-index-grid-section { padding: 0 24px 80px; }
    .comp-index-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 640px) {
    .comp-index-hero { padding: 120px 20px 48px; }
    .comp-index-grid-section { padding: 0 20px 60px; }
    .comp-index-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
