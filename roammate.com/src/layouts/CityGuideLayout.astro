---
import BaseLayout from './BaseLayout.astro';
import { getRelated, getRoutes, getCityGuideSlugs } from '../data/guides';
import { findRelatedPostsForGuide } from '../lib/related-content';
import { getAllBlogPosts } from '../lib/blog-data';
import { regionToSlug } from '../lib/region-slug';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import AppCTA from '../components/AppCTA.astro';

import { blogByGuide } from '../data/blogByGuide';

interface Props {
  /* SEO */
  title: string;
  description: string;
  /* hero */
  heroImage: string;
  heroFlag: string;
  heroCountry: string;
  heroRegion: string;
  heroCity: string;
  heroSubtitle: string;
  heroPills: string[];
  /* data sections */
  quickFacts: { icon: string; label: string; value: string; detail: string }[];
  itineraries: Record<string, { num: number; title: string; periods: { time: string; icon: string; title: string; text: string; tip?: string }[] }[]>;
  defaultDays?: number;
  budgetTips: ({ title: string; text: string } | string)[];
  budgetBreakdown: { category: string; budget: string; midrange?: string; mid?: string; splurge?: string; notes?: string }[];
  budgetIntro?: string;
  practicalInfo: { icon: string; title: string; items: string[] }[];
  culturalTips: ({ icon: string; title: string; text: string } | string)[];
  culturalIntro?: string;
  /* CTA */
  ctaCity: string;
  ctaText: string;
  ctaCustomise: string;
}

const {
  title, description,
  heroImage, heroFlag, heroCountry, heroRegion, heroCity, heroSubtitle, heroPills,
  quickFacts, itineraries, defaultDays = 3,
  budgetTips, budgetBreakdown, budgetIntro,
  practicalInfo,
  culturalTips, culturalIntro,
  ctaCity, ctaText, ctaCustomise,
} = Astro.props;

const defaultDaysStr = String(defaultDays);
const currentSlug = Astro.url.pathname.replace(/^\/guides\//, '').replace(/\/$/, '');
// Companions pages only exist for curated city slugs, not place guides
const hasCompanionsPage = (await getCityGuideSlugs()).has(currentSlug);
const relatedGuides = await getRelated(currentSlug, heroRegion, 6);
const relatedRoutes = await getRoutes(currentSlug);
// Use pre-built blogByGuide first, fall back to keyword matching
const prebuilt = blogByGuide[currentSlug] ?? [];
let relatedPosts = prebuilt.slice(0, 3);
if (relatedPosts.length < 3) {
  const allBlogPosts = await getAllBlogPosts();
  relatedPosts = findRelatedPostsForGuide(currentSlug, heroCity, heroCountry, heroRegion, allBlogPosts, 3);
}

const regionSlug = regionToSlug(heroRegion);

const escapeCssUrl = (url: string) =>
  url.replace(/['"()\\]/g, '\\$&');
---

<BaseLayout title={title} description={description} ogImage={heroImage}>
  <Fragment slot="head">
    <meta name="ph-region" content={heroRegion}>
    <meta name="ph-city" content={heroCity}>
    <link rel="preload" as="image" type="image/webp" href={heroImage}>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TouristDestination",
      "name": heroCity,
      "description": description,
      "image": new URL(heroImage, Astro.site).href,
      "url": new URL(Astro.url.pathname, Astro.site).href,
      "touristType": "Backpackers and solo travelers",
      "containedInPlace": {
        "@type": "Country",
        "name": heroCountry
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
        { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://roammate.com/guides/" },
        { "@type": "ListItem", "position": 3, "name": heroCity, "item": new URL(Astro.url.pathname, Astro.site).href }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="guide-hero">
    <div class="guide-hero-bg" style={`background-image: linear-gradient(to top, rgba(15,15,15,0.92) 0%, rgba(15,15,15,0.35) 40%, rgba(15,15,15,0.2) 70%, rgba(15,15,15,0.4) 100%), url('${escapeCssUrl(heroImage)}');`}></div>
    <div class="guide-hero-content">
      <div class="guide-hero-breadcrumb">
        <a href="/guides/">Guides</a>
        <span>/</span>
        <a href={`/guides/region/${regionSlug}/`}>{heroRegion}</a>
      </div>
      <div class="guide-hero-tag">
        <span class="guide-hero-flag">{heroFlag}</span>
        <span>{heroCountry}</span>
      </div>
      <h1 class="guide-hero-title">{heroCity}</h1>
      <p class="guide-hero-subtitle">{heroSubtitle}</p>
      <div class="guide-hero-meta">
        {heroPills.map((pill) => (
          <span class="guide-meta-pill">{pill}</span>
        ))}
      </div>
    </div>
    <div class="guide-hero-scroll">
      <span>Explore</span>
      <div class="guide-scroll-line"></div>
    </div>
  </section>

  <!-- Quick Facts -->
  <section class="guide-facts reveal">
    <div class="guide-facts-grid">
      {quickFacts.map((f) => (
        <div class="guide-fact">
          <span class="guide-fact-icon">{f.icon}</span>
          <div>
            <div class="guide-fact-label">{f.label}</div>
            <div class="guide-fact-value">{f.value}</div>
            <div class="guide-fact-detail">{f.detail}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Duration Toggle -->
  <section class="guide-duration reveal" id="itinerary">
    <div class="guide-duration-inner">
      <span class="guide-duration-label">How long are you staying?</span>
      <div class="guide-duration-toggle">
        {Object.keys(itineraries).map((d) => (
          <button class={`guide-duration-btn ${d === defaultDaysStr ? 'active' : ''}`} data-days={d}>{d === '1' ? '1 Day' : `${d} Days`}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- Itinerary -->
  <section class="guide-itinerary">
    {Object.entries(itineraries).map(([duration, daysData]) => (
      <div class={`guide-itinerary-variant ${duration === defaultDaysStr ? 'active' : ''}`} data-itinerary={duration}>
        <div class="guide-section-header reveal">
          <div class="section-label">Your Itinerary</div>
          <h2 class="section-heading">{duration === '1' ? '1 day' : `${duration} days`} in <em>{heroCity}</em></h2>
          <p class="guide-section-intro">{
            duration === '1'
              ? `Only got 24 hours? Here's how to experience the best of ${heroCity} in a single action-packed day.`
              : duration === '3'
              ? `A carefully curated route mixing iconic landmarks, hidden gems, street food, culture, and adventure — designed for younger travelers.`
              : `A full week to go deep — from famous landmarks to local neighbourhoods, day trips, hidden gems, and proper local immersion.`
          }</p>
        </div>

        {daysData.map((day) => (
          <div class="guide-day reveal">
            <div class="guide-day-header">
              <div class="guide-day-number">Day {day.num}</div>
              <h3 class="guide-day-title">{day.title}</h3>
            </div>
            <div class="guide-day-periods">
              {day.periods.map((p) => (
                <div class="guide-period">
                  <div class="guide-period-time">
                    <span class="guide-period-icon">{p.icon}</span>
                    <span>{p.time}</span>
                  </div>
                  <div class="guide-period-content">
                    <h4 class="guide-period-title">{p.title}</h4>
                    <p class="guide-period-text">{p.text}</p>
                    <div class="guide-period-tip">
                      <strong>Tip:</strong> {p.tip}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </section>

  <!-- Budget Tips -->
  <section class="guide-budget" id="budget">
    <div class="guide-section-header reveal">
      <div class="section-label">Save Money</div>
      <h2 class="section-heading">Budget <em>tips</em></h2>
    </div>
    <div class="guide-budget-grid">
      {budgetTips.map((tip, i) => (
        <div class={`guide-budget-card reveal reveal-delay-${(i % 4) + 1}`}>
          {typeof tip !== 'string' && <h3 class="guide-budget-title">{tip.title}</h3>}
          <p class="guide-budget-text">{typeof tip === 'string' ? tip : tip.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Budget Breakdown -->
  <section class="guide-breakdown" id="breakdown">
    <div class="guide-section-header reveal">
      <div class="section-label">Money</div>
      <h2 class="section-heading">Budget <em>breakdown</em></h2>
      {budgetIntro && <p class="guide-section-intro">{budgetIntro}</p>}
    </div>
    <div class="guide-breakdown-wrap reveal">
      <table class="guide-breakdown-table">
        <colgroup>
          <col class="guide-breakdown-col-label">
          <col>
          <col>
          <col>
        </colgroup>
        <thead>
          <tr>
            <th scope="col" class="guide-breakdown-cell guide-breakdown-tier-header"></th>
            <th scope="col" class="guide-breakdown-cell guide-breakdown-tier">🎒 Budget</th>
            <th scope="col" class="guide-breakdown-cell guide-breakdown-tier">✨ Mid-Range</th>
            <th scope="col" class="guide-breakdown-cell guide-breakdown-tier">💎 Splurge</th>
          </tr>
        </thead>
        <tbody>
          {budgetBreakdown.map((row) => (
            <tr class={row.category === 'Daily Total' ? 'guide-breakdown-total' : ''}>
              <th scope="row" class="guide-breakdown-cell guide-breakdown-label">
                {row.category}
                <span class="guide-breakdown-notes">{row.notes}</span>
              </th>
              <td class="guide-breakdown-cell">{row.budget}</td>
              <td class="guide-breakdown-cell">{row.midrange}</td>
              <td class="guide-breakdown-cell">{row.splurge}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Practical Info -->
  <section class="guide-practical" id="practical">
    <div class="guide-section-header reveal">
      <div class="section-label">Essentials</div>
      <h2 class="section-heading">Practical <em>info</em></h2>
    </div>
    <div class="guide-practical-grid">
      {practicalInfo.map((info, i) => (
        <div class={`guide-practical-card reveal reveal-delay-${(i % 4) + 1}`}>
          <span class="guide-practical-icon">{info.icon}</span>
          <h3 class="guide-practical-title">{info.title}</h3>
          <ul class="guide-practical-list">
            {info.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Cultural Tips -->
  <section class="guide-culture" id="culture">
    <div class="guide-section-header reveal">
      <div class="section-label">Know Before You Go</div>
      <h2 class="section-heading">Cultural <em>tips</em></h2>
      {culturalIntro && <p class="guide-section-intro">{culturalIntro}</p>}
    </div>
    <div class="guide-culture-grid">
      {culturalTips.map((tip, i) => (
        <div class={`guide-culture-card reveal reveal-delay-${(i % 4) + 1}`}>
          {typeof tip !== 'string' && <span class="guide-culture-icon">{tip.icon}</span>}
          {typeof tip !== 'string' && <h3 class="guide-culture-title">{tip.title}</h3>}
          <p class="guide-culture-text">{typeof tip === 'string' ? tip : tip.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Related Guides -->
  {relatedGuides.length > 0 && (
    <section class="guide-related reveal">
      <div class="guide-section-header">
        <div class="section-label">Keep Exploring</div>
        <h2 class="section-heading">More in <em>{heroRegion}</em></h2>
      </div>
      <div class="guide-related-grid">
        {relatedGuides.map((g) => (
          <a href={`/guides/${g.slug}/`} class="guide-related-card">
            <span class="guide-related-flag">{g.flag}</span>
            <div class="guide-related-info">
              <span class="guide-related-name">{g.name}</span>
              <span class="guide-related-country">{g.country}</span>
            </div>
            <span class="guide-related-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Backpacker Routes -->
  {relatedRoutes.length > 0 && (
    <section class="guide-routes reveal">
      <div class="guide-section-header">
        <div class="section-label">Multi-Week Travel</div>
        <h2 class="section-heading"><em>{heroCity}</em> is on these routes</h2>
      </div>
      <div class="guide-routes-list">
        {relatedRoutes.map((r) => (
          <a href={`/guides/${r.slug}/`} class="guide-route-link">
            <span class="guide-route-flags">{r.flags}</span>
            <span class="guide-route-name">{r.name} Backpacker Route</span>
            <span class="guide-route-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- From the Blog -->
  {relatedPosts.length > 0 && (
    <section class="guide-blog-posts reveal">
      <div class="guide-section-header">
        <div class="section-label">From the Blog</div>
        <h2 class="section-heading">Reading for <em>{heroCity}</em></h2>
      </div>
      <div class="guide-blog-grid">
        {relatedPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="guide-blog-card">
            <div class="guide-blog-card-img-wrap">
              <img src={post.heroImage} alt={post.title} class="guide-blog-card-img" width="400" height="260" loading="lazy" decoding="async" />
            </div>
            <div class="guide-blog-card-body">
              <span class="guide-blog-card-category">{post.category}</span>
              <h3 class="guide-blog-card-title">{post.title}</h3>
              <p class="guide-blog-card-desc">{post.description}</p>
              <span class="guide-blog-card-link">Read article →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <NewsletterSignup />

  <!-- CTA -->
  <section class="guide-cta reveal">
    <div class="guide-cta-inner">
      <h2 class="guide-cta-heading">Heading to <em>{ctaCity}</em>?</h2>
      <p class="guide-cta-text">{ctaText}</p>
      <div class="guide-cta-downloads">
        <AppCTA variant="badges" appStoreCt="city-guide-cta" appStoreEvent="guide_appstore_click" playStoreEvent="guide_playstore_click" />
      </div>
      <p class="guide-cta-customise">{ctaCustomise}</p>
      {hasCompanionsPage && (
        <a href={`/companions/${currentSlug}/`} class="guide-cta-companions-link" data-ph-event="guide_companions_click" data-ph-label={currentSlug}>
          Find travel companions in {ctaCity} →
        </a>
      )}
    </div>
  </section>

</BaseLayout>

<style>
  /* ========================
     HERO
     ======================== */
  .guide-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding: 0 40px 80px;
    overflow: hidden;
  }

  .guide-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .guide-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .guide-hero-breadcrumb {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.4);
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.3s forwards;
  }

  .guide-hero-breadcrumb a {
    color: rgba(245, 240, 232, 0.6);
    transition: color 0.3s;
  }

  .guide-hero-breadcrumb a:hover {
    color: var(--color-terracotta-light);
  }

  .guide-hero-breadcrumb span {
    margin: 0 8px;
  }

  .guide-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-terracotta-light);
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.5s forwards;
  }

  .guide-hero-flag {
    font-size: 24px;
  }

  .guide-hero-title {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 140px);
    font-weight: 900;
    line-height: 0.9;
    color: #f5f0e8;
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(40px);
    animation: fadeUp 1.2s var(--ease-out-expo) 0.7s forwards;
  }

  .guide-hero-subtitle {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.7);
    max-width: 500px;
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 0.9s forwards;
  }

  .guide-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 1s var(--ease-out-expo) 1.1s forwards;
  }

  .guide-meta-pill {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.8);
    padding: 8px 16px;
    border: 1px solid rgba(245, 240, 232, 0.15);
    border-radius: 100px;
  }

  .guide-hero-scroll {
    position: absolute;
    bottom: 40px;
    right: 40px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeUp 1s var(--ease-out-expo) 1.4s forwards;
  }

  .guide-hero-scroll span {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(245, 240, 232, 0.4);
    writing-mode: vertical-rl;
  }

  .guide-scroll-line {
    width: 1px;
    height: 60px;
    background: rgba(245, 240, 232, 0.2);
    position: relative;
    overflow: hidden;
  }

  .guide-scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-terracotta);
    animation: scrollLine 2s ease-in-out infinite;
  }

  /* ========================
     QUICK FACTS
     ======================== */
  .guide-facts {
    padding: 80px 40px;
    background: var(--color-bg-warm);
  }

  .guide-facts-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 32px;
  }

  .guide-fact {
    text-align: center;
  }

  .guide-fact-icon {
    font-size: 28px;
    display: block;
    margin-bottom: 12px;
  }

  .guide-fact-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    font-weight: 600;
    margin-bottom: 6px;
  }

  .guide-fact-value {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .guide-fact-detail {
    font-size: 12px;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  /* ========================
     DURATION TOGGLE
     ======================== */
  .guide-duration {
    padding: 0 40px;
    max-width: 900px;
    margin: 80px auto 0;
  }

  .guide-duration-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 28px;
    background: var(--color-bg-warm);
    border-radius: 8px;
  }

  .guide-duration-label {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .guide-duration-toggle {
    display: flex;
    gap: 6px;
    background: var(--color-bg);
    padding: 4px;
    border-radius: 100px;
  }

  .guide-duration-btn {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    padding: 10px 20px;
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.3s var(--ease-out-expo);
  }

  .guide-duration-btn:hover {
    color: var(--color-ink);
  }

  .guide-duration-btn.active {
    background: var(--color-terracotta);
    color: #fff;
  }

  /* ========================
     ITINERARY VARIANTS
     ======================== */
  .guide-itinerary-variant {
    display: none;
  }

  .guide-itinerary-variant.active {
    display: block;
  }

  /* ========================
     ITINERARY
     ======================== */
  .guide-itinerary {
    padding: 60px 40px 120px;
    max-width: 900px;
    margin: 0 auto;
  }

  .guide-section-header {
    margin-bottom: 64px;
  }

  .guide-section-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--color-ink-muted);
    font-weight: 300;
    max-width: 600px;
  }

  .guide-day {
    margin-bottom: 80px;
    position: relative;
  }

  .guide-day-header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .guide-day-number {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    white-space: nowrap;
  }

  .guide-day-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .guide-day-periods {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-left: 24px;
    border-left: 2px solid rgba(196, 86, 42, 0.15);
  }

  .guide-period {
    position: relative;
  }

  .guide-period::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-terracotta);
    border: 2px solid var(--color-bg);
  }

  .guide-period-time {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: 12px;
  }

  .guide-period-icon {
    font-size: 16px;
  }

  .guide-period-title {
