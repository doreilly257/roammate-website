  { icon: '🗣', label: 'Language', value: 'English / Afrikaans', detail: 'German widely spoken — colonial heritage town' },
  { icon: '🕐', label: 'Timezone', value: 'CAT (UTC+2)', detail: 'No DST' },
  { icon: '☀️', label: 'Best Months', value: 'Sep – Mar', detail: 'Warmer months, less fog, best adventure conditions' },
  { icon: '🎒', label: 'Daily Budget', value: '~$35–55 USD', detail: 'Mid-range, adventure activities add up' },
  { icon: '🛂', label: 'Visa', value: 'Visa-free for many', detail: '90-day visa-free for most Western nationalities' },
