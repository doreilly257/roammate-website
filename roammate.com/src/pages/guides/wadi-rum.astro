const culturalTips = [
  { icon: '🏜️', title: 'Bedouin Hospitality', text: 'Your Bedouin hosts are not hotel staff — they are sharing their home and culture. Accept tea when offered, eat with your right hand, and show genuine interest in their stories. The hospitality is real, not performative.' },
  { icon: '🕌', title: 'Prayer Times', text: 'Your hosts will pray five times daily. Be quiet and respectful during prayers. Do not walk in front of someone praying. Meal times may shift slightly around prayer times. This is normal and not inconvenient.' },
  { icon: '👗', title: 'Modest Dress', text: 'Wadi Rum is more relaxed than Jordanian cities but respect is important. Women should cover shoulders and knees at camp. Men should wear shirts. In the desert during activities, hiking clothing is fine.' },
  { icon: '📸', title: 'Photography', text: 'Ask before photographing your hosts and their families. Most Bedouin men are happy to be photographed but women generally prefer not to be. Never photograph someone without asking — it is deeply disrespectful in Bedouin culture.' },
  { icon: '🌿', title: 'Desert Conservation', text: 'Wadi Rum is a UNESCO World Heritage Site. Take all rubbish out with you, do not climb on petroglyphs or inscriptions, and stay on trails when hiking. The desert ecosystem is fragile despite looking barren.' },
  { icon: '🤝', title: 'Genuine Connection', text: 'The best Wadi Rum experience comes from genuine connection with your Bedouin hosts. Put your phone away at dinner, ask questions, share stories from your own culture, and participate in camp life. You will be rewarded with authenticity.' },
];
