---
const base = import.meta.env.BASE_URL;
const images = [
  { file: '01.jpg', alt: 'Backpackers trekking through a lush mountain trail at sunrise' },
  { file: '02.jpg', alt: 'Group of travelers sharing a meal at a bustling street food market' },
  { file: '03.jpg', alt: 'Friends watching the sunset from a coastal viewpoint' },
  { file: '04.jpg', alt: 'Adventurers exploring a vibrant local neighborhood together' },
  { file: '05.jpg', alt: 'Travel companions navigating a scenic lakeside path' },
  { file: '06.jpg', alt: 'Solo traveler meeting new friends at a rooftop gathering' },
];
---

<section class="gallery">
  <div class="gallery-track">
    {images.map((img) => (
      <picture>
        <source srcset={`${base}images/carousel/${img.file.replace('.jpg', '.webp')}`} type="image/webp">
        <img src={`${base}images/carousel/${img.file}`} alt={img.alt} loading="lazy" width="1080" height="712">
      </picture>
    ))}
    {/* Duplicate for seamless loop */}
    {images.map((img) => (
      <picture>
        <source srcset={`${base}images/carousel/${img.file.replace('.jpg', '.webp')}`} type="image/webp">
        <img src={`${base}images/carousel/${img.file}`} alt={img.alt} loading="lazy" width="1080" height="712">
      </picture>
    ))}
  </div>
</section>

<style>
  .gallery {
    overflow: hidden;
    position: relative;
  }

  .gallery::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.08), transparent);
    z-index: 1;
  }

  .gallery-track {
    display: flex;
    gap: 16px;
    animation: marquee 40s linear infinite;
    width: max-content;
  }

  .gallery-track picture {
    flex-shrink: 0;
  }

  .gallery-track img {
    height: 400px;
    width: auto;
    object-fit: cover;
    filter: saturate(0.8);
    transition: filter 0.5s;
    border-radius: 4px;
  }

  .gallery-track img:hover {
    filter: saturate(1.2);
  }

  @media (max-width: 640px) {
    .gallery-track img { height: 260px; }
  }
</style>
