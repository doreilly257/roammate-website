  { category: 'Activities', budget: 'ARS 28,000–35,000', midrange: 'ARS 60,000–100,000', splurge: 'ARS 150,000+', notes: 'Park entry → boat rides & both sides → full-moon walk & kayak' },
  { category: 'Drinks', budget: 'ARS 2,000–4,000', midrange: 'ARS 5,000–10,000', splurge: 'ARS 15,000+', notes: 'Supermarket beer → bar drinks → restaurant wine' },
