  }

  .tc-breadcrumb span {
    margin: 0 10px;
  }

  .tc-hero-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 900;
    line-height: 1.15;
    color: #f5f0e8;
  }

  .tc-content {
    padding: 56px 24px 64px;
  }

  .tc-content-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .slow-travel-definition {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.75;
