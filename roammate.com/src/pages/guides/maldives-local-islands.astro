const culturalTips = [
  { icon: '🙏', title: 'Respect Local Customs', text: 'Remove shoes before entering temples, mosques, or homes. Dress modestly — cover shoulders and knees at religious sites. Ask permission before photographing people or ceremonies.' },
  { icon: '🌍', title: 'Leave No Trace', text: 'Pack out all rubbish. Stay on marked trails and paths. Do not touch, feed, or disturb wildlife. The natural beauty of Maldives depends on every visitor treating it with respect. Take only photos, leave only footprints.' },
  { icon: '📸', title: 'Photography Etiquette', text: 'Ask permission before photographing locals, especially in indigenous or traditional communities. Many religious sites have photography restrictions — check signage and respect these rules. Drone regulations vary — check local laws before flying.' },
  { icon: '🗣', title: 'Language & Communication', text: 'Learn a few words in Dhivehi — greetings, please, thank you, and numbers go a long way. English is limited outside tourist areas but a translation app helps bridge gaps.' },
  { icon: '🤝', title: 'Support Local Communities', text: 'Choose locally-owned guesthouses, restaurants, and guides over international chains. Buy handicrafts directly from artisans. Your spending has the most impact when it goes directly into the local economy rather than through large tour operators.' },
  { icon: '🕐', title: 'Pace & Patience', text: 'Things move at a different pace here — embrace it. Delays, diversions, and unexpected encounters are part of the adventure. Patience and flexibility will transform your experience.' },
