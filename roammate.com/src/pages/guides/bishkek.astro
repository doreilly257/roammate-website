const itineraries = {
  1: [
    {
      num: 1,
      title: 'The Best of Bishkek in 24 Hours',
      periods: [
        {
          time: 'Morning',
          icon: '🌅',
          title: 'Ala-Too Square & Osh Bazaar',
          text: 'Start at Ala-Too Square, the vast Soviet-era central plaza flanked by the State History Museum and the imposing Manas statue — the legendary Kyrgyz hero. Watch the flag-lowering ceremony if your timing is right, then walk south past oak-lined boulevards to Osh Bazaar, Central Asia\'s most vibrant market. Wander the stalls selling kurut (dried yoghurt balls, 50 KGS), sacks of spices, felt hats (kalpaks), and heaps of dried fruits and nuts. Breakfast at one of the bazaar canteens — laghman noodle soup (120 KGS) and lepyoshka bread fresh from a tandoor oven. The atmosphere is electric and overwhelmingly friendly.',
