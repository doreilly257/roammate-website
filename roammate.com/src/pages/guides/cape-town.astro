const budgetTips = [
  { title: 'Free Table Mountain hike', text: 'The Platteklip Gorge trail to Table Mountain summit is free — saving ZAR 395 per person on the cable car. The hike takes 2–3 hours up. Take the cable car down one-way (ZAR 235) if your legs are tired.' },
  { title: 'MyCiTi bus system', text: 'The MyCiTi bus network connects the airport, city centre, Table Mountain, and the Atlantic coast. Buy a myconnect card (ZAR 35) and rides cost ZAR 11–30. Far cheaper than Uber for longer routes.' },
  { title: 'Braai culture', text: 'South Africans braai (barbecue) constantly. Most hostels and Airbnbs have a braai. Buy boerewors sausage (ZAR 70/kg), chops, and rolls from Pick n Pay or Checkers — a full braai dinner for ZAR 60 per person versus ZAR 200+ at restaurants.' },
  { title: 'Free beaches everywhere', text: 'Camps Bay, Clifton 4th, Muizenberg, and dozens more beaches are completely free. No lounger fees, no entry charges. Bring a towel and sunscreen — Cape Town has world-class beaches at no cost.' },
  { title: 'Wine farm picnics', text: 'Instead of expensive restaurant lunches at wine farms, buy wine tastings (ZAR 80–120) and pack your own picnic. Many Constantia and Stellenbosch estates have lawns where you can spread out with cheese, biltong, and a bottle of local wine.' },
  { title: 'Uber over metered taxis', text: 'Uber is significantly cheaper and safer than metered taxis in Cape Town. Airport to city centre: around ZAR 200–280 by Uber versus ZAR 350+ by taxi. Always use Uber after dark for safety.' },
];

