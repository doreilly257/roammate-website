  { category: 'Transport', budget: '$4–8', midrange: '$10–20', splurge: '$40+', notes: 'Colectivos → shared tours → private car' },
  { category: 'Activities', budget: '$6–10', midrange: '$15–25', splurge: '$50+', notes: 'Self-guided → group tours → private guide' },
  { category: 'Boleto Turistico', budget: '$19', midrange: '$19', splurge: '$19', notes: 'Mandatory canyon entry ticket (70 PEN)' },
  { category: 'Daily Total', budget: '$25–40', midrange: '$60–115', splurge: '$200+', notes: 'Budget trekkers can go lower' },
];

