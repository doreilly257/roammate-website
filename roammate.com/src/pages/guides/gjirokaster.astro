const culturalTips = [
  { icon: '🙏', title: 'Respect Religious Harmony', text: 'Albania is one of the most religiously tolerant countries in Europe — mosques, churches, and Bektashi shrines coexist peacefully. Dress modestly when visiting any place of worship and ask before photographing interiors.' },
  { icon: '🌍', title: 'Protect the UNESCO Site', text: 'Gjirokaster\'s stone architecture is irreplaceable. Do not climb on ruins, touch frescoes, or remove stones. Stay on marked paths at archaeological sites. The preservation of this city depends on every visitor treating it respectfully.' },
  { icon: '📸', title: 'Photography Etiquette', text: 'The stone city is extraordinarily photogenic. Locals are generally happy to be photographed but always ask first. Some tower houses are private residences — photograph from the street but do not enter gardens without invitation.' },
  { icon: '🗣', title: 'Learn Basic Albanian', text: 'A few words go a long way: "Mirëdita" (good day), "Faleminderit" (thank you), "Ju lutem" (please). Greek is also spoken by some residents in southern Albania due to proximity to the border.' },
  { icon: '🤝', title: 'Support Local Families', text: 'Gjirokaster\'s economy depends on tourism reaching its historic core. Stay in family-run guesthouses, eat at local restaurants, and buy directly from bazaar artisans. Your spending has the most impact when it goes to local families.' },
  { icon: '🕐', title: 'Slow Down & Listen', text: 'Gjirokaster rewards patience. The old town\'s atmosphere — the echo of footsteps on stone, the call to prayer, the clinking of coffee cups in the bazaar — is as much the experience as any monument. Do not rush through it.' },
];
