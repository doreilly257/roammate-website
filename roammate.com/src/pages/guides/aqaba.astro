const culturalTips = [
  { icon: '🙏', title: 'Jordanian Hospitality', text: 'Jordanians are famous for their hospitality — accepting offered tea or coffee is polite and refusing can cause offence. If invited to someone\'s home, bring a small gift (sweets or pastries). Remove shoes before entering homes.' },
  { icon: '🕌', title: 'Respect Islam', text: 'Jordan is a Muslim country. During Ramadan, avoid eating, drinking, or smoking in public during daylight hours out of respect for those fasting. Dress modestly when visiting mosques — women should cover their hair.' },
