const budgetTips = [
  { title: 'Free mosque visits', text: 'The Sultan Qaboos Grand Mosque is free — Oman\'s number one attraction costs nothing. The mosques in Nizwa and other towns are also free. This is one of the most generous free attractions in the Middle East.' },
  { title: 'Local restaurants over hotels', text: 'Hotel restaurants in Muscat are expensive (OMR 10–20 mains). Local Omani and Indian restaurants in Ruwi, Al Khuwair, and near Mutrah serve excellent meals for OMR 1.500–4. The quality is often better than hotel food.' },
  { title: 'Rent a car for day trips', text: 'Rental cars from OMR 8–12/day make Wadi Shab, Nizwa, and Jebel Akhdar far cheaper than tours (OMR 25–50 per person). Roads are excellent. International licenses accepted. Fuel is cheap (OMR 0.217/litre).' },
  { title: 'Public beach access', text: 'Qurum Beach, Al Bustan Beach, and Yiti Beach are free. No need for hotel beach clubs — Oman\'s coastline is wild and accessible. Bring your own towel and water.' },
  { title: 'Mutrah Souq prices', text: 'Mutrah Souq has fairer prices than most Middle Eastern souqs. Frankincense, silver, and textiles are good value. Haggling is gentle — 10–20% off is typical. Avoid the tourist-trap shops at the entrance.' },
  { title: 'Share a taxi', text: 'Muscat taxis don\'t use meters — always agree the fare before getting in. Typical rides: OMR 1–3 within a district, OMR 5–8 across the city. Uber works in Muscat but isn\'t always cheaper than negotiated taxis.' },
];

