  { category: 'Activities', budget: '$5–20', midrange: '$20–60', splurge: '$80+', notes: 'Self-guided → group tours → private guides' },
  { category: 'Entry Fees', budget: '$5–15', midrange: '$15–30', splurge: '$30–50', notes: 'Combined tickets save money' },
  { category: 'Daily Total', budget: '$75–190', midrange: '$165–370', splurge: '$430+', notes: 'Budget backpacker → comfortable mid → luxury' },
];

