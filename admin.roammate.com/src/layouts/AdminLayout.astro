---
import '../styles/admin.css';

interface Props {
  title: string;
  subtitle?: string;
  /** Open report count, shown as a badge so the queue is visible from anywhere. */
  reportsOpen?: number;
}

const { title, subtitle, reportsOpen } = Astro.props;
const operator = Astro.locals.operator;
const path = Astro.url.pathname;

/** Marks the tab active for its own page and its children (/users/:id). */
const current = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const NAV = [
  { href: '/', label: 'Overview' },
  { href: '/insights', label: 'Insights' },
  { href: '/activity', label: 'Activity log' },
  { href: '/users', label: 'Users' },
  { href: '/excursions', label: 'Excursions' },
  { href: '/media', label: 'Content' },
  { href: '/moderation', label: 'Moderation' },
  { href: '/flags', label: 'Feature flags' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · roammate admin</title>
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <a class="brand" href="/">
          <img src="/images/rm-full-hz.svg" alt="roammate" width="120" height="93" />
          <span class="brand-tag">admin</span>
        </a>
        <nav class="nav">
          {NAV.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
              <span>{item.label}</span>
              {item.href === '/moderation' && reportsOpen ? (
                <span class="count alert">{reportsOpen}</span>
              ) : null}
            </a>
          ))}
        </nav>
        <div class="side-foot">
          Signed in as<br />{operator}
          <br /><a href="/cdn-cgi/access/logout" style="color:inherit">Sign out</a>
        </div>
      </aside>

      <main class="main">
        <div class="head">
          <div>
            <h1>{title}</h1>
            {subtitle && <div class="sub">{subtitle}</div>}
          </div>
          <slot name="actions" />
        </div>
        <slot />
      </main>
    </div>
  </body>
</html>
