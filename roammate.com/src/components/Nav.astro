---
const base = import.meta.env.BASE_URL;
---

<nav class="nav" id="nav" aria-label="Main navigation">
  <a href={`${base}`} class="nav-logo-link">
    <img src={`${base}images/rm-full-hz.svg`} alt="roammate" class="nav-logo" width="155" height="120" fetchpriority="high" decoding="async">
  </a>
  <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
    <span></span><span></span><span></span>
  </button>
  <ul class="nav-links" id="navLinks">
    <li class="nav-close-li"><button class="nav-close" id="navClose" aria-label="Close menu">&times;</button></li>
    <li><a href={`${base}`}>Home</a></li>
    <li><a href={`${base}how-it-works/`}>How It Works</a></li>
    <li><a href={`${base}faq/`}>FAQ</a></li>
    <li><a href={`${base}guides/`}>Guides</a></li>
    <li><a href={`${base}blog/`}>Blog</a></li>
    <li><a href={`${base}about/`}>About</a></li>
  </ul>
</nav>

<script>
  // Nav scroll
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    if (window.pageYOffset > 80) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile toggle
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  const navEl = document.getElementById('nav');

  // Make sibling content inert while the overlay is open (focus containment + a11y).
  // inert is widely supported in modern browsers; older ones simply skip the attribute.
  function setSiblingsInert(inert: boolean) {
    if (!navEl || !navEl.parentElement) return;
    Array.from(navEl.parentElement.children).forEach((el) => {
      if (el === navEl) return;
      if (inert) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });
  }

  function openMenu() {
    toggle?.classList.add('active');
    links?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
    setSiblingsInert(true);
  }

  function closeMenu(restoreFocus = false) {
    toggle?.classList.remove('active');
    links?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    setSiblingsInert(false);
    if (restoreFocus) (toggle as HTMLElement | null)?.focus();
  }

  toggle?.addEventListener('click', () => {
    if (links?.classList.contains('open')) closeMenu();
    else openMenu();
  });

  const closeBtn = document.getElementById('navClose');
  closeBtn?.addEventListener('click', () => closeMenu(true));

  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => closeMenu());
  });

  // Escape closes the overlay and returns focus to the toggle button.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && links?.classList.contains('open')) {
      closeMenu(true);
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1280px;
    z-index: 1000;
    padding: 8px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(250, 248, 245, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: background 0.4s, padding 0.4s, box-shadow 0.4s;
  }

  .nav.scrolled {
    background: rgba(250, 248, 245, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 6px 40px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }

  .nav-logo-link {
    display: block;
    line-height: 0;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .nav-logo-link:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .nav-logo {
    height: 120px;
    width: auto;
    border: none;
    display: block;
    transition: height 0.4s var(--ease-out-expo);
  }

  .nav.scrolled .nav-logo {
    height: 90px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .nav-links a {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.3s;
    position: relative;
    padding: 14px 0;
    white-space: nowrap;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-terracotta);
    transition: width 0.4s var(--ease-out-expo);
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    padding: 8px;
    background: none;
    border: none;
  }

  .nav-toggle span {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--color-ink);
    transition: transform 0.3s, opacity 0.3s;
  }

  .nav-toggle.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .nav-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .nav-close-li { display: none; }

  @media (max-width: 1024px) {
    .nav { padding: 20px 24px; }
    .nav.scrolled { padding: 8px 24px; }
    .nav.scrolled .nav-logo { height: 48px; }
    .nav-toggle { display: flex; }

    .nav-close-li {
      display: block;
      position: absolute;
      top: 24px;
      left: 24px;
    }

    .nav-close {
      background: none;
      border: none;
      font-size: 40px;
      line-height: 1;
      color: var(--color-ink);
      cursor: pointer;
      padding: 8px;
    }

    .nav-links {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      background: rgba(250, 248, 245, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      flex-direction: column;
      justify-content: center;
      gap: 32px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s, visibility 0.4s;
    }

    .nav-links.open {
      opacity: 1;
      visibility: visible;
    }

    .nav-links a {
      font-size: 18px;
      letter-spacing: 3px;
    }

    .nav-cta {
      margin-top: 24px;
    }
  }
</style>
