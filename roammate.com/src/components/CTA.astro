---
const base = import.meta.env.BASE_URL;
---

<section class="cta-section" id="waitlist">
  <div class="cta-bg">
    <img
      src={`${base}images/thumbnail-bottom.webp`}
      srcset={`${base}images/thumbnail-bottom-600w.webp 600w, ${base}images/thumbnail-bottom.webp 700w`}
      sizes="100vw"
      alt="Travelers gathered at a scenic overlook ready for their next adventure"
      loading="lazy"
      width="700"
      height="471"
    >
  </div>
  <div class="cta-inner reveal">
    <h2 class="cta-heading">Start <em>Exploring</em></h2>
    <p class="cta-body">roammate is coming soon. Join the waitlist and be the first to connect with fellow travelers worldwide.</p>
    <form class="cta-form" id="ctaWaitlistForm">
      <div class="cta-input-wrap">
        <input type="email" name="email" placeholder="Your email address" required class="cta-email" autocomplete="email">
        <button type="submit" class="cta-submit" data-ph-event="waitlist_signup" data-ph-label="CTA form">Join Waitlist</button>
      </div>
      <p class="cta-form-note">Free forever. No spam. Unsubscribe anytime.</p>
    </form>
    <p class="cta-success" id="ctaSuccess" style="display:none;">You're on the list! We'll let you know when roammate launches.</p>
  </div>
</section>

<script>
  const form = document.getElementById('ctaWaitlistForm');
  const success = document.getElementById('ctaSuccess');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email');
    if (!email) return;

    // Track in PostHog
    if (window.posthog && typeof window.posthog.capture === 'function') {
      window.posthog.capture('waitlist_signup', { email, source: 'cta' });
    }

    // Submit to API (gracefully handle if endpoint doesn't exist yet)
    try {
      await fetch('https://api.roammate.com/v1/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
    } catch (_) { /* API may not be deployed yet */ }

    form.style.display = 'none';
    if (success) success.style.display = '';
  });
</script>

<style>
  .cta-section {
    position: relative;
    padding: 160px 40px;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6);
  }

  .cta-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(15, 15, 15, 0.92) 0%,
      rgba(26, 21, 16, 0.88) 50%,
      rgba(15, 15, 15, 0.85) 100%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 900;
    line-height: 1.1;
    color: #f5f0e8;
    margin-bottom: 24px;
  }

  .cta-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .cta-body {
    font-size: 17px;
    line-height: 1.8;
    color: rgba(245, 240, 232, 0.75);
    font-weight: 300;
    margin-bottom: 40px;
  }

  .cta-form {
    max-width: 460px;
    margin: 0 auto;
  }

  .cta-input-wrap {
    display: flex;
    gap: 0;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: border-color 0.3s;
  }

  .cta-input-wrap:focus-within {
    border-color: var(--color-terracotta-light);
  }

  .cta-email {
    flex: 1;
    padding: 16px 24px;
    background: transparent;
    border: none;
    color: #f5f0e8;
    font-size: 15px;
    font-family: var(--font-body);
    outline: none;
  }

  .cta-email::placeholder {
    color: rgba(245, 240, 232, 0.4);
  }

  .cta-submit {
    padding: 16px 28px;
    background: var(--color-terracotta);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    white-space: nowrap;
    transition: background 0.3s;
  }

  .cta-submit:hover {
    background: var(--color-terracotta-light);
  }

  .cta-form-note {
    margin-top: 12px;
    font-size: 12px;
    color: rgba(245, 240, 232, 0.35);
    font-weight: 300;
  }

  .cta-success {
    font-size: 17px;
    color: var(--color-terracotta-light);
    font-weight: 500;
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .cta-section { padding: 120px 24px; }
  }

  @media (max-width: 640px) {
    .cta-input-wrap {
      flex-direction: column;
      border-radius: 12px;
    }
    .cta-submit {
      border-radius: 0;
      padding: 14px 24px;
    }
  }
</style>
