---
import AppCTA from '../components/AppCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Meet Travelers Worldwide — roammate App"
  description="Meet fellow travelers who match your style, budget, and destination. roammate connects solo travelers and backpackers for shared adventures. Free on iOS and Android."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": "Meet Travelers Worldwide",
          "url": "https://roammate.com/meet-travelers/",
          "description": "Meet fellow travelers who match your style, budget, and destination. roammate connects solo travelers and backpackers for shared adventures.",
          "speakable": {
            "@type": "SpeakableSpecification",
            "cssSelector": [".mt-title", ".mt-subtitle", ".faq-section"]
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
            { "@type": "ListItem", "position": 2, "name": "Meet Travelers", "item": "https://roammate.com/meet-travelers/" }
          ]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How does roammate connect me with other travelers?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "roammate surfaces travelers heading to the same destination as you, then ranks them by how well their travel style, budget, and dates overlap with yours. Instead of scrolling a feed of strangers, you see a shortlist of people you're genuinely likely to click with, and you message them in-app to start the conversation."
              }
            },
            {
              "@type": "Question",
              "name": "Can I meet up with a group of travelers rather than just one person?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Many roammate users coordinate small group meetups — a shared day trip, a group hike, or a dinner — by connecting with several compatible travelers in the same city. It's a natural way to expand a solo trip into a small crew without committing to a fixed group tour."
              }
            },
            {
              "@type": "Question",
              "name": "How soon before a trip should I start connecting with travelers?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can connect both before you leave and once you've arrived. Reaching out a week or two ahead lets you line up plans for your first days, while connecting on the ground is great for spontaneous meetups. roammate works for both — set your dates and destination and it shows who overlaps with you."
              }
            },
            {
              "@type": "Question",
              "name": "What's the best way to break the ice with a traveler I've matched with?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Open with something specific from their profile — a destination you both have, a trail you want to do, or a shared travel style. Suggest a low-commitment first meetup like a coffee or a walking tour, and keep the chat in-app until you've met. Compatible matches make these conversations far easier than a cold hostel introduction."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <section class="mt-hero">
    <div class="mt-hero-inner">
      <div class="section-label section-label--center">Meet Fellow Travelers</div>
      <h1 class="mt-title">Meet travelers who <em>actually get you</em></h1>
      <p class="mt-subtitle">Not random strangers in a hostel lobby — travelers matched by style, budget, and destination. Real compatibility before you even say hello.</p>
      <div class="mt-hero-actions">
        <AppCTA
          variant="badges"
          appStoreCt="meet-travelers-hero"
          appStoreEvent="mt_hero_appstore_click"
          playStoreEvent="mt_hero_playstore_click"
        />
        <a href="/how-it-works/" class="mt-btn mt-btn--ghost">See how it works</a>
      </div>
    </div>
  </section>

  <section class="mt-why">
    <div class="mt-why-inner">
      <div class="section-label">Why It Matters</div>
      <h2 class="mt-section-heading">Solo travel is great.<br><em>Shared moments are better.</em></h2>
      <div class="mt-cards">
        <div class="mt-card reveal">
          <div class="mt-card-icon">🤝</div>
          <h3>Meet your people</h3>
          <p>Find travelers who match your pace — whether you're a sunrise hiker or a late-night foodie. No awkward small talk with incompatible strangers.</p>
        </div>
        <div class="mt-card reveal">
          <div class="mt-card-icon">🌍</div>
          <h3>Global community</h3>
          <p>Travelers from 50+ countries, all verified. Meet someone heading to the same city, the same trail, or the same festival.</p>
        </div>
        <div class="mt-card reveal">
          <div class="mt-card-icon">💬</div>
          <h3>Chat before you meet</h3>
          <p>Message first, meet when ready. Share plans, swap tips, or just see if you click before committing to anything.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-how">
    <div class="mt-how-inner">
      <div class="section-label">How It Works</div>
      <h2 class="mt-section-heading">From solo to <em>connected</em> in minutes</h2>
      <div class="mt-steps">
        <div class="mt-step reveal">
          <span class="mt-step-num">01</span>
          <h3>Set your travel profile</h3>
          <p>Tell us how you travel — adventure or culture, budget or midrange, which countries. We use this to find your people.</p>
        </div>
        <div class="mt-step reveal">
          <span class="mt-step-num">02</span>
          <h3>Discover compatible travelers</h3>
          <p>Browse profiles of travelers heading your way. See their style, budget, and plans before reaching out.</p>
        </div>
        <div class="mt-step reveal">
          <span class="mt-step-num">03</span>
          <h3>Meet and explore together</h3>
          <p>Send a message, make a plan, and go. Split a taxi, share a tour, or just grab coffee — your call.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-compare">
    <div class="mt-compare-inner">
      <div class="section-label">How It Compares</div>
      <h2 class="mt-section-heading">roammate vs <em>the alternatives</em></h2>
      <div class="mt-compare-table-wrap">
        <table class="mt-compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th class="mt-col-roammate">roammate</th>
              <th>Couchsurfing</th>
              <th>Meetup</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Purpose</td>
              <td class="mt-col-roammate">Meet compatible travelers</td>
              <td>Free accommodation with locals</td>
              <td>Local events and groups</td>
            </tr>
            <tr>
              <td>Matches by travel style</td>
              <td class="mt-col-roammate">✓</td>
              <td>✗</td>
              <td>✗</td>
            </tr>
            <tr>
              <td>Matches by budget</td>
              <td class="mt-col-roammate">✓</td>
              <td>✗</td>
              <td>✗</td>
            </tr>
            <tr>
              <td>Verified profiles</td>
              <td class="mt-col-roammate">✓</td>
              <td>Partial</td>
              <td>✗</td>
            </tr>
            <tr>
              <td>Free</td>
              <td class="mt-col-roammate">✓ Free</td>
              <td>Paid (~$15/yr)</td>
              <td>Free / Paid tiers</td>
            </tr>
            <tr>
              <td>Best for</td>
              <td class="mt-col-roammate">Meeting compatible travelers</td>
              <td>Budget accommodation</td>
              <td>Local social events</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="faq-section mt-faq">
    <div class="mt-faq-inner">
      <div class="section-label">Common Questions</div>
      <h2 class="mt-section-heading">Meeting fellow travelers — <em>FAQ</em></h2>
      <div class="faq-list">
        <details class="faq-item reveal">
          <summary class="faq-question"><h3>How does roammate connect me with other travelers?</h3></summary>
          <p class="faq-answer">roammate surfaces travelers heading to the same destination as you, then ranks them by how well their travel style, budget, and dates overlap with yours. Instead of scrolling a feed of strangers, you see a shortlist of people you're genuinely likely to click with, and you message them in-app to start the conversation.</p>
        </details>
        <details class="faq-item reveal">
          <summary class="faq-question"><h3>Can I meet up with a group of travelers rather than just one person?</h3></summary>
          <p class="faq-answer">Yes. Many roammate users coordinate small group meetups — a shared day trip, a group hike, or a dinner — by connecting with several compatible travelers in the same city. It's a natural way to expand a solo trip into a small crew without committing to a fixed group tour.</p>
        </details>
        <details class="faq-item reveal">
          <summary class="faq-question"><h3>How soon before a trip should I start connecting with travelers?</h3></summary>
          <p class="faq-answer">You can connect both before you leave and once you've arrived. Reaching out a week or two ahead lets you line up plans for your first days, while connecting on the ground is great for spontaneous meetups. roammate works for both — set your dates and destination and it shows who overlaps with you.</p>
        </details>
        <details class="faq-item reveal">
          <summary class="faq-question"><h3>What's the best way to break the ice with a traveler I've matched with?</h3></summary>
          <p class="faq-answer">Open with something specific from their profile — a destination you both have, a trail you want to do, or a shared travel style. Suggest a low-commitment first meetup like a coffee or a walking tour, and keep the chat in-app until you've met. Compatible matches make these conversations far easier than a cold hostel introduction.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="mt-cta">
    <div class="mt-cta-inner">
      <p class="mt-cta-label">Free on iOS &amp; Android</p>
      <h2 class="mt-cta-heading">Your next travel friend is <em>already on roammate</em></h2>
      <p class="mt-cta-body">Download free. Build your profile. Find someone who travels the way you do.</p>
      <AppCTA
  variant="badges"
  appStoreCt="meet-travelers-cta"
  appStoreEvent="mt_bottom_appstore_click"
  playStoreEvent="mt_bottom_playstore_click"
/>
      <p class="mt-cta-sub">Also: <a href="/blog/finding-travel-companions/">Read our guide to finding travel companions</a></p>
    </div>
  </section>

  <section class="mt-related">
    <div class="mt-related-inner">
      <div class="section-label">From The Blog</div>
      <h2 class="mt-section-heading">More on meeting <em>fellow travelers</em></h2>
      <div class="mt-related-links">
        <a href="/blog/finding-travel-companions/" class="mt-related-link">How to Find Reliable Travel Companions in New Cities →</a>
        <a href="/blog/meeting-people-solo-travel/" class="mt-related-link">Meeting People as a Solo Traveler →</a>
        <a href="/blog/travel-friendship-building/" class="mt-related-link">Building Lasting Travel Friendships →</a>
        <a href="/blog/hostel-social-scene-navigation/" class="mt-related-link">Navigating the Hostel Social Scene →</a>
        <a href="/blog/solo-travel-vs-group-tours/" class="mt-related-link">Solo Travel vs Group Tours →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mt-hero {
    padding: 160px 40px 100px;
    text-align: center;
    position: relative;
  }

  .mt-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(196, 86, 42, 0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .mt-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
  }

  .mt-title {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 900;
    line-height: 1.02;
    color: var(--color-ink);
    margin-bottom: 24px;
  }

  .mt-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .mt-subtitle {
    font-size: clamp(17px, 2vw, 21px);
    color: rgba(245, 241, 235, 0.75);
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .mt-hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .mt-btn {
    display: inline-block;
    padding: 15px 32px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.3s, transform 0.3s var(--ease-out-expo);
    letter-spacing: 0.3px;
  }

  .mt-btn--primary {
    background: var(--color-terracotta);
    color: #fff;
  }

  .mt-btn--primary:hover {
    background: #b34f28;
    transform: translateY(-2px);
  }

  .mt-btn--ghost {
    background: transparent;
    border: 1px solid rgba(245, 241, 235, 0.25);
    color: rgba(245, 241, 235, 0.8);
  }

  .mt-btn--ghost:hover {
    border-color: rgba(245, 241, 235, 0.5);
    color: #fff;
  }

  .mt-btn--large {
    padding: 18px 40px;
    font-size: 16px;
  }

  .mt-section-heading {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: 48px;
  }

  .mt-section-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .mt-why {
    padding: 80px 40px;
  }

  .mt-why-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .mt-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .mt-card {
    padding: 36px 28px;
    background: rgba(247, 242, 234, 0.04);
    border: 1px solid rgba(196, 86, 42, 0.15);
    border-radius: 20px;
  }

  .mt-card-icon {
    font-size: 32px;
    margin-bottom: 16px;
  }

  .mt-card h3 {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--color-ink);
    margin-bottom: 10px;
    line-height: 1.2;
  }

  .mt-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .mt-how {
    padding: 80px 40px;
    background: rgba(247, 242, 234, 0.02);
    border-top: 1px solid rgba(196, 86, 42, 0.08);
    border-bottom: 1px solid rgba(196, 86, 42, 0.08);
  }

  .mt-how-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .mt-steps {
    display: grid;
    gap: 32px;
  }

  .mt-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    align-items: start;
  }

  .mt-step-num {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 900;
    color: var(--color-terracotta);
    opacity: 0.4;
    line-height: 1;
  }

  .mt-step h3 {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .mt-step p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .mt-compare {
    padding: 80px 40px;
    border-top: 1px solid rgba(196, 86, 42, 0.08);
  }

  .mt-compare-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .mt-compare-table-wrap {
    overflow-x: auto;
  }

  .mt-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .mt-compare-table th,
  .mt-compare-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid rgba(196, 86, 42, 0.1);
    color: var(--color-text-muted);
    vertical-align: top;
  }

  .mt-compare-table th {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-ink);
    padding-bottom: 16px;
  }

  .mt-compare-table tbody tr:last-child td {
    border-bottom: none;
  }

  .mt-col-roammate {
    background: rgba(196, 86, 42, 0.07);
    color: var(--color-ink) !important;
    font-weight: 600;
  }

  .mt-compare-table th.mt-col-roammate {
    color: var(--color-terracotta-light) !important;
  }

  .mt-cta {
    padding: 80px 40px;
  }

  .mt-cta-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .mt-cta-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: 18px;
  }

  .mt-cta-heading {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  .mt-cta-heading em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta-light);
  }

  .mt-cta-body {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(245, 241, 235, 0.65);
    margin-bottom: 32px;
  }

  .mt-cta-sub {
    margin-top: 20px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .mt-cta-sub a {
    color: var(--color-terracotta-light);
  }

  .mt-related {
    padding: 60px 40px 100px;
    border-top: 1px solid rgba(196, 86, 42, 0.08);
  }

  .mt-related-inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .mt-related-links {
    display: grid;
    gap: 12px;
  }

  .mt-related-link {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    padding: 16px 20px;
    border: 1px solid rgba(196, 86, 42, 0.15);
    border-radius: 12px;
    transition: border-color 0.25s, color 0.25s;
  }

  .mt-related-link:hover {
    border-color: var(--color-terracotta);
    color: var(--color-terracotta-light);
  }

  .mt-faq {
    padding: 60px 40px 80px;
    border-top: 1px solid rgba(196, 86, 42, 0.08);
  }

  .mt-faq-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-list {
    display: grid;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid rgba(196, 86, 42, 0.1);
  }

  .faq-question {
    font-family: var(--font-display);
    cursor: pointer;
    padding: 24px 40px 24px 0;
    list-style: none;
    position: relative;
    transition: color 0.3s;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question h3 {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.3;
  }

  .faq-question::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 300;
    color: var(--color-terracotta);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .faq-item[open] .faq-question::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .faq-question:hover h3 { color: var(--color-terracotta); }

  .faq-answer {
    font-size: 15px;
    line-height: 1.9;
    color: var(--color-ink-muted, rgba(245, 241, 235, 0.65));
    font-weight: 300;
    padding: 0 40px 24px 0;
  }

  @media (max-width: 1024px) {
    .mt-hero { padding: 140px 24px 80px; }
    .mt-why, .mt-how, .mt-cta, .mt-related, .mt-compare, .mt-faq { padding-left: 24px; padding-right: 24px; }
    .mt-cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .mt-hero { padding: 120px 20px 60px; }
    .mt-why, .mt-how, .mt-cta, .mt-related, .mt-faq { padding-left: 20px; padding-right: 20px; }
    .mt-compare { padding-left: 20px; padding-right: 20px; }
    .mt-step { grid-template-columns: 44px 1fr; gap: 16px; }
    .mt-step-num { font-size: 36px; }
    .mt-hero-actions { flex-direction: column; align-items: center; }
  }
</style>
