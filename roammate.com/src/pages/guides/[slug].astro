---
import { getCollection } from 'astro:content';
import CityGuideLayout from '../../layouts/CityGuideLayout.astro';
import BackpackerRouteLayout from '../../layouts/BackpackerRouteLayout.astro';
import { collidesWithItinerary, getTitleTestCities, deCannibalisedTitle } from '../../lib/titleTestSet';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  // flatMap, not filter: filter does not narrow the guide union, so g.data.itineraries
  // would not typecheck on the backpacker variant.
  const cities = guides.flatMap((g) => (g.data.type === 'city' ? [g.data] : []));
  const colliding = cities
    .filter((d) => collidesWithItinerary(d.title, d.itineraries))
    .map((d) => d.slug)
    .sort();
  const titleTest = getTitleTestCities(
    colliding,
    cities.map((d) => d.slug).sort()
  );
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: {
      guide: guide.data,
      inTitleTest: guide.data.type === 'city' && titleTest.has(guide.data.slug),
    },
  }));
}

const { guide, inTitleTest } = Astro.props;
// bead 849: treated guides drop the duration from the title and gain a descriptive H1.
const cityTitle = inTitleTest ? deCannibalisedTitle(guide.title) : guide.title;
---

{guide.type === 'city' ? (
  <CityGuideLayout
    title={cityTitle}
    h1Qualifier={inTitleTest ? 'Travel Guide' : undefined}
    description={guide.description}
    heroImage={guide.heroImage}
    heroFlag={guide.heroFlag}
    heroCountry={guide.heroCountry}
    heroRegion={guide.heroRegion}
    heroCity={guide.heroCity}
    heroSubtitle={guide.heroSubtitle}
    heroPills={guide.heroPills}
    quickFacts={guide.quickFacts}
    itineraries={guide.itineraries}
    defaultDays={guide.defaultDays}
    budgetIntro={guide.budgetIntro}
    budgetTips={guide.budgetTips}
    budgetBreakdown={guide.budgetBreakdown}
    practicalInfo={guide.practicalInfo}
    culturalIntro={guide.culturalIntro}
    culturalTips={guide.culturalTips}
    ctaCity={guide.ctaCity}
    ctaText={guide.ctaText}
    ctaCustomise={guide.ctaCustomise}
  />
) : (
  <BackpackerRouteLayout
    title={guide.title}
    description={guide.description}
    heroImages={guide.heroImages}
    heroFlags={guide.heroFlags}
    heroRegion={guide.heroRegion}
    heroTitle={guide.heroTitle}
    heroSubtitle={guide.heroSubtitle}
    heroPills={guide.heroPills}
    routeOverview={guide.routeOverview}
    countries={guide.countries}
    budgetIntro={guide.budgetIntro}
    budgetColumns={guide.budgetColumns}
    budgetRows={guide.budgetRows}
    practicalInfo={guide.practicalInfo}
    ctaRegion={guide.ctaRegion}
    ctaText={guide.ctaText}
    ctaCustomise={guide.ctaCustomise}
    featuredGuides={guide.featuredGuides}
    accentColor={guide.accentColor}
  />
)}
