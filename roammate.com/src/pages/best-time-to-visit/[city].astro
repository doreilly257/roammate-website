---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCTA from '../../components/AppCTA.astro';
import { getCitySiblingPages } from '../../lib/getCitySiblingPages';
import { getCityGuideSlugs } from '../../data/guides';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const cityGuideSlugs = await getCityGuideSlugs();
  return guides
    .filter((g): g is CollectionEntry<'guides'> & { data: Extract<CollectionEntry<'guides'>['data'], { type: 'city' }> } => g.data.type === 'city')
    .map((g) => {
      const d = g.data;
      const bestMonths = d.quickFacts.find((f) => f.label === 'Best Months');
      const dailyBudget = d.quickFacts.find((f) => f.label === 'Daily Budget');
      return {
        params: { city: d.slug },
        props: {
          city: d.heroCity,
          country: d.heroCountry,
          slug: d.slug,
          heroImage: d.heroImage,
          bestMonths: bestMonths?.value ?? '',
          bestMonthsDetail: bestMonths?.detail ?? '',
          dailyBudget: dailyBudget?.value ?? '',
          quickFacts: d.quickFacts,
          heroSubtitle: d.heroSubtitle,
          practicalInfo: d.practicalInfo,
          siblings: getCitySiblingPages(d.slug, d, cityGuideSlugs),
        },
      };
    });
}

const { city, country, slug, heroImage, bestMonths, bestMonthsDetail, quickFacts, heroSubtitle, practicalInfo, siblings } = Astro.props;
const bestMonthsDetailClean = bestMonthsDetail.replace(/\.+$/, '');
const pageTitle = `Best Time to Visit ${city}, ${country} | roammate`;
const pageDesc = `The best time to visit ${city} is ${bestMonths}. ${bestMonthsDetailClean}. Plan your trip with weather info, seasonal tips, and travel advice.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://roammate.com/" },
    { "@type": "ListItem", "position": 2, "name": `${city} Guide`, "item": `https://roammate.com/guides/${slug}/` },
    { "@type": "ListItem", "position": 3, "name": `Best Time to Visit ${city}`, "item": `https://roammate.com/best-time-to-visit/${slug}/` }
  ]
};

const timezone = quickFacts.find((f) => f.label === 'Timezone');
// Previously this page showed only Best Months + Timezone, which left every
// city with near-identical copy. All six quick facts are per-city and all of
// them matter when you are picking dates, so show them.
const seasonFacts = quickFacts;
// A real per-city note, preferred in the order that most affects WHEN you go.
const planningNote = ['Getting Around', 'Weather', 'What to Pack', 'Visa & Entry', 'Health & Safety']
  .map((t) => practicalInfo?.find((p) => p.title === t))
  .find(Boolean) ?? practicalInfo?.[0];
---

<BaseLayout title={pageTitle} description={pageDesc} ogImage={heroImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="pv-hero">
    <div class="pv-hero-inner">
      <nav class="pv-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href={`/guides/${slug}/`}>{city}</a>
        <span>/</span>
        <span>Best Time to Visit</span>
      </nav>
      <h1 class="pv-hero-title">Best time to visit {city}</h1>
      <p class="pv-hero-sub">{country}</p>
    </div>
  </section>

  <article class="pv-content">
    <div class="pv-content-inner">

      <p class="pv-intro">The best months to visit {city} are <strong>{bestMonths}</strong>. {bestMonthsDetailClean}.</p>

      <h2>Quick facts</h2>
      <div class="pv-facts-grid">
        {seasonFacts.map((fact) => (
          <div class="pv-fact-card">
            <span class="pv-fact-icon">{fact.icon}</span>
            <span class="pv-fact-label">{fact.label}</span>
            <span class="pv-fact-value">{fact.value}</span>
            <span class="pv-fact-detail">{fact.detail}</span>
          </div>
        ))}
      </div>

      <h2>When to go</h2>
      {heroSubtitle && <p>{heroSubtitle}</p>}
      <p>{bestMonths} is the busiest window in {city}, so accommodation and flights go first — book ahead. The shoulder weeks either side are usually quieter for the same reason.</p>
      {planningNote && (
        <div class="pv-note">
          <h3><span aria-hidden="true">{planningNote.icon}</span> {planningNote.title} in {city}</h3>
          <ul>
            {planningNote.items.slice(0, 4).map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
      <p>For month-by-month detail, itineraries and costs, see the full <a href={`/guides/${slug}/`}>{city} travel guide</a>.</p>
      {timezone && <p><strong>Timezone:</strong> {timezone.value} ({timezone.detail})</p>}

      <h2>Frequently asked questions</h2>
      <div class="pv-faq">
        <details class="pv-faq-item" open>
          <summary><h3>When is the best time to visit {city}?</h3></summary>
          <p>
            The best months to visit {city} are {bestMonths} — {bestMonthsDetailClean}, which makes for the most comfortable conditions for sightseeing and getting around.
            {siblings.budget && (
              <> For what a trip costs day to day, see the <a href={siblings.budget}>{city} budget breakdown</a>.</>
            )}
          </p>
        </details>
      </div>

    </div>
  </article>

  <section class="city-more">
    <div class="city-more-inner">
      <h3>More about {city}</h3>
      <ul class="city-more-links">
        {siblings.guide && (
          <li><a href={siblings.guide}>{city} Travel Guide</a></li>
        )}
        {siblings.itinerary.map((it: any) => (
          <li><a href={it.slug}>{city} {it.days}-Day Itinerary</a></li>
        ))}
        {siblings.budget && (
          <li><a href={siblings.budget}>{city} Budget Breakdown</a></li>
        )}
        {siblings.companions && (
          <li><a href={siblings.companions}>Travel Companions in {city}</a></li>
        )}
      </ul>
    </div>
  </section>

  <section class="pv-cta reveal">
    <div class="pv-cta-inner">
      <h2>Find a travel companion for {city}</h2>
      <p>roammate matches you with travelers heading to {city} at the same time. Free on iOS.</p>
      <div class="pv-cta-app">
        <AppCTA appStoreCt="best-time-cta" appStoreEvent="best_time_appstore_click" playStoreEvent="best_time_playstore_click" />
      </div>
      <a href={`/guides/${slug}/`} class="pv-cta-btn">See the full {city} guide</a>
    </div>
  </section>
</BaseLayout>

<style>
  .pv-hero {
    background: linear-gradient(135deg, #1a1714 0%, #2a2420 100%);
    padding: 120px 24px 64px;
    text-align: center;
  }
  .pv-hero-inner { max-width: 760px; margin: 0 auto; }
  .pv-breadcrumb {
    font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase;
    color: rgba(245, 240, 232, 0.35); margin-bottom: 40px;
  }
  .pv-breadcrumb a { color: rgba(245, 240, 232, 0.55); transition: color 0.3s; text-decoration: none; }
  .pv-breadcrumb a:hover { color: var(--color-terracotta-light); }
  .pv-breadcrumb span { margin: 0 10px; }
  .pv-hero-title {
    font-family: var(--font-display); font-size: clamp(32px, 5vw, 56px);
    font-weight: 900; line-height: 1.15; color: #f5f0e8;
  }
  .pv-hero-sub {
    font-family: var(--font-body); font-size: 18px; color: rgba(245, 240, 232, 0.55);
    margin-top: 12px; letter-spacing: 1px;
  }
  .pv-content { padding: 56px 24px 64px; }
  .pv-content-inner { max-width: 720px; margin: 0 auto; }
  .pv-intro {
    font-family: var(--font-body); font-size: 19px; line-height: 1.75;
    color: var(--color-text); margin-bottom: 24px; padding: 28px 32px;
    background: var(--color-bg-warm); border-left: 4px solid var(--color-terracotta);
    border-radius: 0 12px 12px 0;
  }
  .pv-content-inner p {
    font-family: var(--font-body); font-size: 17px; line-height: 1.75;
    color: var(--color-text); margin-bottom: 20px;
  }
  .pv-content-inner h2 {
    font-family: var(--font-display); font-size: clamp(22px, 3vw, 30px);
    font-weight: 800; color: var(--color-text); margin: 48px 0 16px;
  }
  .pv-content-inner ul { margin: 0 0 24px; padding-left: 20px; }
  .pv-content-inner li {
    font-family: var(--font-body); font-size: 16px; line-height: 1.7;
    color: var(--color-text); margin-bottom: 10px;
  }
  .pv-content-inner a {
    color: var(--color-terracotta); text-decoration: underline;
    text-underline-offset: 2px; transition: color 0.2s;
  }
  .pv-content-inner a:hover { color: var(--color-terracotta-light); }
  .pv-facts-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px; margin: 24px 0 32px;
  }
  .pv-fact-card {
    display: flex; flex-direction: column; padding: 20px;
    background: var(--color-bg-warm); border-radius: 12px;
  }
  .pv-fact-icon { font-size: 24px; margin-bottom: 8px; }
  .pv-fact-label {
    font-family: var(--font-body); font-size: 11px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 4px;
  }
  .pv-fact-value {
    font-family: var(--font-display); font-size: 18px; font-weight: 700;
    color: var(--color-text);
  }
  .pv-fact-detail {
    font-family: var(--font-body); font-size: 13px;
    color: var(--color-text-muted); margin-top: 4px;
  }
  .pv-faq { margin-top: 24px; }
  .pv-faq-item { border-bottom: 1px solid rgba(58, 52, 46, 0.1); padding: 16px 0; }
  .pv-faq-item summary {
    cursor: pointer; list-style: none; display: flex; align-items: center; gap: 12px;
  }
  .pv-faq-item summary::-webkit-details-marker { display: none; }
  .pv-faq-item summary::before {
    content: '+'; font-family: var(--font-body); font-size: 20px; font-weight: 600;
    color: var(--color-terracotta); flex-shrink: 0; width: 24px; text-align: center;
    transition: transform 0.2s;
  }
  .pv-faq-item[open] summary::before { content: '\2212'; }
  .pv-faq-item summary h3 {
    font-family: var(--font-display); font-size: 17px; font-weight: 700;
    color: var(--color-text); margin: 0;
  }
  .pv-faq-item p {
    padding-left: 36px; font-size: 15px !important; color: var(--color-text-muted) !important;
  }
  .pv-cta { padding: 80px 24px; text-align: center; background: var(--color-bg-warm); }
  .pv-cta-inner { max-width: 560px; margin: 0 auto; }
  .pv-cta h2 {
    font-family: var(--font-display); font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800; color: var(--color-text); margin-bottom: 12px;
  }
  .pv-cta p {
    font-family: var(--font-body); font-size: 16px; color: var(--color-text-muted);
    margin-bottom: 28px; line-height: 1.6;
  }
  .pv-cta-btn {
    display: inline-block; padding: 16px 36px; background: var(--color-terracotta);
    color: #fff; font-family: var(--font-body); font-size: 16px; font-weight: 600;
    border-radius: 50px; text-decoration: none; transition: background 0.3s, transform 0.2s;
  }
  .pv-cta-btn:hover { background: var(--color-terracotta-light); transform: translateY(-1px); }
  .pv-cta-app { margin-bottom: 20px; }
  .city-more {
    padding: 48px 24px;
    background: var(--color-bg-warm);
  }
  .city-more-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .city-more h3 {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 20px;
  }
  .city-more-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .city-more-links li a {
    display: inline-block;
    padding: 8px 18px;
    background: var(--color-bg);
    border: 1px solid rgba(58, 52, 46, 0.12);
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .city-more-links li a:hover {
    background: var(--color-terracotta);
    color: #fff;
    border-color: var(--color-terracotta);
  }
  @media (max-width: 600px) {
    .pv-hero { padding: 100px 20px 48px; }
    .pv-intro { padding: 20px; font-size: 17px; }
    .pv-content { padding: 40px 20px 48px; }
    .pv-facts-grid { grid-template-columns: repeat(2, 1fr); }
    .city-more { padding: 36px 20px; }
  }

  .pv-note { margin: 28px 0; padding: 20px 22px; border: 1px solid var(--color-border); border-radius: 12px; }
  .pv-note h3 { margin: 0 0 10px; font-size: 17px; }
  .pv-note ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .pv-note li { color: var(--color-ink-muted); }
</style>
