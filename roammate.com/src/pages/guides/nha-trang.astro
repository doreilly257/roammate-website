const culturalTips = [
  { icon: '🏛️', title: 'Temple Etiquette', text: 'Remove shoes before entering temples and pagodas. Cover shoulders and knees. Do not touch Buddha statues. At Po Nagar, free robes are provided if needed.' },
  { icon: '🍜', title: 'Dining Customs', text: 'Vietnamese meals are communal — dishes go in the centre and everyone shares. Wait for the eldest to start eating. Saying "xin moi" (please eat) before starting shows respect.' },
  { icon: '🤝', title: 'Bargaining', text: 'Bargaining is expected at markets and street vendors — start at 40–50% of asking price. Never haggle aggressively or for food prices. Smile throughout and walk away if the price doesn\'t drop.' },
  { icon: '👢', title: 'Shoes Off', text: 'Remove shoes when entering homes, temples, and some shops. Look for shoes piled at the door as your cue. Carry easy-on/off sandals or flip-flops for convenience.' },
